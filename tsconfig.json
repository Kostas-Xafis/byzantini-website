{
	"extends": "astro/tsconfigs/strict",
	"exclude": ["./.astro", "./.vscode", "./.wrangler", "./dist", "./node_modules", "./tests", "./services", "./email"],
	"include": [".astro/types.d.ts", "lib", "src", "types", "scripts", "e2e"],
	"compilerOptions": {
		"noErrorTruncation": true,
		"strict": true,
		"allowUnusedLabels": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"alwaysStrict": true,
		"allowImportingTsExtensions": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["@types/bun"],
		"paths": {
			"@bucket/*": ["./lib/bucket/*"],
			"@env/*": ["./lib/env/*"],
			"@hooks/*": ["./lib/hooks/*"],
			"@routes/*": ["./lib/routes/*"],
			"@utilities/*": ["./lib/utilities/*"],
			"@lib/*": ["./lib/*"],
			"@_types/*": ["./types/*"],
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@pages/*": ["./src/pages/*"],
		},
	},
}
