{
	// Cloudflare Workers configuration for Byzantini-Website (Astro + @astrojs/cloudflare)
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "byzantini-website",
	// The adapter generates the worker entrypoint + assets config at build time
	// (dist/server/entry.mjs + dist/client). No `main` here — v14 pattern.
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["nodejs_compat"],

	// Static assets served via Workers Static Assets (Astro SSR handles all routes;
	// unmatched paths fall through to the worker, which renders the 404 page).
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},

	// R2 bucket (production). Dev/preview use the local simulation or their own env.
	"r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket" }],

	// Cloudflare Images binding — replaces the retired dockerized image-compression
	// service (announcement thumbnails). NOT inherited by named environments, so it
	// is redeclared under `env` below. The @astrojs/cloudflare adapter would auto-add
	// this same binding, but declaring it here keeps it in the source of truth and in
	// `bun run types` output.
	"images": { "binding": "IMAGES" },

	// D1 database — local dev uses a local SQLite file; deploy with `wrangler d1 create`
	// (database_id is pinned in Phase 6 when the remote database is created).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "byzantini-db",
			"database_id": "20e4783b-f1b4-4362-ba76-7694c91cacce",
			"migrations_dir": "migrations"
		}
	],

	// Worker-to-worker service bindings — replace the old HTTP calls:
	// - EMAIL_SERVICE → byzantini-website-emails (transactional sends;
	//   still authenticated with the shared AUTOMATED_EMAILS_SERVICE_AUTH_TOKEN).
	// - PDF_SERVICE → byzantini-website-pdf-gen (registration-form PDFs;
	//   authenticated with Authorization: Bearer <PDF_SERVICE_AUTH_TOKEN>).
	// NOT inherited by named environments, so redeclared under `env` below.
	// Local dev: each binding resolves to the same worker running in its own
	// `wrangler dev` session (cross-command service bindings); when a target
	// worker is not running locally the call fails fast (same as today without
	// the local worker on 8787/8788).
	"services": [
		{ "binding": "EMAIL_SERVICE", "service": "byzantini-website-emails" },
		{ "binding": "PDF_SERVICE", "service": "byzantini-website-pdf-gen" }
	],

	"observability": {
		"enabled": true
	},

	"env": {
		"production": {
			"d1_databases": [
				{ "binding": "DB", "database_name": "byzantini-db", "database_id": "20e4783b-f1b4-4362-ba76-7694c91cacce", "migrations_dir": "migrations" }
			],
			"r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket" }],
			"images": { "binding": "IMAGES" },
			"services": [
				{ "binding": "EMAIL_SERVICE", "service": "byzantini-website-emails" },
				{ "binding": "PDF_SERVICE", "service": "byzantini-website-pdf-gen" }
			]
		},
		"preview": {
			"d1_databases": [
				{ "binding": "DB", "database_name": "byzantini-db-preview", "database_id": "7f9a62e7-e72c-4f3b-8e81-4f81ffa86c5d", "migrations_dir": "migrations" }
			],
			"r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket-dev" }],
			"images": { "binding": "IMAGES" },
			"services": [
				{ "binding": "EMAIL_SERVICE", "service": "byzantini-website-emails" },
				{ "binding": "PDF_SERVICE", "service": "byzantini-website-pdf-gen" }
			]
		}
	}
}
