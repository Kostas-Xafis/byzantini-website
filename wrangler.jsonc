{
	// Cloudflare Workers configuration for Byzantini-Website (Astro + @astrojs/cloudflare)
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "byzantini-website",
	// The adapter generates the worker entrypoint + assets config at build time
	// (dist/server/entry.mjs + dist/client). No `main` here — v14 pattern.
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["nodejs_compat"],

	// Static assets served via Workers Static Assets (Astro SSR handles all routes;
	// unmatched paths fall through to the worker, which renders the 404 page).
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},

	// R2 bucket (production). Dev/preview use the local simulation or their own env.
	"r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket" }],

	// D1 database — local dev uses a local SQLite file; deploy with `wrangler d1 create`
	// (database_id is pinned in Phase 6 when the remote database is created).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "byzantini-db",
			"migrations_dir": "migrations"
		}
	],

	"observability": {
		"enabled": true
	},

	"env": {
		"production": {
			// Production vars go here (non-secret only; secrets: `wrangler secret put`).
			// Pin resources below once they exist (see docs/PHASE6_DEPLOY.md):
			//   "d1_databases": [{ "binding": "DB", "database_name": "byzantini-db", "database_id": "<id>" }],
			//   "r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket", "bucket_id": "<id>" }]
		},
		"preview": {
			// Preview environment: own D1 + R2 resources (create in Phase 6).
			//   "d1_databases": [{ "binding": "DB", "database_name": "byzantini-db-preview", "database_id": "<id>" }],
			//   "r2_buckets": [{ "binding": "S3_BUCKET", "bucket_name": "byzantini-bucket-dev", "bucket_id": "<id>" }]
		}
	}
}
