---
import Navbar from "@components/Navbar.astro";
import Links from "@components/headers/Links.astro";
export interface Props {
	title: string;
	imageUrl?: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
}

const { title, imageUrl, description, canonical, noindex } = Astro.props;

const logoUrl = imageUrl ? new URL(imageUrl, Astro.site ?? Astro.request.url).href : undefined;
---

<!doctype html>
<html lang="el">
	<head>
		<Links title={title} imageURL={logoUrl} description={description} canonical={canonical} noindex={noindex} />
		<style is:inline>
			/*
			 * These are the v3 "unlayered" element defaults. Tailwind 4 puts its
			 * utilities in `@layer utilities`, and unlayered author CSS always wins
			 * over any layer — so without the @layer base wrapper, `p { color:
			 * #282828 }` overrides every `text-*` utility (text is black site-wide).
			 * The order statement pins `base` below `utilities` even though this
			 * style tag is emitted before the Tailwind stylesheet.
			 */
			@layer properties, theme, base, components, utilities;
			@layer base {
				html {
					font-family: system-ui, sans-serif;
					height: 100dvh;
				}
				* {
					scroll-behavior: smooth;
					scroll-padding: var(--scroll-pad);
				}
				p,
				a,
				button,
				h1,
				h2,
				h3,
				li,
				input[name*="date"]::placeholder {
					color: #282828;
				}
				select {
					background-color: white !important;
				}
				input[type="number"] {
					-moz-appearance: textfield;
					appearance: textfield;
				}
				input::-webkit-outer-spin-button,
				input::-webkit-inner-spin-button {
					display: none;
				}
				.heading::after {
					content: "";
					position: absolute;
					bottom: 0;
					height: 4px;
					transform: translateX(-120%);
					transition: transform 0.5s ease-in-out;
					border-radius: 3px;
				}
				.heading:is(.emphasis)::after {
					transform: translateX(0px);
				}
				.glass {
					background: rgb(127 29 29 / 0.45);
					backdrop-filter: blur(4px);
					border: 1px solid rgb(153 27 27 / 0.3);
				}

				.fadeIn {
					animation: fadeIn var(--fade-duration) ease-in-out;
				}
				.fadeOut {
					animation: fadeOut var(--fade-duration) ease-in-out;
				}
				.fadeInParent {
					animation: fadeInParent var(--fade-duration) ease-in-out;
				}
				.fadeInLeft {
					animation: fadeInLeft var(--fade-duration) ease-in-out;
				}
				.fadeInRight {
					animation: fadeInRight var(--fade-duration) ease-in-out;
				}

				@keyframes fadeIn {
					0% {
						opacity: 0.0001;
					}
					100% {
						opacity: 1;
					}
				}
				@keyframes fadeOut {
					0% {
						opacity: 1;
					}
					100% {
						opacity: 0.0001;
					}
				}
				@keyframes fadeInParent {
					0% {
						transform: translateY(25px);
					}
					100% {
						transform: translateY(0px);
					}
				}
				@keyframes fadeInLeft {
					0% {
						opacity: 0.0001;
						transform: translateX(-2rem);
					}
					80% {
						opacity: 1;
					}
					100% {
						opacity: 1;
						transform: translateX(0px);
					}
				}
				@keyframes fadeInRight {
					0% {
						opacity: 0.0001;
						transform: translateX(2rem);
					}
					80% {
						opacity: 1;
					}
					100% {
						opacity: 1;
						transform: translateX(0px);
					}
				}
			}
		</style>
		<style is:inline>
			.spinner {
				background:
					radial-gradient(farthest-side, rgb(127, 29, 29) 94%, #0000) top/8px 8px no-repeat,
					conic-gradient(#0000 30%, rgb(127, 29, 29));
				-webkit-mask: radial-gradient(farthest-side, #0000 calc(100% - 8px), #000 0);
				animation: spin 1s infinite linear;
			}
			@keyframes spin {
				100% {
					transform: rotate(1turn);
				}
			}
		</style>
	</head>
	<body class="box-border relative h-[100dvh] p-0 grid bg-white grid-rows-1 max-sm:overflow-auto">
		<Navbar />
		<div class="relative w-full h-[100dvh] supports-[height:1svh]:h-[100svh] grid grid-rows-[100%] pt-[4vw] max-sm:pt-[6rem] max-3xs:pt-[5rem]">
			<slot />
		</div>
	</body>
</html>
