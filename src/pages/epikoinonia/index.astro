<style is:inline>
	/* FAQ: smooth expand/collapse. The answer height animates via grid-template-rows
	   (0fr → 1fr), the item box follows with color/shadow transitions and the
	   chevron rotates — all in both directions. */
	#epikoinonia .faq-item {
		border: 2px solid rgb(127 29 29 / 0.6);
		border-radius: 0.75rem;
		background-color: rgb(127 29 29 / 0.04);
		transition:
			border-color 0.3s ease,
			background-color 0.3s ease,
			box-shadow 0.35s ease;
	}
	#epikoinonia .faq-item.is-open {
		border-color: rgb(127 29 29);
		background-color: #ffffff;
		box-shadow:
			0 4px 6px -1px rgb(0 0 0 / 0.1),
			0 2px 4px -2px rgb(0 0 0 / 0.1);
	}
	#epikoinonia .faq-item .faq-chevron {
		transition: transform 0.3s ease;
	}
	#epikoinonia .faq-item.is-open .faq-chevron {
		transform: rotate(90deg);
	}
	#epikoinonia .faq-answer {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition:
			grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1),
			opacity 0.35s ease;
	}
	#epikoinonia .faq-item.is-open .faq-answer {
		grid-template-rows: 1fr;
		opacity: 1;
	}
	#epikoinonia .faq-answer > div {
		overflow: hidden;
		min-height: 0;
	}
	/* The answer text follows the height expansion with a slight lift + delay. */
	#epikoinonia .faq-answer > div > div > * {
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	#epikoinonia .faq-item.is-open .faq-answer > div > div > * {
		opacity: 1;
		transform: translateY(0);
		transition-delay: 0.15s;
	}
	#epikoinonia .copy:is(.clicked) {
		background-color: rgb(22, 163, 74);
	}
	@media (prefers-reduced-motion: reduce) {
		#epikoinonia .faq-item,
		#epikoinonia .faq-item .faq-chevron,
		#epikoinonia .faq-answer,
		#epikoinonia .faq-answer > div > div > * {
			transition: none !important;
		}
	}
</style>

<script>
	import { AnimTimeline, onElementMount } from "@utilities/dom";

	onElementMount("#epikoinonia", () => {
		document.querySelectorAll<HTMLButtonElement>("#epikoinonia .copy").forEach((btn) => {
			btn.addEventListener("click", () => {
				const text = btn.dataset.copy;
				if (!text) return;
				const icon = btn.querySelector("i") as HTMLElement;
				const atl = new AnimTimeline();
				atl.step(() => {
					navigator.clipboard.writeText(text);
					btn.classList.add("clicked");
					icon.classList.remove("fa-regular", "fa-clipboard");
					icon.classList.add("fa-solid", "fa-clipboard-check");
				})
					.step({
						time: 1000,
						anim: () => {
							btn.classList.remove("clicked");
							icon.classList.add("fa-regular", "fa-clipboard");
							icon.classList.remove("fa-solid", "fa-clipboard-check");
						},
					})
					.start();
			});
		});

		document.querySelectorAll<HTMLButtonElement>("#epikoinonia .faq-toggle").forEach((btn) => {
			btn.addEventListener("click", () => {
				const item = btn.closest(".faq-item") as HTMLElement;
				const isOpen = item.classList.toggle("is-open");
				btn.setAttribute("aria-expanded", String(isOpen));
				// Accordion behavior: at most one question open at a time.
				if (isOpen) {
					document.querySelectorAll<HTMLElement>("#epikoinonia .faq-item.is-open").forEach((other) => {
						if (other === item) return;
						other.classList.remove("is-open");
						other.querySelector<HTMLButtonElement>(".faq-toggle")?.setAttribute("aria-expanded", "false");
					});
				}
			});
		});
	});
</script>
