---
import ProviderButtons from "@components/auth/ProviderButtons.astro";
import Input from "@components/input/Input.astro";
import { API, useAPI } from "@hooks/useAPI.server";
import SigninLayout from "@layouts/SigninLayout.astro";
import { enabledProviders } from "@lib/auth/providers";
export const prerender = false;

const { link } = Astro.params;
if (!link) {
	return Astro.redirect("/");
}
const res = await useAPI(API.SysUsers.validateRegisterLink, { UrlArgs: { link } }, Astro).catch(() => null);

if (!res?.data?.isValid) {
	return Astro.redirect("/");
}
// The account must be created with the invited email (enforced server-side).
const invitedEmail = res.data.email;
const providers = enabledProviders();
---

<SigninLayout title="Εγγραφή Διαχειριστή" noindex>
	<div
		class="p-12 max-sm:px-6 h-max place-self-center bg-white dark:bg-dark grid auto-rows-min shadow-lg shadow-gray-700 rounded-md gap-y-8 border border-transparent dark:border-gray-700">
		<div class="grid justify-center content-center">
			<a href="/" class="relative">
				<img class="h-25 brightness-150" src="/logo.png" alt="Λογότυπο Σχολής" />
				<img class="h-25 absolute brightness-150 blur-[1px] opacity-40 top-px -left-0.5" src="/logo.png" alt="Λογότυπο Σχολής" />
			</a>
		</div>
		<h2 class="text-3xl font-didact text-center text-red-950 dark:text-red-50">Εγγραφή Διαχειριστή</h2>
		<ProviderButtons providers={providers} verb="Εγγραφή" />
		<form id="signupForm" action="" method="post" class="group grid gap-y-8" data-email={invitedEmail}>
			<!-- The account must use the invited email (enforced server-side), so it is shown, not edited. -->
			<Input type="email" name="email" label="Email" icon="mail" value={invitedEmail} disabled />
			<div class="grid gap-1">
				<Input type="password" name="password" label="Κωδικός" icon="lock" required />
				<p class="px-4 text-sm text-gray-600 dark:text-gray-300">Τουλάχιστον 8 χαρακτήρες.</p>
			</div>
			<button
				class="py-2 text-2xl text-white shadow-lg shadow-gray-400 dark:shadow-gray-700 rounded-lg transition-colors duration-300 bg-green-500 hover:bg-green-600 focus:bg-green-600 dark:bg-green-600 dark:hover:bg-green-500 dark:focus:bg-green-500 group-[:is(.animate-shake)]:bg-red-600 dark:group-[:is(.animate-shake)]:bg-red-700"
				type="submit">Εγγραφή</button
			>
		</form>
		<div class="grid gap-y-6">
			<p id="signupError" role="alert" class="hidden max-w-[30ch] justify-self-center text-center text-base text-red-700 dark:text-red-300"></p>
			{
				providers.length > 0 && (
					<p class="max-w-[30ch] justify-self-center text-center text-sm text-gray-600 dark:text-gray-300">
						Ο λογαριασμός πρέπει να έχει το email της πρόσκλησης. Μπορείτε να συνδέσετε κι άλλους λογαριασμούς αργότερα, από «Ο λογαριασμός μου».
					</p>
				)
			}
		</div>
	</div>
	<style is:inline>
		@keyframes ShakeAnimation {
			0% {
				transform: translateX(0);
				filter: blur(0px);
			}
			10%,
			30%,
			70%,
			90% {
				transform: translateX(1px);
			}
			20%,
			40%,
			60%,
			80% {
				transform: translateX(-1px);
			}
			50% {
				transform: translateX(1px);
				filter: blur(1px);
			}
			100% {
				transform: translateX(0px);
				filter: blur(0px);
			}
		}

		.animate-shake button {
			animation: ShakeAnimation 0.6s ease-in-out;
		}
	</style>
</SigninLayout>
<script>
	import { apiCall } from "@hooks/apiCall";
	import { bindProviderButtons } from "@lib/auth/oauth.client";
	import { API } from "@routes/index.client";

	const link = decodeURIComponent(window.location.pathname.split("/").filter(Boolean).pop() ?? "");
	const errorEl = document.getElementById("signupError")!;
	const showError = (message: string) => {
		errorEl.textContent = message;
		errorEl.classList.remove("hidden");
	};

	let tid: number | null = null;
	document.getElementById("signupForm")?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const form = e.currentTarget as HTMLFormElement;
		const password = new FormData(form).get("password") as string;
		try {
			if (password.length < 8) throw new Error("Ο κωδικός πρέπει να έχει τουλάχιστον 8 χαρακτήρες");
			await apiCall(API.SysUsers.registerSysUser, {
				RequestObject: { email: form.dataset.email!, password },
				UrlArgs: { link },
			});
			localStorage.removeItem("sys_user"); // pre-0008 copy of the signed-in admin
			window.location.href = "/admin";
			return;
		} catch (error) {
			showError(error instanceof Error ? error.message : "Προέκυψε σφάλμα. Δοκιμάστε ξανά.");
		}
		if (tid) {
			clearTimeout(tid);
			form.classList.remove("animate-shake");
			void form.offsetWidth;
		}
		form.classList.add("animate-shake");
		tid = setTimeout(() => {
			form.classList.remove("animate-shake");
		}, 1000) as unknown as number;
	});

	bindProviderButtons(() => ({ intent: "signup", link }), showError);
</script>
