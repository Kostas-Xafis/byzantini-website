---
import AdminRouter from "@components/admin/AdminRouter.solid.tsx";
import AdminLayout from "@layouts/AdminLayout.astro";
import { isSessionValid } from "@lib/auth/sessions";
import { buildLoginUrl } from "@utilities/redirect";
export const prerender = false;

// Gate the admin shell on the server (in-process session lookup, no self-fetch): a visitor without a valid
// session is redirected before any admin markup is sent, and comes back to the requested admin URL after
// signing in (`/login?redirect_url=<path+query>`; the hash never reaches the server).
const sessionCookie = Astro.cookies.get("session_id")?.value;
if (!(await isSessionValid(sessionCookie))) {
	// A cookie that no longer opens a session = it expired or was signed out elsewhere: say so on the sign-in screen.
	return Astro.redirect(buildLoginUrl(`${Astro.url.pathname}${Astro.url.search}`, { expired: !!sessionCookie }));
}
---

<AdminLayout title="Διαχείριση Σχολής">
	<AdminRouter client:only="solid-js" />
</AdminLayout>
