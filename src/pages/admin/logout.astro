---
import SigninLayout from "@layouts/SigninLayout.astro";
export const prerender = false;

if (!Astro.cookies.get("session_id")?.value) return Astro.redirect("/login");
---

<SigninLayout title="Αποσύνδεση">
	<h1>Αποσύνδεση...</h1>
	<script>
		import { apiCall } from "@hooks/apiCall";
		try {
			// The server clears the HttpOnly session cookie.
			await apiCall("Authentication.userLogout");
			localStorage.removeItem("sys_user"); // pre-0008 copy of the signed-in admin
			document.location.pathname = "/login";
		} catch (e) {
			document.location.pathname = "/admin";
		}
	</script>
</SigninLayout>
