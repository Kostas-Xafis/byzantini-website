---
import { useAPI } from "@hooks/useAPI.astro";
import SigninLayout from "@layouts/SigninLayout.astro";
export const prerender = false;

// The url link is not properly constructed as I didn't encode to a URI component
let restoredUrl = new URL(Astro.url.href.replace("/?token", "?token"));

const token = restoredUrl.searchParams.get("token") || "";

// State machine: "confirm" → 2-button verification, "success" → done (PRG),
// "failure" → invalid token or failed unsubscription.
type UnsubscribeState = "confirm" | "success" | "failure";
let state: UnsubscribeState = "failure";

if (restoredUrl.pathname.endsWith("/success")) {
	state = "success";
} else if (Astro.request.method === "POST") {
	const res = await useAPI("Registrations.emailUnsubscribe", { RequestObject: { token } }, Astro);
	if (res.data?.isValid) return Astro.redirect("/unsubscribe/success");
	state = "failure";
} else {
	const res = await useAPI("Registrations.emailUnsubscribeValidate", { RequestObject: { token } }, Astro);
	state = res.data?.isValid ? "confirm" : "failure";
}
---

<SigninLayout title="Απεγγραφή" noindex>
	<div
		class="p-12 max-sm:px-6 h-max place-self-center bg-white dark:bg-dark grid grid-rows-[100px_min-content_1fr] shadow-lg shadow-gray-700 rounded-md gap-y-12 border border-transparent dark:border-gray-700">
		<div class="grid justify-center content-center">
			<a href="/" class="relative">
				<img class="h-[100px] brightness-150" src="/logo.png" alt="Λογότυπο Σχολής" />
				<img class="h-[100px] absolute brightness-150 blur-[1px] opacity-40 top-[1px] left-[-2px]" src="/logo.png" alt="Λογότυπο Σχολής" />
			</a>
		</div>
		{
			state === "confirm" ? (
				<div class="text-center">
					<h2 class="text-3xl font-didact text-red-950 dark:text-red-50">Απεγγραφή από το newsletter</h2>
					<p class="pt-4 text-xl font-didact text-red-950 dark:text-red-50">
						Είστε σίγουρος/η πως θέλετε να απεγγραφείτε από τα ενημερωτικά μας email;
					</p>
					<div class="pt-8 flex flex-wrap items-center justify-center gap-4">
						<form method="POST" action="" class="m-0">
							<button
								type="submit"
								class="px-6 py-3 text-xl font-medium text-white rounded-lg shadow-lg shadow-gray-400 dark:shadow-gray-700 transition-colors duration-300 bg-red-500 hover:bg-red-600 focus:bg-red-600 dark:bg-red-600 dark:hover:bg-red-500 dark:focus:bg-red-500">
								Ναι, απεγγραφείτε
							</button>
						</form>
						<a
							href="/"
							class="px-6 py-3 text-xl font-medium text-gray-700 dark:text-gray-100 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-md dark:shadow-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-300">
							Ακύρωση
						</a>
					</div>
				</div>
			) : state === "success" ? (
				<div class="text-center">
					<h2 class="text-3xl font-didact text-red-950 dark:text-red-50">Επιτυχής απεγγραφή</h2>
					<p class="text-xl font-didact text-red-950 dark:text-red-50">Έχετε απεγγραφεί από την λίστα αλληλογραφίας της Σχολής.</p>
				</div>
			) : (
				<div class="text-center">
					<h2 class="text-3xl font-didact text-red-950 dark:text-red-50">Αποτυχία απεγγραφής</h2>
					<p class="text-xl font-didact text-red-950 dark:text-red-50">Δεν ήταν δυνατή η απεγγραφή σας από την λίστα αλληλογραφίας της Σχολής.</p>
				</div>
			)
		}
	</div>
</SigninLayout>
