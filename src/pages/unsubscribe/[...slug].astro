---
import { useAPI } from "@hooks/useAPI.astro";
import SigninLayout from "@layouts/SigninLayout.astro";
export const prerender = false;

// The url link is not properly constructed as I didn't encode to a URI component
let restoredUrl = new URL(Astro.url.href.replace("/?token", "?token"));

const token = restoredUrl.searchParams.get("token") || "";

const res = await useAPI("Registrations.emailUnsubscribe", { RequestObject: { token } }, Astro);
let success = res.data?.isValid || false;
---

<SigninLayout title="Απεγγραφή" noindex>
	<div
		class="p-12 max-sm:px-6 h-max place-self-center bg-white dark:bg-dark grid grid-rows-[100px_min-content_1fr] shadow-lg shadow-gray-700 rounded-md gap-y-12 border border-transparent dark:border-gray-700">
		<div class="grid justify-center content-center">
			<a href="/" class="relative">
				<img class="h-[100px] brightness-150" src="/logo.png" alt="Λογότυπο Σχολής" />
				<img
					class="h-[100px] absolute brightness-150 blur-[1px] opacity-40 top-[1px] left-[-2px]"
					src="/logo.png"
					alt="Λογότυπο Σχολής"
				/>
			</a>
		</div>
		{
			success ? (
				<div class="text-center">
					<h2 class="text-3xl font-didact text-red-950 dark:text-red-50">Επιτυχής απεγγραφή</h2>
					<p class="text-xl font-didact text-red-950 dark:text-red-50">
						Έχετε απεγγραφεί από την λίστα αλληλογραφίας της Σχολής.
					</p>
				</div>
			) : (
				<div class="text-center">
					<h2 class="text-3xl font-didact text-red-950 dark:text-red-50">Αποτυχία απεγγραφής</h2>
					<p class="text-xl font-didact text-red-950 dark:text-red-50">
						Δεν ήταν δυνατή η απεγγραφή σας από την λίστα αλληλογραφίας της Σχολής.
					</p>
				</div>
			)
		}
	</div>
</SigninLayout>
