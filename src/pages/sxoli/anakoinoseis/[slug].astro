---
import type { AnnouncementImages, Announcements } from "@_types/entities";
import JsonLd from "@components/seo/JsonLd.astro";
import Spinner from "@components/other/Spinner.astro";
import Layout from "@layouts/Layout.astro";
import { API, useAPI } from "@lib/hooks/useAPI.astro";
import { breadcrumbsSchema, SCHOOL, SCHOOL_ID } from "@utilities/schema";
import { unescapeNewlines } from "@utilities/text";
export const prerender = false;

let url = Astro.url.pathname;
url = url.endsWith("/") ? url.slice(0, -1) : url;
let announcement_title = url.split("/").pop() as string;
// The path is only partially decoded; decodeURIComponent also handles characters like
// commas in titles (e.g. "%2C") that .replaceAll("%20", " ") would miss.
try {
	announcement_title = decodeURIComponent(announcement_title);
} catch {
	// Malformed percent-encoding → keep the raw segment and let the 404 redirect handle it
}
// Commas are stripped from announcement URLs (the platform router rejects %2C
// before the app sees it); the lookup below matches by comma-less title.
announcement_title = announcement_title.replaceAll(",", "");
let announcement: (Announcements & { images: AnnouncementImages[] }) | undefined;
try {
	const res_announcement = await useAPI(
		API.Announcements.getByTitle,
		{
			UrlArgs: { title: announcement_title },
		},
		Astro,
	);
	announcement = res_announcement.data;
	if (!announcement) return Astro.rewrite("/404");
} catch (e) {
	return Astro.rewrite("/404");
}
const imgSrc = "/anakoinoseis/images/" + announcement.id + "/";
const imgThumbSrc = "/anakoinoseis/images/" + announcement.id + "/thumb_";

const mainImg = announcement.images.find((img) => img.is_main) as AnnouncementImages;
announcement.images = announcement.images.filter((img) => !img.is_main && !img.name.startsWith("thumb_"));
if (!mainImg) return Astro.rewrite("/404");

const formatDate = (d: number) => new Date(d).toLocaleDateString("el-GR", { day: "numeric", month: "long", year: "numeric" });
const isRecent = (d: number) => Date.now() - d < 7 * 24 * 60 * 60 * 1000;

// Dev/replication snapshots store newlines as the two characters "\n";
// unescapeNewlines is a no-op on production data and makes paragraphs split
// correctly in both worlds.
const paragraphs = unescapeNewlines(announcement.content)
	.split("\n")
	.map((p) => p.trim())
	.filter(Boolean);
const links = announcement.links
	? unescapeNewlines(announcement.links)
			.split("|")
			.map((l) => l.trim())
			.filter(Boolean)
	: [];

// The server wraps bare URLs in <a href='...'>...</a> when saving; render them as
// real links without using set:html (content stays text, only links become anchors).
const contentAnchorPattern = /<a href='([^']+)'>([^<]*)<\/a>/g;

// Meta description: first ~155 characters of the announcement text.
const announcementDescription = paragraphs
	.join(" ")
	.replace(/<[^>]*>/g, "")
	.slice(0, 155)
	.trim();

// Extract a YouTube video id from an embed link (e.g. "https://www.youtube.com/embed/ZI5ocBAaHEc").
const youtubeId = (link: string) => link.match(/www\.youtube\.com\/embed\/([A-Za-z0-9_-]+)/)?.[1];

// Structured data: Article + BreadcrumbList for this announcement.
const canonicalPath = Astro.url.pathname;
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "Article",
	"@id": `${SCHOOL.url}${canonicalPath}#article`,
	headline: announcement.title,
	description: announcementDescription,
	datePublished: new Date(announcement.date).toISOString(),
	image: [`${SCHOOL.url}${imgSrc}${mainImg.name}`],
	author: { "@type": "Organization", "@id": SCHOOL_ID },
	publisher: { "@type": "Organization", "@id": SCHOOL_ID },
	mainEntityOfPage: `${SCHOOL.url}${canonicalPath}`,
	inLanguage: "el-GR",
};
const breadcrumbs = breadcrumbsSchema([
	{ name: "Αρχική", url: "/" },
	{ name: "Ανακοινώσεις", url: "/sxoli/anakoinoseis" },
	{ name: announcement.title, url: canonicalPath },
]);

// One VideoObject per embedded YouTube video in this announcement.
const videoSchemas = links
	.filter((link) => youtubeId(link))
	.map((embedUrl) => ({
		"@context": "https://schema.org",
		"@type": "VideoObject",
		name: announcement.title,
		description: announcementDescription,
		thumbnailUrl: [`${SCHOOL.url}${imgSrc}${mainImg.name}`],
		uploadDate: new Date(announcement.date).toISOString(),
		embedUrl,
		publisher: { "@type": "Organization", "@id": SCHOOL_ID },
		inLanguage: "el-GR",
	}));
---

<Layout title={announcement.title} description={announcementDescription} imageUrl={imgThumbSrc + mainImg.name}>
	<JsonLd data={articleSchema} />
	<JsonLd data={breadcrumbs} />
	{videoSchemas.map((video) => <JsonLd data={video} key={video.embedUrl} />)}
	<div
		id="readingProgressBar"
		class="pointer-events-none fixed left-0 right-0 z-[999] h-[3px]"
		role="progressbar"
		aria-label="Πρόοδος ανάγνωσης"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow="0">
		<div
			class="h-full w-full origin-left bg-red-900 shadow-[0_1px_3px_rgba(127,29,29,0.35)] transition-transform duration-75 ease-out will-change-transform">
		</div>
	</div>
	<section
		id="announcementSection"
		data-announcement-id={announcement.id}
		class="relative flex flex-col items-center gap-y-6 overflow-auto px-10 py-10 max-sm:px-4 max-sm:py-6 max-sm:pb-24">
		<a
			href="/sxoli/anakoinoseis"
			class="self-start inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-3 py-1.5 text-lg max-sm:text-sm text-red-900 transition-colors duration-300 hover:bg-red-900 hover:text-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2">
			<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
			Οι Ανακοινώσεις
		</a>

		<h1
			class="max-w-[60ch] text-center text-4xl max-sm:text-2xl font-bold text-red-900 font-anaktoria break-words drop-shadow-[-1px_2px_1px_rgba(0,0,0,0.25)]">
			{announcement.title}
		</h1>

		<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
			<span class="inline-flex items-center gap-1.5 rounded-md bg-red-900 px-2.5 py-1 text-sm max-sm:text-xs text-red-50">
				<i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
				<time datetime={new Date(announcement.date).toISOString()}>
					{formatDate(announcement.date)}
				</time>
			</span>
			<span class="inline-flex items-center gap-1.5 rounded-md border border-red-900/30 bg-red-900/10 px-2.5 py-1 text-sm max-sm:text-xs text-red-900">
				<i class="fa-solid fa-eye" aria-hidden="true"></i>
				{announcement.views}
				{announcement.views > 1 ? "προβολές" : "προβολή"}
			</span>
			{
				isRecent(announcement.date) && (
					<span
						class="inline-flex items-center rounded-md bg-amber-400/95 px-2.5 py-1 text-sm max-sm:text-xs font-bold text-amber-950"
						aria-label="Νέα ανακοίνωση">
						Νέο
					</span>
				)
			}
		</div>

		<div class="imgLoader group/img relative w-full max-w-[780px]">
			<div class="hidden group-[:is(.loading)]/img:block absolute inset-0 z-10 grid place-items-center rounded-sm bg-red-50/40 backdrop-blur-[2px]">
				<Spinner />
			</div>
			<div class="group-[:is(.loaded)]/img:block w-full overflow-hidden rounded-sm border-2 border-red-900 shadow-md shadow-slate-600">
				<img
					id="posterImg"
					fetchpriority="high"
					data-src={imgSrc + mainImg.name}
					src={imgSrc + mainImg.name}
					alt={announcement.title}
					width="780"
					height="640"
					class="w-full max-h-[clamp(0px,100vh,640px)] max-sm:max-h-[420px] object-cover"
				/>
			</div>
		</div>

		{
			paragraphs.length > 0 && (
				<article class="w-full max-w-[75ch] mt-2 text-xl max-sm:text-base leading-relaxed">
					{paragraphs.map((p) => (
						<p class="pb-4 last:pb-0">
							{p.split(contentAnchorPattern).map((part, i, arr) =>
								i % 3 === 1 ? (
									<a
										href={part}
										target="_blank"
										rel="noopener noreferrer"
										class="text-red-800 underline decoration-1 underline-offset-2 hover:text-red-950">
										{arr[i + 1]}
									</a>
								) : i % 3 === 2 ? null : (
									part
								),
							)}
						</p>
					))}
				</article>
			)
		}

		{
			links.length > 0 && (
				<div class="flex w-full max-w-[720px] flex-col items-center gap-y-4 mt-2">
					<h2 class="text-2xl font-anaktoria font-bold text-red-900">Βίντεο</h2>
					<div class="flex w-full flex-wrap items-center justify-center gap-6">
						{links.map((link) => {
							const ytId = youtubeId(link);
							// YouTube embeds use a click-to-play facade with a real, high-res
							// thumbnail. Loading the player while hidden makes YouTube pick its
							// tiny 120x90 `default.jpg` poster; showing the thumbnail ourselves
							// guarantees sharp quality (up to 1280x720) and defers the heavy
							// player until the user actually wants to watch.
							if (ytId) {
								return (
									<div
										class="videoWrap group/video relative w-full max-w-[720px] aspect-video overflow-hidden rounded-sm border-2 border-red-900 shadow-md shadow-slate-600"
										data-video-id={ytId}>
										<button
											type="button"
											class="videoPoster absolute inset-0 w-full h-full cursor-pointer"
											data-embed-src={link + (link.includes("?") ? "&" : "?") + "autoplay=1"}
											aria-label="Αναπαραγωγή βίντεο">
											<img
												src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`}
												alt="Προεπισκόπηση βίντεο"
												loading="lazy"
												decoding="async"
												class="w-full h-full object-cover"
											/>
											<span class="absolute inset-0 grid place-items-center bg-black/20 transition-colors duration-300 hover:bg-black/10">
												<span class="grid place-items-center w-16 h-16 max-sm:w-12 max-sm:h-12 rounded-full bg-red-900 text-red-50 text-2xl max-sm:text-xl shadow-lg transition-transform duration-300 group-hover/video:scale-110">
													<i class="fa-solid fa-play" aria-hidden="true" />
												</span>
											</span>
										</button>
										<div class="videoFrame hidden w-full h-full">
											<iframe
												title="Βίντεο ανακοίνωσης"
												class="w-full h-full"
												frameborder="0"
												allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
												referrerpolicy="strict-origin-when-cross-origin"
												allowfullscreen
											/>
										</div>
									</div>
								);
							}
							return (
								<div class="imgLoader group/img relative w-full max-w-[720px] aspect-video">
									<div class="hidden group-[:is(.loading)]/img:block absolute inset-0 rounded-sm">
										<Spinner />
									</div>
									<div class="hidden group-[:is(.loaded)]/img:block w-full h-full overflow-hidden rounded-sm border-2 border-red-900 shadow-md shadow-slate-600">
										<iframe
											data-src={link}
											title="Βίντεο ανακοίνωσης"
											class="w-full h-full"
											frameborder="0"
											allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
											referrerpolicy="strict-origin-when-cross-origin"
											allowfullscreen
										/>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			)
		}

		{
			announcement.images.length > 0 && (
				<div id="imgContainer" class="flex w-full flex-col items-center gap-y-4 mt-2">
					<h2 class="text-2xl font-anaktoria font-bold text-red-900">Φωτογραφίες</h2>
					<div class="flex w-full flex-wrap items-center justify-center gap-6">
						{announcement.images.map((image, i) => (
							<div class="imgLoader group/img relative w-[400px] max-w-[85vw] h-[320px]" data-imgIndex={i}>
								<div class="hidden group-[:is(.loading)]/img:block absolute inset-0">
									<Spinner />
								</div>
								<button
									type="button"
									class="hidden group-[:is(.loaded)]/img:block w-full h-full cursor-pointer overflow-hidden rounded-sm border-2 border-red-900 transition-shadow hover:shadow-lg !shadow-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2">
									<img
										data-src={imgThumbSrc + image.name}
										alt={announcement.title}
										width="400"
										height="320"
										class="w-full h-full object-cover"
									/>
								</button>
							</div>
						))}
					</div>
				</div>
			)
		}
	</section>

	<div
		id="imageCarouselContainer"
		class={"max-sm:hidden fixed inset-0 py-4 bg-[rgba(40,10,10,0.4)] backdrop-blur-[3px] grid place-content-center z-[1000]" + " hidden"}>
		<div
			class="relative grid grid-rows-[min-content,1fr] justify-center items-center p-8 bg-[rgba(40,10,10,0.875)] rounded-md shadow-lg shadow-[rgba(40,10,10,1)] backdrop-blur-[4px]">
			<div class="absolute top-2 right-3 flex flex-row justify-end">
				<button id="carouselClose" type="button" class="rounded-xl text-2xl">
					<i class="fa-solid fa-xmark text-white hover:text-red-100"></i>
				</button>
			</div>
			<div id="imageCarousel" data-index="0" class="max-h-[calc(95dvh_-_24px)] grid grid-rows-[calc(95dvh_-_79px),76px] justify-items-center gap-y-2">
				<div class="imgLoader group/img flex flex-col items-center">
					<div class="relative max-w-[90dvw] max-h-[calc(95dvh_-_79px)] flex items-center rounded-lg overflow-hidden">
						<div class="absolute inset-0 hidden group-[:is(.loading)]/img:flex items-center backdrop-blur-sm">
							<Spinner />
						</div>
						<img
							id="mainCarouselImg"
							alt={announcement.title}
							class="object-cover h-[clamp(0px,100vh,calc(95dvh_-_79px))] hover:shadow-lg !shadow-red-950"
							data-src={announcement.images[0] ? imgSrc + announcement.images[0].name : ""}
						/>
					</div>
				</div>
				<div id="thumbContainer" class="flex flex-row gap-x-4 items-center self-center">
					<i
						data-direction="left"
						class="pr-8 fa-solid fa-chevron-left font-bold text-2xl text-white hover:text-red-100 max-sm:text-xs max-sm:px-2 max-3xs:text-xs cursor-pointer"
					></i>
					{
						announcement.images
							.slice(0, 5)
							.map((image) => (
								<img
									class="w-[60px] aspect-square object-cover h-full rounded-md overflow-hidden opacity-60 transition-opacity duration-300 hover:opacity-90 hover:shadow-lg !shadow-red-950 cursor-pointer"
									alt={announcement.title}
									src={imgThumbSrc + image.name}
								/>
							))
					}
					<i
						data-direction="right"
						class="pl-8 fa-solid fa-chevron-right font-bold text-2xl text-white hover:text-red-100 max-sm:text-xs max-sm:px-2 max-3xs:text-xs cursor-pointer"
					></i>
				</div>
			</div>
		</div>
	</div>

	<style>
		body {
			background: radial-gradient(circle at 50% -50%, rgb(234 212 212), transparent);
		}
		#imgContainer button {
			transition: box-shadow 0.2s cubic-bezier(0, 0.8, 0.43, 0.64);
		}
	</style>

	<script>
		import { onElementMount } from "@utilities/dom";
		import { sleep } from "@utilities/sleep";

		onElementMount("#announcementSection", async (section) => {
			const loaders = [...section.querySelectorAll(".imgLoader")] as HTMLElement[];

			// ------- Progressive media loading (poster, gallery thumbnails, YouTube embeds) -------
			const runLoader = (loader: HTMLElement) => {
				const img = loader.querySelector<HTMLImageElement>("img[data-src]");
				const frame = loader.querySelector<HTMLIFrameElement>("iframe[data-src]");
				if (!img && !frame) return Promise.resolve();

				loader.classList.add("loading");
				return new Promise<void>((resolve) => {
					let settled = false;
					const settle = () => {
						if (settled) return;
						settled = true;
						loader.classList.remove("loading");
						loader.classList.add("loaded");
						resolve();
					};
					const target = (img || frame) as HTMLImageElement | HTMLIFrameElement;
					target.addEventListener("load", settle, { once: true });
					target.addEventListener("error", settle, { once: true });

					if (img) {
						// Letterbox (don't crop) vertically-oriented poster images.
						const applyPosterAspect = () => {
							if (img.naturalHeight > img.naturalWidth) {
								img.classList.remove("object-cover");
								img.style.setProperty("object-fit", "contain");
							}
						};
						if (img.id === "posterImg") {
							img.addEventListener("load", applyPosterAspect, { once: true });
							if (img.complete && img.naturalWidth > 0) applyPosterAspect();
						}
						// Gallery images start WITHOUT a src (only data-src). Note: an <img>
						// with no src has img.complete === true, so "complete" must not be
						// treated as "already loaded" unless a src was actually set.
						const hasSrc = !!img.getAttribute("src");
						if (!hasSrc) {
							img.src = img.dataset.src as string; // load/error listeners settle
						} else if (img.complete) {
							settle(); // already loaded (or already failed) before this script ran
						}
						// src set but still loading: the listeners above settle it
					} else {
						(frame as HTMLIFrameElement).src = (frame as HTMLIFrameElement).dataset.src as string;
					}
				});
			};

			// Small concurrency pool (max 5), fed by an IntersectionObserver so below-the-fold
			// media (and heavy YouTube embeds) load only when scrolled near + a 6s safety net.
			let queue: (() => Promise<void>)[] = [];
			let running = 0;
			const MAX_RUNNING = 5;
			const pump = () => {
				while (running < MAX_RUNNING && queue.length) {
					running++;
					queue.shift()!().finally(() => {
						running--;
						pump();
					});
				}
			};
			const enqueue = (loader: HTMLElement) => {
				queue.push(() => runLoader(loader));
				pump();
			};

			const obsv = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							obsv.unobserve(entry.target);
							enqueue(entry.target as HTMLElement);
						}
					});
				},
				{ root: null, rootMargin: "300px 0px", threshold: 0.01 },
			);
			loaders.forEach((loader) => obsv.observe(loader));
			setTimeout(() => {
				loaders.forEach((loader) => {
					if (!loader.classList.contains("loaded") && !loader.classList.contains("loading")) {
						obsv.unobserve(loader);
						enqueue(loader);
					}
				});
			}, 6000);

			// ------- Gallery clicks: carousel on desktop, full image in a new tab on mobile -------
			section
				.querySelector("#imgContainer")
				?.querySelectorAll(".imgLoader")
				.forEach((container) => {
					container.addEventListener("click", () => {
						const index = Number((container as HTMLElement).dataset.imgindex ?? 0);
						if (window.matchMedia("(max-width: 639px)").matches) {
							const img = container.querySelector("img") as HTMLImageElement | null;
							if (img?.src) window.open(img.src.replace("thumb_", ""), "_blank");
						} else {
							document.dispatchEvent(new CustomEvent("open_carousel", { detail: { index } }));
						}
					});
				});

			// ------- Video facade: high-res thumbnail, click-to-play embed -------
			section.querySelectorAll("[data-video-id] img").forEach((img) => {
				const id = (img.closest("[data-video-id]") as HTMLElement).dataset.videoId;
				// Some videos have no HD thumbnail; fall back to 640x480 and then 480x360.
				const fallbacks = [`https://i.ytimg.com/vi/${id}/sddefault.jpg`, `https://i.ytimg.com/vi/${id}/hqdefault.jpg`];
				let fallbackIdx = 0;
				img.addEventListener("error", () => {
					if (fallbackIdx < fallbacks.length) img.src = fallbacks[fallbackIdx++];
				});
			});
			section.querySelectorAll(".videoPoster").forEach((poster) => {
				poster.addEventListener("click", () => {
					const wrap = poster.closest(".videoWrap") as HTMLElement | null;
					const frame = wrap?.querySelector(".videoFrame") as HTMLElement | null;
					const iframe = frame?.querySelector("iframe") as HTMLIFrameElement | null;
					if (!wrap || !frame || !iframe) return;
					frame.classList.remove("hidden");
					iframe.src = poster.getAttribute("data-embed-src") as string;
					poster.classList.add("hidden");
				});
			});
		});

		// ------- Image carousel (desktop only) -------
		function setupCarousel() {
			const imgSrcArr = ([...document.querySelectorAll("#imgContainer img")] as HTMLImageElement[]).map((img) =>
				(img.dataset.src as string).split("/").pop()?.replace("thumb_", ""),
			) as string[];
			if (!imgSrcArr.length) return;

			const announcementId = (document.querySelector("section[data-announcement-id]") as HTMLElement).dataset.announcementId as string;
			const imgSrc = "/anakoinoseis/images/" + announcementId + "/";
			const imgThumbSrc = "/anakoinoseis/images/" + announcementId + "/thumb_";

			const carousel = document.querySelector("#imageCarousel") as HTMLElement;
			const mainCarouselImg = document.querySelector("#mainCarouselImg") as HTMLImageElement;
			const thumbContainer = document.querySelector("#thumbContainer") as HTMLElement;
			const thumbCarouselImgs = [...thumbContainer.querySelectorAll("img")];
			const totalLength = imgSrcArr.length;
			const carouselLength = Math.min(5, totalLength);
			let currIndex = Number(carousel.dataset.index || 0);

			function transitionToNextImage(nextIndex: number) {
				const imgLoader = carousel.querySelector(".imgLoader") as HTMLElement;
				const started = Date.now();
				let done = false;
				const finish = async () => {
					if (done) return;
					done = true;
					await sleep(Math.max(0, 250 - (Date.now() - started))); // avoid flicker
					imgLoader.classList.remove("loading");
					imgLoader.classList.add("loaded");
				};
				mainCarouselImg.addEventListener("load", finish, { once: true });
				mainCarouselImg.addEventListener("error", finish, { once: true });
				imgLoader.classList.add("loading");
				imgLoader.classList.remove("loaded");
				mainCarouselImg.src = imgSrc + imgSrcArr[nextIndex];
			}
			function updateThumbs() {
				if (totalLength <= 5) return;
				for (let i = 0; i < carouselLength; i++) {
					const nextIndex = (currIndex + i - 2 + totalLength) % totalLength;
					thumbCarouselImgs[i].src = imgThumbSrc + imgSrcArr[nextIndex];
				}
			}
			function carouselShift(direction: "left" | "right") {
				currIndex = (currIndex + (direction === "left" ? -1 : 1) + totalLength) % totalLength;
				transitionToNextImage(currIndex);
				updateThumbs();
			}
			function carouselGoto(index: number) {
				currIndex = index;
				transitionToNextImage(currIndex);
				updateThumbs();
			}

			document.querySelector("i[data-direction='left']")?.addEventListener("click", () => {
				carouselShift("left");
				carousel.dataset.index = currIndex.toString();
			});
			document.querySelector("i[data-direction='right']")?.addEventListener("click", () => {
				carouselShift("right");
				carousel.dataset.index = currIndex.toString();
			});
			thumbCarouselImgs.forEach((thumb, i) => {
				thumb.addEventListener("click", () => {
					const index = totalLength <= 5 ? i : (currIndex + i - 2 + totalLength) % totalLength;
					carouselGoto(index);
					carousel.dataset.index = currIndex.toString();
				});
			});

			const carouselContainer = document.querySelector("#imageCarouselContainer") as HTMLElement;
			document.addEventListener("open_carousel", (e) => {
				carouselGoto(Number((e as CustomEvent).detail.index ?? 0));
				carousel.dataset.index = currIndex.toString();
				carouselContainer.classList.remove("hidden");
			});
			document.addEventListener("close_carousel", () => {
				carouselContainer.classList.add("hidden");
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "ArrowLeft") carouselShift("left");
				else if (e.key === "ArrowRight") carouselShift("right");
				else if (e.key === "Escape") carouselContainer.classList.add("hidden");
			});

			onElementMount("#carouselClose", (el) => {
				el.addEventListener("click", () => {
					document.dispatchEvent(new CustomEvent("close_carousel"));
				});
			});
		}

		window.matchMedia("(min-width: 640px)").matches && setupCarousel();

		// ------- Reading progress bar: thin bar tucked right under the navbar -------
		onElementMount("#announcementSection", (section) => {
			const bar = document.querySelector<HTMLElement>("#readingProgressBar");
			const fill = bar?.querySelector<HTMLElement>("div");
			if (!bar || !fill) return;

			// The fixed navbar has a breakpoint-dependent height (4.2vw on desktop,
			// content-sized on small screens), so measure it and sit below its bottom edge.
			const nav = document.querySelector<HTMLElement>("nav");
			const placeBar = () => {
				if (nav) bar.style.top = `${nav.getBoundingClientRect().height}px`;
			};

			const update = () => {
				// The announcement section is its own scroll container (overflow-auto),
				// but fall back to the document scroller in case the layout ever changes.
				const scroller: Element = section.scrollHeight > section.clientHeight + 1 ? section : (document.scrollingElement ?? document.documentElement);
				const max = scroller.scrollHeight - scroller.clientHeight;
				const progress = max > 0 ? Math.min(1, Math.max(0, scroller.scrollTop / max)) : 0;
				fill.style.transform = `scaleX(${progress})`;
				bar.setAttribute("aria-valuenow", Math.round(progress * 100).toString());
			};

			section.addEventListener("scroll", update, { passive: true });
			window.addEventListener("scroll", update, { passive: true });
			window.addEventListener("resize", () => {
				placeBar();
				update();
			});
			// Fonts can shift the content-sized mobile navbar height; re-measure once loaded.
			window.addEventListener("load", placeBar);
			placeBar();
			update();
		});
	</script>
</Layout>
