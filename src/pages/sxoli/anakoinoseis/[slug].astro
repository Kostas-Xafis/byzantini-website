---
import Icon from "@components/other/Icon.astro";
import type { AnnouncementImages, Announcements } from "@_types/entities";
import JsonLd from "@components/seo/JsonLd.astro";
import Spinner from "@components/other/Spinner.astro";
import PhotoViewer from "@components/other/PhotoViewer.astro";
import Layout from "@layouts/Layout.astro";
import { API, useAPI } from "@hooks/useAPI.server";
import { breadcrumbsSchema, SCHOOL, SCHOOL_ID } from "@utilities/schema";
import { unescapeNewlines } from "@utilities/text";
import { announcementPath, isLegacyAnnouncementSlug, requestedAnnouncementSlug, announcementSlug } from "@utilities/announcementUrl";
export const prerender = false;

// The decoded last path segment (decodeURIComponent also handles characters like commas, "%2C").
const requestedSlug = requestedAnnouncementSlug(Astro.url.pathname);
// Older URLs still carry the commas of the title; the lookup matches by comma-less title and the redirect below
// sends them to the canonical URL.
const announcement_title = announcementSlug(requestedSlug);
let announcement: (Announcements & { images: AnnouncementImages[] }) | undefined;
try {
	const res_announcement = await useAPI(
		API.Announcements.getByTitle,
		{
			UrlArgs: { title: announcement_title },
		},
		Astro,
	);
	announcement = res_announcement.data;
	if (!announcement) return Astro.rewrite("/404");
} catch (e) {
	return Astro.rewrite("/404");
}
// Old URLs (with the commas of the title) are duplicates of the canonical one: send them there for good.
if (isLegacyAnnouncementSlug(requestedSlug, announcement.title)) return Astro.redirect(announcementPath(announcement.title) + Astro.url.search, 301);
const imgSrc = "/anakoinoseis/images/" + announcement.id + "/";
const imgThumbSrc = "/anakoinoseis/images/" + announcement.id + "/thumb_";

const mainImg = announcement.images.find((img) => img.is_main) as AnnouncementImages;
announcement.images = announcement.images.filter((img) => !img.is_main && !img.name.startsWith("thumb_"));
if (!mainImg) return Astro.rewrite("/404");

const formatDate = (d: number) => new Date(d).toLocaleDateString("el-GR", { day: "numeric", month: "long", year: "numeric" });
const isRecent = (d: number) => Date.now() - d < 7 * 24 * 60 * 60 * 1000;

// Dev/replication snapshots store newlines as the two characters "\n";
// unescapeNewlines is a no-op on production data and makes paragraphs split
// correctly in both worlds.
const paragraphs = unescapeNewlines(announcement.content)
	.split("\n")
	.map((p) => p.trim())
	.filter(Boolean);
const links = announcement.links
	? unescapeNewlines(announcement.links)
			.split("|")
			.map((l) => l.trim())
			.filter(Boolean)
	: [];

// The server wraps bare URLs in <a href='...'>...</a> when saving; render them as
// real links without using set:html (content stays text, only links become anchors).
const contentAnchorPattern = /<a href='([^']+)'>([^<]*)<\/a>/g;
type Segment = { text: string; href?: string };
const toSegments = (line: string): Segment[] => {
	const parts = line.split(contentAnchorPattern); // [text, href, label, text, ...]
	const segments: Segment[] = [];
	for (let i = 0; i < parts.length; i += 3) {
		if (parts[i]) segments.push({ text: parts[i] });
		if (i + 1 < parts.length) segments.push({ href: parts[i + 1], text: parts[i + 2] });
	}
	return segments;
};

// The editor is plain text: consecutive lines starting with a dash ("- Νίκη Κεραμέως…")
// are the secretaries' lists, so they render as one <ul> instead of dashed paragraphs.
const LIST_ITEM = /^[-–•]\s*/;
type Block = { kind: "p"; segments: Segment[] } | { kind: "ul"; items: Segment[][] };
const blocks: Block[] = [];
for (const p of paragraphs) {
	if (LIST_ITEM.test(p)) {
		const item = toSegments(p.replace(LIST_ITEM, ""));
		const last = blocks.at(-1);
		if (last?.kind === "ul") last.items.push(item);
		else blocks.push({ kind: "ul", items: [item] });
	} else {
		blocks.push({ kind: "p", segments: toSegments(p) });
	}
}
// A drop cap only suits a real opening paragraph, not a one-line note or a link.
const leadHasDropCap = blocks[0]?.kind === "p" && !blocks[0].segments[0]?.href && paragraphs[0].length >= 100;

// Photos: a strip right after the lead breaks up the text; the full gallery follows
// the article. Up to 4 photos the strip is the whole gallery, so it isn't repeated.
const photos = announcement.images;
const STRIP_SIZE = 4;
const showStrip = photos.length > 0 && blocks.length > 1;
const showGallery = photos.length > 0 && !(showStrip && photos.length <= STRIP_SIZE);
const stripPhotos = photos.length <= STRIP_SIZE ? photos : photos.slice(0, STRIP_SIZE);
const morePhotos = photos.length - STRIP_SIZE + 1; // shown on the last strip tile ("+N")
const stripAspect = stripPhotos.length === 1 ? "aspect-video" : stripPhotos.length === 2 ? "aspect-4/3" : "aspect-square sm:aspect-4/3";

// Meta description: first ~155 characters of the announcement text.
const announcementDescription = paragraphs
	.join(" ")
	.replace(/<[^>]*>/g, "")
	.slice(0, 155)
	.trim();

// Extract a YouTube video id from an embed link (e.g. "https://www.youtube.com/embed/ZI5ocBAaHEc").
const youtubeId = (link: string) => link.match(/www\.youtube\.com\/embed\/([A-Za-z0-9_-]+)/)?.[1];

// Structured data: Article + BreadcrumbList for this announcement.
const canonicalPath = announcementPath(announcement.title);
const articleSchema = {
	"@context": "https://schema.org",
	"@type": "Article",
	"@id": `${SCHOOL.url}${canonicalPath}#article`,
	headline: announcement.title,
	description: announcementDescription,
	datePublished: new Date(announcement.date).toISOString(),
	image: [`${SCHOOL.url}${imgSrc}${mainImg.name}`],
	author: { "@type": "Organization", "@id": SCHOOL_ID },
	publisher: { "@type": "Organization", "@id": SCHOOL_ID },
	mainEntityOfPage: `${SCHOOL.url}${canonicalPath}`,
	inLanguage: "el-GR",
};
const breadcrumbs = breadcrumbsSchema([
	{ name: "Αρχική", url: "/" },
	{ name: "Ανακοινώσεις", url: "/sxoli/anakoinoseis/" },
	{ name: announcement.title, url: canonicalPath },
]);

// One VideoObject per embedded YouTube video in this announcement.
const videoSchemas = links
	.filter((link) => youtubeId(link))
	.map((embedUrl) => ({
		"@context": "https://schema.org",
		"@type": "VideoObject",
		name: announcement.title,
		description: announcementDescription,
		thumbnailUrl: [`${SCHOOL.url}${imgSrc}${mainImg.name}`],
		uploadDate: new Date(announcement.date).toISOString(),
		embedUrl,
		publisher: { "@type": "Organization", "@id": SCHOOL_ID },
		inLanguage: "el-GR",
	}));

// Older / newer announcement for the footer (the list is newest first). Optional:
// a failure here only hides the links, never the announcement.
const allAnnouncements = await useAPI(API.Announcements.getForPage, undefined, Astro)
	.then((res) => res.data || [])
	.catch(() => []);
const index = allAnnouncements.findIndex((a) => a.id === announcement.id);
const newer = index > 0 ? allAnnouncements[index - 1] : undefined;
const older = index >= 0 ? allAnnouncements[index + 1] : undefined;
const detailHref = (a: { title: string }) => announcementPath(a.title);
const neighbours = [
	older && { a: older, label: "Παλαιότερη", icon: "arrow-left" as const, align: "" },
	newer && { a: newer, label: "Νεότερη", icon: "arrow-right" as const, align: "sm:col-start-2 sm:flex-row-reverse sm:text-right" },
].filter((n) => !!n);
---

<Layout title={announcement.title} description={announcementDescription} imageUrl={imgThumbSrc + mainImg.name}>
	<JsonLd data={articleSchema} />
	<JsonLd data={breadcrumbs} />
	{videoSchemas.map((video) => <JsonLd data={video} key={video.embedUrl} />)}
	<div
		id="readingProgressBar"
		class="pointer-events-none fixed left-0 right-0 z-999 h-0.75"
		role="progressbar"
		aria-label="Πρόοδος ανάγνωσης"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow="0">
		<div
			class="h-full w-full origin-left bg-red-900 shadow-[0_1px_3px_rgba(127,29,29,0.35)] transition-transform duration-75 ease-out will-change-transform">
		</div>
	</div>
	<section
		id="announcementSection"
		data-announcement-id={announcement.id}
		class="relative flex flex-col items-center overflow-auto px-10 py-10 max-sm:px-4 max-sm:py-6 max-sm:pb-24">
		<div class="flex w-full max-w-5xl flex-col items-center gap-y-10 max-sm:gap-y-7">
			<header class="flex w-full flex-col items-center gap-y-5 max-sm:gap-y-4">
				<a
					href="/sxoli/anakoinoseis/"
					class="self-start inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-3 py-1.5 text-lg max-sm:text-sm text-red-900 transition-colors duration-300 hover:bg-red-900 hover:text-red-50 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2">
					<Icon name="arrow-left" />
					Οι Ανακοινώσεις
				</a>

				<h1
					class="max-w-[30ch] text-center text-4xl max-sm:text-2xl leading-tight font-bold text-red-900 font-anaktoria wrap-break-word drop-shadow-[-1px_2px_1px_rgba(0,0,0,0.25)]">
					{announcement.title}
				</h1>

				<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
					<span class="inline-flex items-center gap-1.5 rounded-md bg-red-900 px-2.5 py-1 text-sm max-sm:text-xs text-red-50">
						<Icon name="calendar" />
						<time datetime={new Date(announcement.date).toISOString()}>
							{formatDate(announcement.date)}
						</time>
					</span>
					<span
						class="inline-flex items-center gap-1.5 rounded-md border border-red-900/30 bg-red-900/10 px-2.5 py-1 text-sm max-sm:text-xs text-red-900">
						<Icon name="eye" />
						{`${announcement.views} ${announcement.views === 1 ? "προβολή" : "προβολές"}`}
					</span>
					{
						photos.length > 0 && (
							<a
								href="#announcementPhotos"
								class="photosJump inline-flex items-center gap-1.5 rounded-md border border-red-900/30 bg-red-900/10 px-2.5 py-1 text-sm max-sm:text-xs text-red-900 transition-colors hover:bg-red-900/20">
								<Icon name="images" />
								{photos.length} {photos.length === 1 ? "φωτογραφία" : "φωτογραφίες"}
							</a>
						)
					}
					{
						isRecent(announcement.date) && (
							<span
								class="inline-flex items-center rounded-md bg-ivory-deep/95 px-2.5 py-1 text-sm max-sm:text-xs font-bold text-red-900"
								aria-label="Νέα ανακοίνωση">
								Νέο
							</span>
						)
					}
				</div>
			</header>

			<div class="imgLoader group/img relative w-full max-w-195">
				<div class="hidden group-[:is(.loading)]/img:block absolute inset-0 z-10 grid place-items-center rounded-xl bg-red-50/40 backdrop-blur-[2px]">
					<Spinner />
				</div>
				<div class="w-full overflow-hidden rounded-xl bg-red-900/5 shadow-[0_22px_48px_-22px_rgba(69,10,10,0.55)] ring-1 ring-red-900/10">
					<img
						id="posterImg"
						fetchpriority="high"
						data-src={imgSrc + mainImg.name}
						src={imgSrc + mainImg.name}
						alt={announcement.title}
						width="780"
						height="640"
						class="w-full max-h-[clamp(0px,100vh,640px)] max-sm:max-h-105 object-cover"
					/>
				</div>
			</div>

			{
				blocks.length > 0 && (
					<article class="w-full max-w-3xl rounded-2xl bg-white px-14 pt-12 pb-10 max-md:px-8 max-sm:px-5 max-sm:pt-7 max-sm:pb-6 text-lg max-sm:text-base leading-[1.8] max-sm:leading-relaxed text-ink shadow-[0_18px_50px_-20px_rgba(69,10,10,0.35)] ring-1 ring-red-900/10">
						{blocks.map((block, bi) => (
							<Fragment>
								{block.kind === "p" ? (
									<p
										class:list={[
											"mb-5 last:mb-0",
											bi === 0 && "text-xl max-sm:text-lg leading-[1.7] text-red-950",
											bi === 0 &&
												leadHasDropCap &&
												"first-letter:float-left first-letter:mt-1.5 first-letter:mr-2.5 first-letter:font-anaktoria first-letter:text-[3.6em] first-letter:leading-[0.8] first-letter:font-bold first-letter:text-red-900",
										]}>
										{block.segments.map((s) =>
											s.href ? (
												<a
													href={s.href}
													target="_blank"
													rel="noopener noreferrer"
													class="text-red-800 underline decoration-1 underline-offset-2 hover:text-red-950 wrap-anywhere">
													{s.text}
												</a>
											) : (
												s.text
											),
										)}
									</p>
								) : (
									<ul class="mb-5 last:mb-0 flex flex-col gap-y-1.5">
										{block.items.map((item) => (
											<li class="relative pl-7 before:absolute before:left-1.5 before:top-[0.72em] before:size-1.75 before:rotate-45 before:bg-red-900/80">
												{item.map((s) =>
													s.href ? (
														<a
															href={s.href}
															target="_blank"
															rel="noopener noreferrer"
															class="text-red-800 underline decoration-1 underline-offset-2 hover:text-red-950 wrap-anywhere">
															{s.text}
														</a>
													) : (
														s.text
													),
												)}
											</li>
										))}
									</ul>
								)}
								{bi === 0 && showStrip && (
									<div
										id={showGallery ? undefined : "announcementPhotos"}
										class="photoStrip my-8 max-sm:my-6 grid gap-2 sm:gap-3"
										style={`grid-template-columns: repeat(${stripPhotos.length}, minmax(0, 1fr))`}>
										{stripPhotos.map((image, i) => {
											const isMore = showGallery && i === stripPhotos.length - 1;
											return (
												<button
													type="button"
													data-img-index={isMore ? undefined : i}
													data-more={isMore ? "" : undefined}
													aria-label={
														isMore ? `Όλες οι φωτογραφίες (${photos.length})` : `Προβολή φωτογραφίας ${i + 1} από ${photos.length}`
													}
													class={`imgLoader photoTile group/img relative ${stripAspect} overflow-hidden rounded-lg bg-red-900/8 cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2`}>
													<img
														data-src={imgThumbSrc + image.name}
														alt=""
														class="absolute inset-0 size-full object-cover opacity-0 transition-[opacity,transform] duration-500 group-[.loaded]/img:opacity-100 group-hover/img:scale-105"
													/>
													{isMore && (
														<span class="absolute inset-0 grid place-content-center bg-red-950/60 text-center text-red-50 transition-colors group-hover/img:bg-red-950/50">
															<span class="text-2xl max-sm:text-lg font-bold leading-none">+{morePhotos}</span>
															<span class="mt-1 text-sm max-sm:hidden">φωτογραφίες</span>
														</span>
													)}
												</button>
											);
										})}
									</div>
								)}
							</Fragment>
						))}
					</article>
				)
			}

			{
				links.length > 0 && (
					<div class="flex w-full max-w-4xl flex-col items-center gap-y-5">
						<h2 class="sectionHeading">
							<span>{links.length === 1 ? "Βίντεο" : `Βίντεο (${links.length})`}</span>
						</h2>
						<div class={"grid w-full gap-5 max-sm:gap-4" + (links.length === 1 ? " max-w-195" : " sm:grid-cols-2")}>
							{links.map((link, li) => {
								const ytId = youtubeId(link);
								// An odd count leads with one large video, the rest pair up below it.
								const featured = links.length > 1 && links.length % 2 === 1 && li === 0 ? " sm:col-span-2" : "";
								// YouTube embeds use a click-to-play facade with a real, high-res
								// thumbnail. Loading the player while hidden makes YouTube pick its
								// tiny 120x90 `default.jpg` poster; showing the thumbnail ourselves
								// guarantees sharp quality (up to 1280x720) and defers the heavy
								// player until the user actually wants to watch.
								if (ytId) {
									return (
										<div
											class={
												"videoWrap group/video relative w-full aspect-video overflow-hidden rounded-xl bg-red-950 shadow-[0_16px_36px_-18px_rgba(69,10,10,0.6)]" +
												featured
											}
											data-video-id={ytId}>
											<button
												type="button"
												class="videoPoster absolute inset-0 w-full h-full cursor-pointer"
												data-embed-src={link + (link.includes("?") ? "&" : "?") + "autoplay=1"}
												aria-label="Αναπαραγωγή βίντεο">
												<img
													src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`}
													alt="Προεπισκόπηση βίντεο"
													loading="lazy"
													decoding="async"
													class="w-full h-full object-cover"
												/>
												<span class="absolute inset-0 grid place-items-center bg-black/20 transition-colors duration-300 hover:bg-black/10">
													<span class="grid place-items-center w-16 h-16 max-sm:w-12 max-sm:h-12 rounded-full bg-red-900 text-red-50 text-2xl max-sm:text-xl shadow-lg transition-transform duration-300 group-hover/video:scale-110">
														<Icon name="play" />
													</span>
												</span>
											</button>
											<div class="videoFrame hidden w-full h-full">
												<iframe
													title="Βίντεο ανακοίνωσης"
													class="w-full h-full"
													frameborder="0"
													allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
													referrerpolicy="strict-origin-when-cross-origin"
													allowfullscreen
												/>
											</div>
										</div>
									);
								}
								return (
									<div class={"imgLoader group/img relative w-full aspect-video" + featured}>
										<div class="hidden group-[:is(.loading)]/img:block absolute inset-0 rounded-xl">
											<Spinner />
										</div>
										<div class="hidden group-[:is(.loaded)]/img:block w-full h-full overflow-hidden rounded-xl bg-red-950 shadow-[0_16px_36px_-18px_rgba(69,10,10,0.6)]">
											<iframe
												data-src={link}
												title="Βίντεο ανακοίνωσης"
												class="w-full h-full"
												frameborder="0"
												allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
												referrerpolicy="strict-origin-when-cross-origin"
												allowfullscreen
											/>
										</div>
									</div>
								);
							})}
						</div>
					</div>
				)
			}

			{
				showGallery && (
					<div id="announcementPhotos" class="flex w-full flex-col items-center gap-y-5 scroll-mt-6">
						<h2 class="sectionHeading">
							<span>Φωτογραφίες ({photos.length})</span>
						</h2>
						<div id="imgContainer" class="grid w-full grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 sm:gap-3">
							{photos.map((image, i) => (
								<button
									type="button"
									data-img-index={i}
									aria-label={`Προβολή φωτογραφίας ${i + 1} από ${photos.length}`}
									class:list={[
										"imgLoader photoTile group/img relative overflow-hidden rounded-lg bg-red-900/8 cursor-pointer focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2",
										"aspect-4/3",
										i === 0 && photos.length > 2 && "col-span-2 row-span-2 self-stretch",
									]}>
									<img
										data-src={imgThumbSrc + image.name}
										alt={announcement.title}
										width="400"
										height="320"
										class="absolute inset-0 size-full object-cover opacity-0 transition-[opacity,transform] duration-500 group-[.loaded]/img:opacity-100 group-hover/img:scale-105"
									/>
								</button>
							))}
						</div>
					</div>
				)
			}

			<footer class="flex w-full max-w-4xl flex-col items-center gap-y-6 border-t border-red-900/15 pt-8 max-sm:pt-6">
				{
					neighbours.length > 0 && (
						<nav aria-label="Άλλες ανακοινώσεις" class="grid w-full gap-4 sm:grid-cols-2">
							{neighbours.map((n) => (
								<a
									href={detailHref(n.a)}
									class={`group/nb flex items-center gap-4 rounded-xl bg-white p-3 pr-5 ring-1 ring-red-900/10 shadow-[0_10px_30px_-18px_rgba(69,10,10,0.45)] transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_36px_-16px_rgba(69,10,10,0.5)] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-red-900/70 ${n.align}`}>
									<span class="relative grid size-20 max-sm:size-16 shrink-0 place-items-center overflow-hidden rounded-lg bg-red-900/8">
										{n.a.main_image ? (
											<img
												src={"/anakoinoseis/images/" + n.a.id + "/thumb_" + n.a.main_image}
												alt=""
												width="80"
												height="80"
												loading="lazy"
												decoding="async"
												class="size-full object-cover"
											/>
										) : (
											<Icon name="megaphone" class="text-2xl text-red-900/50" />
										)}
									</span>
									<span class="flex min-w-0 flex-col gap-1">
										<span
											class={
												"inline-flex items-center gap-1.5 text-sm text-red-900/75" + (n.icon === "arrow-right" ? " sm:self-end" : "")
											}>
											{n.icon === "arrow-left" && (
												<Icon name="arrow-left" class="transition-transform duration-300 group-hover/nb:-translate-x-0.5" />
											)}
											{n.label} ανακοίνωση
											{n.icon === "arrow-right" && (
												<Icon name="arrow-right" class="transition-transform duration-300 group-hover/nb:translate-x-0.5" />
											)}
										</span>
										<span class="font-anaktoria text-lg max-sm:text-base font-bold leading-snug text-red-900 line-clamp-2">
											{n.a.title}
										</span>
									</span>
								</a>
							))}
						</nav>
					)
				}
				<a
					href="/sxoli/anakoinoseis/"
					class="inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-4 py-2 text-lg max-sm:text-base text-red-900 transition-colors duration-300 hover:bg-red-900 hover:text-red-50 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-red-900/70 focus-visible:ring-offset-2">
					<Icon name="newspaper" />
					Όλες οι ανακοινώσεις
				</a>
			</footer>
		</div>
	</section>

	<PhotoViewer photos={photos.map((img) => ({ src: imgSrc + img.name }))} title={announcement.title} />

	<style>
		body {
			/* An explicit base colour: with only a gradient the page fades into the browser's canvas, which is dark in a dark-themed browser. */
			background: #fff radial-gradient(circle at 50% -50%, rgb(234 212 212), transparent);
		}
		#announcementSection {
			scroll-behavior: smooth;
		}
		@media (prefers-reduced-motion: reduce) {
			#announcementSection {
				scroll-behavior: auto;
			}
		}
		/* Section title between two hairlines that fade out towards the edges. */
		.sectionHeading {
			display: flex;
			align-items: center;
			gap: 1rem;
			width: 100%;
			font-family: var(--font-anaktoria);
			font-size: 1.625rem;
			font-weight: 700;
			color: var(--color-red-900);
			text-align: center;
		}
		.sectionHeading::before,
		.sectionHeading::after {
			content: "";
			flex: 1;
			height: 1px;
			background: linear-gradient(to right, transparent, rgb(127 29 29 / 0.35));
		}
		.sectionHeading::after {
			background: linear-gradient(to left, transparent, rgb(127 29 29 / 0.35));
		}
		@media (max-width: 639px) {
			.sectionHeading {
				font-size: 1.375rem;
			}
		}
	</style>

	<script>
		import { onElementMount } from "@utilities/dom";

		onElementMount("#announcementSection", async (section) => {
			const loaders = [...section.querySelectorAll(".imgLoader")] as HTMLElement[];

			// ------- Progressive media loading (poster, gallery thumbnails, YouTube embeds) -------
			const runLoader = (loader: HTMLElement) => {
				const img = loader.querySelector<HTMLImageElement>("img[data-src]");
				const frame = loader.querySelector<HTMLIFrameElement>("iframe[data-src]");
				if (!img && !frame) return Promise.resolve();

				loader.classList.add("loading");
				return new Promise<void>((resolve) => {
					let settled = false;
					const settle = () => {
						if (settled) return;
						settled = true;
						loader.classList.remove("loading");
						loader.classList.add("loaded");
						resolve();
					};
					const target = (img || frame) as HTMLImageElement | HTMLIFrameElement;
					target.addEventListener("load", settle, { once: true });
					target.addEventListener("error", settle, { once: true });

					if (img) {
						// Letterbox (don't crop) vertically-oriented poster images.
						const applyPosterAspect = () => {
							if (img.naturalHeight > img.naturalWidth) {
								img.classList.remove("object-cover");
								img.style.setProperty("object-fit", "contain");
							}
						};
						if (img.id === "posterImg") {
							img.addEventListener("load", applyPosterAspect, { once: true });
							if (img.complete && img.naturalWidth > 0) applyPosterAspect();
						}
						// Gallery images start WITHOUT a src (only data-src). Note: an <img>
						// with no src has img.complete === true, so "complete" must not be
						// treated as "already loaded" unless a src was actually set.
						const hasSrc = !!img.getAttribute("src");
						if (!hasSrc) {
							img.src = img.dataset.src as string; // load/error listeners settle
						} else if (img.complete) {
							settle(); // already loaded (or already failed) before this script ran
						}
						// src set but still loading: the listeners above settle it
					} else {
						(frame as HTMLIFrameElement).src = (frame as HTMLIFrameElement).dataset.src as string;
					}
				});
			};

			// Small concurrency pool (max 5), fed by an IntersectionObserver so below-the-fold
			// media (and heavy YouTube embeds) load only when scrolled near + a 6s safety net.
			let queue: (() => Promise<void>)[] = [];
			let running = 0;
			const MAX_RUNNING = 5;
			const pump = () => {
				while (running < MAX_RUNNING && queue.length) {
					running++;
					queue.shift()!().finally(() => {
						running--;
						pump();
					});
				}
			};
			const enqueue = (loader: HTMLElement) => {
				queue.push(() => runLoader(loader));
				pump();
			};

			const obsv = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							obsv.unobserve(entry.target);
							enqueue(entry.target as HTMLElement);
						}
					});
				},
				{ root: null, rootMargin: "300px 0px", threshold: 0.01 },
			);
			loaders.forEach((loader) => obsv.observe(loader));
			setTimeout(() => {
				loaders.forEach((loader) => {
					if (!loader.classList.contains("loaded") && !loader.classList.contains("loading")) {
						obsv.unobserve(loader);
						enqueue(loader);
					}
				});
			}, 6000);

			// ------- Photo clicks (strip + gallery) open the photo viewer -------
			section.querySelectorAll<HTMLElement>("[data-img-index]").forEach((tile) => {
				tile.addEventListener("click", () => {
					document.dispatchEvent(new CustomEvent("photo_viewer_open", { detail: { index: Number(tile.dataset.imgIndex ?? 0) } }));
				});
			});
			// The "+N" strip tile leads to the full gallery below the article.
			section.querySelector("[data-more]")?.addEventListener("click", () => {
				section.querySelector("#announcementPhotos")?.scrollIntoView({ block: "start" });
			});

			// ------- Video facade: high-res thumbnail, click-to-play embed -------
			section.querySelectorAll("[data-video-id] img").forEach((img) => {
				const id = (img.closest("[data-video-id]") as HTMLElement).dataset.videoId;
				// Some videos have no HD thumbnail; fall back to 640x480 and then 480x360.
				const fallbacks = [`https://i.ytimg.com/vi/${id}/sddefault.jpg`, `https://i.ytimg.com/vi/${id}/hqdefault.jpg`];
				let fallbackIdx = 0;
				img.addEventListener("error", () => {
					if (fallbackIdx < fallbacks.length) img.src = fallbacks[fallbackIdx++];
				});
			});
			section.querySelectorAll(".videoPoster").forEach((poster) => {
				poster.addEventListener("click", () => {
					const wrap = poster.closest(".videoWrap") as HTMLElement | null;
					const frame = wrap?.querySelector(".videoFrame") as HTMLElement | null;
					const iframe = frame?.querySelector("iframe") as HTMLIFrameElement | null;
					if (!wrap || !frame || !iframe) return;
					frame.classList.remove("hidden");
					iframe.src = poster.getAttribute("data-embed-src") as string;
					poster.classList.add("hidden");
				});
			});
		});

		// ------- Reading progress bar: thin bar tucked right under the navbar -------
		onElementMount("#announcementSection", (section) => {
			const bar = document.querySelector<HTMLElement>("#readingProgressBar");
			const fill = bar?.querySelector<HTMLElement>("div");
			if (!bar || !fill) return;

			// The fixed navbar has a breakpoint-dependent height (4.2vw on desktop,
			// content-sized on small screens), so measure it and sit below its bottom edge.
			const nav = document.querySelector<HTMLElement>("nav");
			const placeBar = () => {
				if (nav) bar.style.top = `${nav.getBoundingClientRect().height}px`;
			};

			const update = () => {
				// The announcement section is its own scroll container (overflow-auto),
				// but fall back to the document scroller in case the layout ever changes.
				const scroller: Element = section.scrollHeight > section.clientHeight + 1 ? section : (document.scrollingElement ?? document.documentElement);
				const max = scroller.scrollHeight - scroller.clientHeight;
				const progress = max > 0 ? Math.min(1, Math.max(0, scroller.scrollTop / max)) : 0;
				fill.style.transform = `scaleX(${progress})`;
				bar.setAttribute("aria-valuenow", Math.round(progress * 100).toString());
			};

			section.addEventListener("scroll", update, { passive: true });
			window.addEventListener("scroll", update, { passive: true });
			window.addEventListener("resize", () => {
				placeBar();
				update();
			});
			// Fonts can shift the content-sized mobile navbar height; re-measure once loaded.
			window.addEventListener("load", placeBar);
			placeBar();
			update();
		});
	</script>
</Layout>
