---
import JsonLd from "@components/seo/JsonLd.astro";
import Choir from "@components/sxoli/Choir.astro";
import Layout from "@layouts/Layout.astro";
import { breadcrumbsSchema } from "@utilities/schema";
export const prerender = true;
---

<Layout
	title="Χορωδία «Άδοντες & Ψάλλοντες»"
	description="Η χορωδία «Άδοντες & Ψάλλοντες» της Σχολής Βυζαντινής & Παραδοσιακής Μουσικής: ύμνοι, κάλαντα και εκδηλώσεις στη Μητρόπολη Κηφισίας.">
	<JsonLd
		data={breadcrumbsSchema([
			{ name: "Αρχική", url: "/" },
			{ name: "Χορωδία «Άδοντες & Ψάλλοντες»", url: "/sxoli/xorodia" },
		])}
	/>
	<main class="w-full h-max flex flex-col font-didact overflow-hidden px-12 max-sm:px-4">
		<Choir />
	</main>
</Layout>
