---
// One page per teacher (/kathigites/<slug>/): a short professional bio (never the
// whole CV), what and where they teach, and links to the department, the study
// centres and the full CV PDF. The PDF answers with `Link: rel=canonical` to here.
import Icon from "@components/other/Icon.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import Breadcrumbs from "@components/subpages/Breadcrumbs.astro";
import CtaBand from "@components/subpages/CtaBand.astro";
import SubpageShell from "@components/subpages/SubpageShell.astro";
import TeacherChip from "@components/subpages/TeacherChip.astro";
import {
	CLASS_NAME,
	departmentHref,
	classesPhrase,
	formatAddress,
	loadDirectory,
	locationBadge,
	monogram,
	teacherCvHref,
	teacherPicture,
	teacherPictureSrcset,
} from "@components/subpages/directory";
import Layout from "@layouts/Layout.astro";
import { SCHOOL, SCHOOL_ID } from "@utilities/schema";
import { teacherTitleByGender } from "@utilities/text";

export const prerender = false;

const { slug = "" } = Astro.params;
const { teachers, ofType } = await loadDirectory(Astro);
const teacher = teachers.find((t) => t.slug === slug);
if (!teacher) return Astro.rewrite("/404");

const url = `${SCHOOL.url}${teacher.href}`;
const title = teacherTitleByGender(teacher.title, teacher.gender);
const article = teacher.gender === "F" ? "Η" : "Ο";
const bioParagraphs = (teacher.bio ?? "")
	.split(/\n+/)
	.map((p) => p.trim())
	.filter(Boolean);
const departments = teacher.classes.map((c) => ({ type: c, name: CLASS_NAME[c], href: departmentHref(c) }));
const subjects = [...teacher.instruments.map((i) => i.name), ...(teacher.classes.includes("byz") ? ["Βυζαντινή Μουσική"] : [])];

// Fallback text for a teacher without a bio yet: what the register already says.
const fallback =
	`${article} ${teacher.fullname} διδάσκει στη Σχολή ως ${title.toLowerCase()} ${classesPhrase(teacher.classes)}` +
	(teacher.locations.length === 1
		? ", στο σπουδαστήριο που αναφέρεται παρακάτω."
		: teacher.locations.length > 1
			? ", στα σπουδαστήρια που αναφέρονται παρακάτω."
			: ".");
const intro = bioParagraphs[0] ?? fallback;
const description = (() => {
	const text = intro.replace(/\s+/g, " ");
	if (text.length <= 158) return text;
	const cut = text.slice(0, 155);
	return cut.slice(0, cut.lastIndexOf(" ")) + "…";
})();

// Colleagues from the same (first) department, for internal links.
const colleagues = ofType(teacher.classes[0] ?? "byz")
	.filter((t) => t.id !== teacher.id)
	.slice(0, 6);

const imageUrl = teacher.picture ? `/kathigites/picture/${encodeURIComponent(teacher.picture)}` : undefined;
const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": url,
	url,
	name: `${teacher.fullname} – ${teacher.role}`,
	inLanguage: "el",
	mainEntity: {
		"@type": "Person",
		"@id": `${url}#person`,
		name: teacher.fullname,
		jobTitle: teacher.role,
		description: bioParagraphs.join(" ") || fallback,
		url,
		...(imageUrl ? { image: `${SCHOOL.url}${imageUrl}` } : {}),
		worksFor: { "@id": SCHOOL_ID },
		knowsAbout: subjects,
		...(teacher.linktree ? { sameAs: [teacher.linktree] } : {}),
		...(teacher.locations.length ? { workLocation: teacher.locations.map((l) => ({ "@type": "Place", name: l.name, address: formatAddress(l) })) } : {}),
	},
};
const isYoutube = !!teacher.linktree && teacher.linktree.includes("youtube");
const actionBtn =
	"inline-flex items-center justify-center gap-2 rounded-xl border-[1.5px] border-red-900/80 px-4 py-2 text-sm font-semibold text-red-900 transition-colors hover:bg-red-900 hover:text-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900";
---

<Layout title={`${teacher.fullname} – ${teacher.role}`} description={description} imageUrl={imageUrl}>
	<JsonLd data={profileSchema} />
	<SubpageShell>
		<Breadcrumbs
			items={[
				{ name: "Αρχική", url: "/" },
				{ name: "Καθηγητές", url: "/kathigites/" },
				{ name: teacher.fullname, url: teacher.href },
			]}
		/>

		<div class="grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:grid-rows-[auto_1fr]">
			<!-- Όνομα -->
			<header class="flex flex-col gap-y-3 lg:col-start-2 lg:row-start-1">
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-red-900/70">{teacher.role}</p>
				<h1
					class="font-anaktoria font-bold text-[clamp(2.25rem,4vw,3.75rem)] max-sm:text-[2rem] leading-[1.1] text-red-900 text-balance drop-shadow-[-1px_2px_1px_rgba(0,0,0,0.12)]">
					{teacher.fullname}
				</h1>
				<ul class="flex flex-wrap gap-2 pt-1" aria-label="Τμήματα">
					{
						departments.map((d) => (
							<li>
								<a
									href={d.href}
									class="inline-flex items-center gap-1.5 rounded-full bg-red-900 px-3.5 py-1 text-sm font-semibold text-red-50 shadow-sm shadow-red-900/30 transition-colors hover:bg-red-950">
									<Icon name={d.type === "byz" ? "church" : d.type === "par" ? "guitar" : "music"} class="text-ivory-deep" />
									{d.name}
								</a>
							</li>
						))
					}
					{
						teacher.online ? (
							<li class="inline-flex items-center gap-1.5 rounded-full bg-ivory px-3.5 py-1 text-sm font-semibold text-red-900 ring-1 ring-red-900/15">
								<Icon name="globe" /> Και διαδικτυακά μαθήματα
							</li>
						) : null
					}
				</ul>
			</header>

			<!-- Φωτογραφία + ενέργειες -->
			<aside class="lg:col-start-1 lg:row-span-2 lg:row-start-1">
				<div
					class="lg:sticky lg:top-6 overflow-hidden rounded-2xl bg-white ring-1 ring-red-900/10 shadow-[0_18px_50px_-24px_rgba(69,10,10,0.45)] max-lg:grid max-lg:grid-cols-[minmax(0,11rem)_minmax(0,1fr)] max-sm:grid-cols-[minmax(0,8.5rem)_minmax(0,1fr)]">
					<div class="relative aspect-4/5 overflow-hidden bg-red-950">
						{
							teacher.picture ? (
								<img
									src={teacherPicture(teacher.picture, 640)}
									srcset={teacherPictureSrcset(teacher.picture)}
									sizes="(max-width: 639.98px) 136px, (max-width: 1023.98px) 176px, 336px"
									width="336"
									height="420"
									alt={"Φωτογραφία " + teacher.fullname}
									fetchpriority="high"
									class="absolute inset-0 h-full w-full object-cover object-top"
								/>
							) : (
								<span class="absolute inset-0 grid place-items-center bg-linear-to-br from-red-800 via-red-900 to-red-950">
									<span class="font-anaktoria font-bold text-ivory/80 text-7xl max-sm:text-4xl select-none">
										{monogram(teacher.fullname)}
									</span>
								</span>
							)
						}
						<div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-red-950/50 to-transparent"></div>
					</div>
					<div class="flex flex-col gap-y-2.5 p-5 max-sm:p-3 max-sm:gap-y-2 justify-center">
						<a
							href="/eggrafes/"
							class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-900 px-4 py-2.5 text-base max-sm:text-sm font-bold text-red-50 shadow-md shadow-red-900/30 transition-colors hover:bg-red-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900">
							<Icon name="edit" /> Εγγραφή στη Σχολή
						</a>
						{
							teacher.cv && (
								<a href={teacherCvHref(teacher.cv)} target="_blank" rel="noopener" class={actionBtn}>
									<Icon name="file-pdf" /> Πλήρες βιογραφικό
								</a>
							)
						}
						{
							teacher.linktree && (
								<a href={teacher.linktree} target="_blank" rel="noopener" class={actionBtn}>
									<Icon name={isYoutube ? "youtube" : "link"} /> {isYoutube ? "Κανάλι YouTube" : "Πολυμέσα"}
								</a>
							)
						}
					</div>
				</div>
			</aside>

			<!-- Βιογραφικό, μαθήματα, σπουδαστήρια -->
			<div class="flex flex-col gap-y-8 lg:col-start-2 lg:row-start-2 min-w-0">
				<article
					class="rounded-2xl bg-white px-10 py-9 max-md:px-6 max-sm:px-4 max-sm:py-6 shadow-[0_18px_50px_-24px_rgba(69,10,10,0.35)] ring-1 ring-red-900/10">
					<h2 class="sub-heading mb-4">Βιογραφικό σημείωμα</h2>
					<div class="sub-prose">
						{bioParagraphs.length > 0 ? bioParagraphs.map((p) => <p>{p}</p>) : <p>{fallback}</p>}
					</div>
					{
						teacher.cv && (
							<p class="mt-6 border-t border-red-900/10 pt-4 text-sm text-neutral-600">
								Σύντομη παρουσίαση από το βιογραφικό σημείωμα. Το πλήρες κείμενο είναι διαθέσιμο{" "}
								<a
									href={teacherCvHref(teacher.cv)}
									target="_blank"
									rel="noopener"
									class="font-semibold text-red-900 underline decoration-red-900/30 underline-offset-2 hover:decoration-red-900">
									σε μορφή PDF
								</a>
								.
							</p>
						)
					}
				</article>

				{
					subjects.length > 0 && (
						<section aria-labelledby="teaches-title" class="flex flex-col gap-y-4">
							<h2 id="teaches-title" class="sub-heading">
								Διδάσκει
							</h2>
							<ul class="flex flex-wrap gap-2">
								{subjects.map((s) => (
									<li class="rounded-full bg-white px-4 py-1.5 text-base max-sm:text-sm font-medium text-red-900 ring-1 ring-red-900/15 shadow-sm shadow-red-950/5">
										{s}
									</li>
								))}
							</ul>
						</section>
					)
				}

				{
					teacher.locations.length > 0 && (
						<section aria-labelledby="where-title" class="flex flex-col gap-y-4">
							<h2 id="where-title" class="sub-heading">
								Πού διδάσκει
							</h2>
							<ul class="grid gap-3 sm:grid-cols-2">
								{teacher.locations.map((l) => (
									<li>
										<a
											href={l.href}
											class="group/loc flex h-full items-start gap-3 rounded-xl bg-white p-4 ring-1 ring-red-900/10 shadow-sm shadow-red-950/5 transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-red-950/10">
											<span class="grid size-10 shrink-0 place-items-center rounded-lg bg-red-50 text-red-900 ring-1 ring-red-900/10">
												<Icon name={l.partner ? "handshake" : "church"} />
											</span>
											<span class="flex min-w-0 flex-col gap-0.5">
												<span class="text-xs font-semibold uppercase tracking-[0.12em] text-red-900/60">{locationBadge(l)}</span>
												<span class="font-semibold leading-snug text-red-950 [word-break:break-word] group-hover/loc:text-red-900">
													{l.name}
												</span>
												<span class="text-sm text-neutral-600">{formatAddress(l)}</span>
											</span>
											<Icon
												name="chevron-right"
												class="ml-auto mt-3 shrink-0 text-red-900/40 transition-transform group-hover/loc:translate-x-0.5"
											/>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</div>
		</div>

		{
			colleagues.length > 0 && (
				<section aria-labelledby="colleagues-title" class="flex flex-col gap-y-4">
					<div class="flex flex-wrap items-end justify-between gap-3">
						<h2 id="colleagues-title" class="sub-heading">
							Καθηγητές {classesPhrase([teacher.classes[0] ?? "byz"])}
						</h2>
						<a href="/kathigites/" class="inline-flex items-center gap-1.5 font-semibold text-red-900 hover:underline underline-offset-4">
							Όλοι οι καθηγητές <Icon name="arrow-right" />
						</a>
					</div>
					<div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(min(100%,17rem),1fr))]">
						{colleagues.map((t) => (
							<TeacherChip teacher={t} />
						))}
					</div>
				</section>
			)
		}

		<CtaBand
			title={`Μαθήματα ${classesPhrase(teacher.classes)}`}
			text="Η εγγραφή γίνεται ηλεκτρονικά σε λίγα λεπτά. Η γραμματεία της Σχολής θα σας ενημερώσει για τα τμήματα, το πρόγραμμα και το πλησιέστερο σπουδαστήριο."
		/>
	</SubpageShell>
</Layout>
