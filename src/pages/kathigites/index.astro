---
import Icon from "@components/other/Icon.astro";
import type { Instruments } from "@_types/entities";
import JsonLd from "@components/seo/JsonLd.astro";
import { API, useAPI } from "@hooks/useAPI.server";
import Layout from "@layouts/Layout.astro";
import { THUMB_WIDTHS } from "@lib/bucket/publicFiles";
import { breadcrumbsSchema, SCHOOL, SCHOOL_ID } from "@utilities/schema";
import { teacherPath, teacherSlugs } from "@utilities/slug";
import { teacherTitleByGender } from "@utilities/text";

export const prerender = false;

const [byz_teachers_res, par_teachers_res, eur_teachers_res, teacher_locations_res, locations_res, teacher_instruments_res, instruments_res] =
	await Promise.all([
		useAPI(API.Teachers.getByPriorityClasses, { UrlArgs: { class_type: "byz" } }, Astro),
		useAPI(API.Teachers.getByPriorityClasses, { UrlArgs: { class_type: "par" } }, Astro),
		useAPI(API.Teachers.getByPriorityClasses, { UrlArgs: { class_type: "eur" } }, Astro),
		useAPI(API.Teachers.getLocations, undefined, Astro),
		useAPI(API.Locations.get, undefined, Astro),
		useAPI(API.Teachers.getInstruments, undefined, Astro),
		useAPI(API.Instruments.get, undefined, Astro),
	]);

let byz_teachers = byz_teachers_res.data || [],
	par_teachers = par_teachers_res.data || [],
	eur_teachers = eur_teachers_res.data || [],
	teacher_locations = teacher_locations_res.data || [],
	locations = locations_res.data || [],
	teacher_instruments = teacher_instruments_res.data || [],
	instruments = instruments_res.data || [];

const enum MusicType {
	Byzantine = "byz",
	Traditional = "par",
	European = "eur",
	None = "",
}
const teachers = [
	[byz_teachers, MusicType.Byzantine],
	[par_teachers, MusicType.Traditional],
	[eur_teachers, MusicType.European],
] as const;
const teacher_classes = teachers
	.map(([teachersArr, type], index) => {
		return teachersArr
			.map((teacher) => {
				return {
					teacher_id: teacher.id,
					class_id: index,
				};
			})
			.flat();
	})
	.flat();

const music = [
	["Βυζαντινή Μουσική", MusicType.Byzantine],
	["Παραδοσιακή Μουσική", MusicType.Traditional],
	["Ευρωπαϊκή Μουσική", MusicType.European],
] as const;

const musicOnly = [
	["Βυζαντινής", MusicType.Byzantine],
	["Παραδοσιακής", MusicType.Traditional],
	["Ευρωπαϊκής", MusicType.European],
] as const;

// Root-absolute: the page lives at /kathigites/, so a relative "kathigites/…" would resolve to /kathigites/kathigites/….
const imgSrc = "/kathigites/picture/";
const cvSrc = "/kathigites/cv/";
// Resized photo served by the public catch-all (`?w=`, src/pages/[...slug].ts); encoded so srcset stays parseable.
const thumbSrc = (picture: string, width: number) => `${imgSrc}${encodeURIComponent(picture)}?w=${width}`;
const onlineLabel = "Διαδικτυακά Μαθήματα";

// "Βυζαντινής και Παραδοσιακής Μουσικής" (thin spaces, like the original)
const classesStr = (list: string[]) => {
	return list
		.map((str, i) => {
			const len = list.length;
			if (len === 1) return `${str}\u2009Μουσικής`;
			if (len === 2) return `${str}${i === 0 ? "\u2009και\u2009" : "\u2009Μουσικής"}`;
			if (i === len - 1) return `${str}\u2009Μουσικής`;
			if (i === len - 2) return `${str}\u2009και\u2009`;
			return `${str},\u2009`;
		})
		.join("");
};

// Monogram fallback when a teacher has no photo ("Σωτήριος Αλεβιζάκης" -> "ΣΑ")
const monogram = (fullname: string) => {
	const words = fullname.split(/\s+/).filter((w) => /^\p{L}/u.test(w));
	if (!words.length) return "Σ";
	return words[0][0] + (words.length > 1 ? words[words.length - 1][0] : "");
};

// Structured data: one ItemList of Person entries (deduplicated by teacher id,
// a teacher may teach in more than one department).
const schemaTeachers = [...new Map([...byz_teachers, ...par_teachers, ...eur_teachers].map((t) => [t.id, t])).values()];
// Each teacher's own page (/kathigites/<slug>/), same slugs as the page route and the sitemap.
const slugs = teacherSlugs(schemaTeachers);
const profileHref = (id: number) => teacherPath(slugs.get(id)!);
const teachersSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"@id": `${SCHOOL.url}/kathigites/#teachers`,
	name: "Καθηγητές και δάσκαλοι της Σχολής",
	itemListElement: schemaTeachers.map((teacher, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "Person",
			name: teacher.fullname,
			url: `${SCHOOL.url}${profileHref(teacher.id)}`,
			jobTitle: teacherTitleByGender(teacher.title, teacher.gender),
			...(teacher.linktree ? { sameAs: [teacher.linktree] } : {}),
			...(teacher.picture ? { image: `${SCHOOL.url}${imgSrc}${teacher.picture}` } : {}),
			worksFor: { "@id": SCHOOL_ID },
		},
	})),
};
const breadcrumbs = breadcrumbsSchema([
	{ name: "Αρχική", url: "/" },
	{ name: "Καθηγητές", url: "/kathigites/" },
]);
// Accent-insensitive search text for the client-side filter ("Βυζαντινή" matches "βυζαντινη").
const searchKey = (...parts: string[]) => parts.join(" ").normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
const counts = { byz: byz_teachers.length, par: par_teachers.length, eur: eur_teachers.length } as Record<string, number>;
---

<Layout
	title="Καθηγητές"
	description="Γνωρίστε τους καθηγητές και δασκάλους της Σχολής: βυζαντινή, παραδοσιακή και ευρωπαϊκή μουσική, μουσικά όργανα, βιογραφικά και στοιχεία επικοινωνίας.">
	<JsonLd data={teachersSchema} />
	<JsonLd data={breadcrumbs} />
	<main id="teachersPage" class="group/type byz w-full h-full overflow-y-auto font-didact bg-[#fbf6f2]">
		<div class="mx-auto w-full max-w-400 flex flex-col gap-y-6 px-10 pt-8 pb-24 max-lg:px-6 max-sm:px-3 max-sm:pt-4 max-sm:gap-y-4">
			<!-- Εισαγωγή -->
			<header class="relative shrink-0 overflow-hidden rounded-2xl border-2 border-red-900 bg-red-950 shadow-xl shadow-red-900/30 max-sm:rounded-xl">
				<img src="/church_low.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-25 blur-[2px]" />
				<div class="relative flex flex-col items-center gap-y-3 px-6 py-9 text-center max-sm:px-4 max-sm:py-6">
					<p
						class="rounded-full border border-ivory/35 bg-black/30 px-4 py-1 text-sm max-sm:text-xs font-semibold tracking-wide text-ivory backdrop-blur-[2px]">
						Το διδακτικό προσωπικό της Σχολής
					</p>
					<h1
						id="teachersHead"
						class="font-anaktoria font-bold text-[clamp(2rem,3.4vw,3.75rem)] leading-tight text-red-50 drop-shadow-[-1px_2px_1px_rgba(0,0,0,0.35)]">
						Καθηγητές Βυζαντινής Μουσικής
					</h1>
					<p class="max-w-[62ch] text-lg max-sm:hidden leading-relaxed text-red-50/90 drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.4)]">
						Γνωρίστε τους δασκάλους που διδάσκουν στη Σχολή και στα σπουδαστήριά της: τα μαθήματα και τα όργανα του καθενός, τα σπουδαστήρια όπου
						διδάσκουν, το βιογραφικό και το έργο τους.
					</p>
				</div>
			</header>

			<!-- Κατηγορίες + αναζήτηση: μένουν στην κορυφή όσο κυλά η λίστα -->
			<div
				id="teachersToolbar"
				class="sticky top-0 z-20 -mx-2 px-2 py-3 flex flex-wrap items-center justify-between gap-3 bg-[#fbf6f2]/90 backdrop-blur-md max-sm:py-2">
				<div id="btsContainer" class="max-sm:w-full">
					<div
						role="tablist"
						aria-label="Κατηγορίες μαθημάτων"
						class="flex items-center gap-1 rounded-full bg-red-900 p-1 shadow-md shadow-red-900/25 max-sm:w-full">
						{
							music.map(([str, type], ind) => (
								<div
									role="presentation"
									data-show={ind === 0 ? "true" : undefined}
									data-type={type}
									class="group/btn relative min-w-0 max-sm:flex-1">
									<button
										type="button"
										role="tab"
										id={"tab-" + type}
										aria-controls="teachersContainer"
										aria-selected={ind === 0 ? "true" : "false"}
										tabindex={ind === 0 ? 0 : -1}
										class="flex items-center justify-center gap-2 w-full rounded-full px-[clamp(0.875rem,1.1vw,1.375rem)] py-2 max-sm:px-2 max-sm:py-1.5 text-[clamp(0.9375rem,1vw,1.125rem)] max-sm:text-sm font-medium text-red-50 whitespace-nowrap transition-colors duration-300 ease-in-out hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ivory group-data-[show=true]/btn:bg-ivory group-data-[show=true]/btn:text-red-900 group-data-[show=true]/btn:font-semibold group-data-[show=true]/btn:shadow-sm"
										data-type={type}>
										<span class="max-xs:hidden">{str}</span>
										<span class="hidden max-xs:inline">{str.replace(" Μουσική", "")}</span>
										<span class="rounded-full bg-black/20 px-1.5 text-xs font-semibold tabular-nums group-data-[show=true]/btn:bg-red-900/10 max-xs:hidden">
											{counts[type]}
										</span>
									</button>
								</div>
							))
						}
					</div>
				</div>
				<label class="relative w-[clamp(16rem,24vw,22rem)] max-sm:w-full">
					<span class="sr-only">Αναζήτηση καθηγητή</span>
					<Icon name="search" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-red-900/60" />
					<input
						id="teachersSearch"
						type="search"
						autocomplete="off"
						placeholder="Όνομα, όργανο ή σπουδαστήριο"
						class="w-full rounded-full border border-red-900/20 bg-white py-2 pl-10 pr-4 text-base text-red-950 shadow-sm placeholder:text-neutral-400 outline-hidden transition-shadow focus:border-red-900/50 focus:ring-4 focus:ring-red-900/10"
					/>
				</label>
			</div>

			<div
				id="teachersContainer"
				role="tabpanel"
				aria-labelledby="tab-byz"
				tabindex="0"
				class="rounded-2xl outline-offset-4 focus-visible:outline-2 focus-visible:outline-red-900 grid grid-cols-[repeat(auto-fill,minmax(min(100%,16.5rem),1fr))] gap-6 max-sm:grid-cols-2 max-sm:gap-3 max-2xs:grid-cols-1">
				{
					teachers.map(([teachersByType, type]) => {
						return teachersByType.map((teacher, position) => {
							const t_classes_str = teacher_classes.filter((c) => c.teacher_id === teacher.id).map((c) => musicOnly[c.class_id][0]);
							const t_locations = teacher_locations
								.filter((l) => l.teacher_id === teacher.id)
								.map((l) => locations.find((loc) => loc.id === l.location_id)?.name || "")
								.filter((name: string) => name !== "");
							const t_instrument_list = teacher_instruments
								.filter((i) => i.teacher_id === teacher.id)
								?.map((i) => instruments.find((inst) => inst.id === i.instrument_id) as Instruments);
							const t_instruments = t_instrument_list.map((i) => i.name);
							// Byzantine music is a department, not an instrument row: show it as a tag for everyone who teaches it.
							if (t_classes_str.includes("Βυζαντινής") && !t_instruments.includes("Βυζαντινή Μουσική")) t_instruments.push("Βυζαντινή Μουσική");
							t_instruments?.sort();
							const showCls =
								(type === MusicType.Byzantine ? " group-[:is(.byz)]/type:flex" : "") +
								(type === MusicType.Traditional ? " group-[:is(.par)]/type:flex" : "") +
								(type === MusicType.European ? " group-[:is(.eur)]/type:flex" : "");
							const isYoutube = !!teacher.linktree && teacher.linktree.includes("youtube");
							return (
								<article
									data-type={type}
									data-search={searchKey(teacher.fullname, ...t_instruments, ...t_locations)}
									style={`--i: ${Math.min(position, 12)}`}
									class={
										"teacher-card group/card hidden flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-red-900/10 shadow-sm shadow-red-950/5" +
										showCls +
										" transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-red-950/15 data-filtered:hidden! max-sm:rounded-xl"
									}>
									<div class="relative aspect-4/5 overflow-hidden bg-red-950">
										{teacher.picture ? (
											<img
												src={thumbSrc(teacher.picture, 480)}
												srcset={THUMB_WIDTHS.map((w) => `${thumbSrc(teacher.picture!, w)} ${w}w`).join(", ")}
												sizes="(max-width: 359.98px) 100vw, (max-width: 639.98px) 50vw, 380px"
												width={240}
												height={300}
												alt={"Φωτογραφία Καθηγητή " + teacher.fullname}
												loading={position < 4 && type === MusicType.Byzantine ? "eager" : "lazy"}
												decoding="async"
												class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover/card:scale-[1.04]"
											/>
										) : (
											<span class="absolute inset-0 grid place-items-center bg-linear-to-br from-red-800 via-red-900 to-red-950">
												<span class="font-anaktoria font-bold text-ivory/80 text-6xl max-sm:text-4xl select-none">
													{monogram(teacher.fullname)}
												</span>
											</span>
										)}
										<div class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-red-950/95 via-red-950/45 to-transparent" />
										{teacher.online ? (
											<span class="absolute right-2.5 top-2.5 inline-flex items-center gap-1 rounded-full bg-ivory/95 px-2.5 py-0.5 text-xs font-semibold text-red-900 shadow-sm max-sm:text-2xs max-sm:px-2">
												<Icon name="globe" class="text-[0.85em]" /> {onlineLabel}
											</span>
										) : null}
										<div class="absolute inset-x-0 bottom-0 px-4 pb-3.5 max-sm:px-2.5 max-sm:pb-2.5">
											<h2 class="font-anaktoria font-bold text-[1.4rem] max-sm:text-base leading-tight text-red-50 [word-break:break-word] drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)]">
												{/* Stretched over the photo: the whole picture opens the teacher's page. */}
												<a
													href={profileHref(teacher.id)}
													class="text-red-50 decoration-ivory/70 underline-offset-4 after:absolute after:inset-0 hover:underline focus-visible:outline-hidden focus-visible:after:outline-2 focus-visible:after:-outline-offset-4 focus-visible:after:outline-ivory">
													{teacher.fullname}
												</a>
											</h2>
											<p class="mt-0.5 text-sm max-sm:text-2xs leading-snug text-ivory/90">
												{teacherTitleByGender(teacher.title, teacher.gender)} {classesStr(t_classes_str)}
											</p>
										</div>
									</div>
									<div class="flex flex-1 flex-col gap-y-3 p-4 max-sm:p-2.5 max-sm:gap-y-2">
										{t_locations.length > 0 && (
											<ul class="flex flex-col gap-y-1 text-sm max-sm:text-xs text-neutral-600">
												{t_locations.map((str) => (
													<li class="flex items-start gap-x-1.5 [word-break:break-word]">
														<Icon name="map-pin" class="mt-0.5 text-red-900/70 text-[0.9em]" />
														{str}
													</li>
												))}
											</ul>
										)}
										{t_instruments && t_instruments.length > 0 && (
											<ul class="flex flex-wrap gap-1.5 max-sm:gap-1" aria-label="Διδάσκει">
												{t_instruments.map((instr) => (
													<li class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs max-sm:text-2xs font-medium text-red-900 ring-1 ring-red-900/10">
														{instr}
													</li>
												))}
											</ul>
										)}
										{
											<div class="mt-auto flex flex-wrap gap-2 pt-1 max-sm:gap-1.5">
												<a href={profileHref(teacher.id)} class="teacher-link">
													<Icon name="user" /> Προφίλ
												</a>
												{teacher.cv ? (
													<a target="_blank" rel="noopener" href={cvSrc + teacher.cv} class="teacher-link">
														<Icon name="file-text" /> Βιογραφικό
													</a>
												) : null}
												{teacher.linktree ? (
													<a target="_blank" rel="noopener" href={teacher.linktree} class="teacher-link">
														<Icon name={isYoutube ? "youtube" : "link"} /> {isYoutube ? "YouTube" : "Πολυμέσα"}
													</a>
												) : null}
											</div>
										}
									</div>
								</article>
							);
						});
					})
				}
			</div>
			<p id="teachersEmpty" hidden class="py-16 text-center text-lg text-neutral-500">Δεν βρέθηκε καθηγητής με αυτά τα στοιχεία σε αυτή την κατηγορία.</p>
		</div>
	</main>
	<style is:inline>
		.teacher-card {
			animation: teacherIn 0.45s ease-out both;
			animation-delay: calc(var(--i, 0) * 45ms);
		}
		@keyframes teacherIn {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
		.teacher-link {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			border-radius: 0.625rem;
			border: 1.5px solid rgb(127 29 29 / 0.8);
			padding: 0.3rem 0.75rem;
			font-size: 0.875rem;
			font-weight: 600;
			color: #7f1d1d;
			transition:
				background-color 0.2s,
				color 0.2s;
		}
		.teacher-link:hover,
		.teacher-link:focus-visible {
			background: #7f1d1d;
			color: #fef2f2;
		}
		@media (max-width: 639.98px) {
			.teacher-link {
				font-size: 0.75rem;
				padding: 0.2rem 0.5rem;
			}
		}
		#teachersContainer.switching {
			opacity: 0;
			transition: opacity 0.2s ease-in;
		}
		@media (prefers-reduced-motion: reduce) {
			.teacher-card {
				animation: none;
			}
		}
	</style>
</Layout>
<script>
	const page = document.querySelector("#teachersPage") as HTMLElement;
	const container = document.querySelector("#teachersContainer") as HTMLElement;
	const search = document.querySelector("#teachersSearch") as HTMLInputElement;
	const empty = document.querySelector("#teachersEmpty") as HTMLElement;
	const head = document.querySelector("#teachersHead") as HTMLElement;
	const headTitles: Record<string, string> = {
		byz: "Καθηγητές Βυζαντινής Μουσικής",
		par: "Καθηγητές Παραδοσιακής Μουσικής",
		eur: "Καθηγητές Ευρωπαϊκής Μουσικής",
	};
	const hashes: Record<string, string> = { byz: "Βυζαντινή Μουσική", par: "Παραδοσιακή Μουσική", eur: "Ευρωπαϊκή Μουσική" };
	type MusicType = "byz" | "par" | "eur";
	const tabs = [...document.querySelectorAll<HTMLButtonElement>("#btsContainer [role=tab]")];
	// The selected category: set at once on a click/key, while the page itself switches after the fade-out.
	let selected: MusicType = (["byz", "par", "eur"] as const).find((t) => page.classList.contains(t)) ?? "byz";
	let switchTimer: ReturnType<typeof setTimeout> | undefined;

	const normalize = (str: string) => str.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase().trim();

	// Hides the cards that do not match the search, inside the active category only.
	function applyFilter() {
		const query = normalize(search.value);
		let visible = 0;
		container.querySelectorAll<HTMLElement>(".teacher-card").forEach((card) => {
			const match = !query || (card.dataset.search ?? "").includes(query);
			card.toggleAttribute("data-filtered", !match);
			if (match && card.dataset.type === selected) visible++;
		});
		empty.hidden = visible > 0;
	}

	function selectType(type: MusicType, { updateHash = true } = {}) {
		if (type === selected) return;
		selected = type;
		// Tab state (roving tabindex) follows immediately; the look switches with the panel.
		tabs.forEach((tab) => {
			const active = tab.dataset.type === type;
			tab.setAttribute("aria-selected", String(active));
			tab.tabIndex = active ? 0 : -1;
		});
		container.setAttribute("aria-labelledby", "tab-" + type);
		container.classList.add("switching");
		clearTimeout(switchTimer);
		switchTimer = setTimeout(() => {
			document.querySelectorAll<HTMLElement>("#btsContainer [role=presentation][data-type]").forEach((wrapper) => {
				if (wrapper.dataset.type === type) wrapper.setAttribute("data-show", "true");
				else wrapper.removeAttribute("data-show");
			});
			page.classList.remove("byz", "par", "eur");
			page.classList.add(type);
			head.textContent = headTitles[type];
			container.classList.remove("switching");
			applyFilter();
			if (updateHash) history.replaceState(null, "", "#" + hashes[type]);
			const toolbar = document.querySelector("#teachersToolbar") as HTMLElement;
			if (page.scrollTop > toolbar.offsetTop) page.scrollTo({ top: toolbar.offsetTop, behavior: "smooth" });
		}, 200);
	}

	tabs.forEach((tab, index) => {
		tab.addEventListener("click", () => selectType(tab.dataset.type as MusicType));
		// ←/→ move between the tabs (wrapping), Home/End jump to the first/last; the focused tab is selected.
		tab.addEventListener("keydown", (e) => {
			const last = tabs.length - 1;
			const next =
				e.key === "ArrowRight"
					? index === last
						? 0
						: index + 1
					: e.key === "ArrowLeft"
						? index === 0
							? last
							: index - 1
						: e.key === "Home"
							? 0
							: e.key === "End"
								? last
								: null;
			if (next === null) return;
			e.preventDefault();
			tabs[next].focus();
			selectType(tabs[next].dataset.type as MusicType);
		});
	});
	search.addEventListener("input", applyFilter);

	if (window.location.hash) {
		const type = decodeURI(window.location.hash.slice(1));
		const match = Object.entries(hashes).find(([, label]) => label === type);
		if (match) selectType(match[0] as MusicType, { updateHash: false });
	}
</script>
