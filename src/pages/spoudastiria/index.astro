---
import JsonLd from "@components/seo/JsonLd.astro";
import { useAPI, API } from "@hooks/useAPI.astro";
import Layout from "@layouts/Layout.astro";
import { breadcrumbsSchema, SCHOOL, SCHOOL_ID } from "@utilities/schema";
import type { Locations, TeacherLocations } from "@_types/entities";

export const prerender = false;

let _locations: Locations[] = [];
try {
	const res = await useAPI(API.Locations.getByPriority, undefined, Astro);
	_locations = res?.data || [];
} catch (error) {
	console.error("Σελίδα Σπουδαστήρια: αποτυχία φόρτωσης σπουδαστηρίων.", error);
}

// Πόσοι καθηγητές διδάσκουν σε κάθε σπουδαστήριο (σχέσεις καθηγητού-σημείου).
let teacher_places: TeacherLocations[] = [];
try {
	const res = await useAPI(API.Teachers.getLocations, undefined, Astro);
	teacher_places = res?.data || [];
} catch (error) {
	console.error("Σελίδα Σπουδαστήρια: αποτυχία φόρτωσης σχέσεων καθηγητών-σπουδαστηρίων.", error);
}
type LocationWithTeachers = Locations & { teacherCount: number };
const locationsWithTeachers: LocationWithTeachers[] = _locations.map((l) => ({
	...l,
	teacherCount: teacher_places.filter((tl) => tl.location_id === l.id).length,
}));
// Μικρή ένδειξη πλήθους καθηγητών, π.χ. «Διδάσκουν 12 καθηγητές».
const teachersLabel = (n: number) => (n === 1 ? "Διδάσκει 1 καθηγητής" : `Διδάσκουν ${n} καθηγητές`);

const imgSrc = "/spoudastiria/";
const schoolLocations = _locations.filter((l) => !l.partner);
const otherLocations = _locations.filter((l) => !!l.partner);
const groups = [
	{
		id: "school",
		label: "Σπουδαστήρια Σχολής",
		icon: "fa-solid fa-church",
		locations: schoolLocations,
	},
	{
		id: "partner",
		label: "Συνεργαζόμενες Σχολές",
		icon: "fa-solid fa-handshake",
		locations: otherLocations,
	},
] as const;

const formatAddress = (l: Locations) => `${l.address.trim()}, ${l.areacode > 0 ? `${l.areacode} – ` : ""}${l.municipality.trim()}`;
const phones = (l: Locations) =>
	l.telephones
		.split(",")
		.map((t) => t.trim())
		.filter(Boolean);
const hasValidMap = (l: Locations) => l.map?.startsWith("http") && l.map.length > 50;
// Ετικέτα του σημείου διεξαγωγής: η έδρα εμφανίζεται ως «Έδρα Σχολής»,
// ενώ τα υπόλοιπα διακρίνονται σε σπουδαστήρια και συνεργαζόμενες σχολές.
const badgeLabel = (l: Locations) => (l.priority === 1 ? "Έδρα Σχολής" : l.partner ? "Συνεργαζόμενη Σχολή" : "Σπουδαστήριο Σχολής");
const directionsHref = (l: Locations) =>
	`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
		`${l.address.trim()}, ${l.areacode > 0 ? `${l.areacode} ` : ""}${l.municipality.trim()}`,
	)}`;

// Structured data: ItemList of Place entries (address, phones, map) — one per σπουδαστήριο.
const placesSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"@id": `${SCHOOL.url}/spoudastiria#locations`,
	name: "Σπουδαστήρια και συνεργαζόμενες σχολές",
	itemListElement: _locations.map((l, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "Place",
			name: l.name,
			address: {
				"@type": "PostalAddress",
				streetAddress: l.address.trim(),
				...(l.areacode > 0 ? { postalCode: String(l.areacode) } : {}),
				addressLocality: l.municipality.trim(),
				addressCountry: "GR",
			},
			...(phones(l).length > 0 ? { telephone: phones(l) } : {}),
			...(hasValidMap(l) ? { hasMap: l.map } : {}),
		},
	})),
};
---

<Layout
	title="Σπουδαστήρια"
	description="Τα σπουδαστήρια και τα παραρτήματα της Σχολής Βυζαντινής & Παραδοσιακής Μουσικής της Ι. Μητρόπολης Κηφισίας: διευθύνσεις, τηλέφωνα, στοιχεία επικοινωνίας και χάρτες.">
	<JsonLd
		data={breadcrumbsSchema([
			{ name: "Αρχική", url: "/" },
			{ name: "Σπουδαστήρια", url: "/spoudastiria" },
		])}
	/>
	<JsonLd data={placesSchema} />

	<div id="spoudastiriaPage" class="group/page w-full h-full font-didact">
		<main id="spoudastiriaMain" class="w-full h-full overflow-y-auto flex flex-col gap-y-8 px-10 py-8 max-sm:px-4 max-sm:py-6 max-sm:pb-28">
			<!-- Εισαγωγή -->
			<header
				class="relative shrink-0 flex flex-col items-center gap-y-5 overflow-hidden rounded-2xl border-2 border-red-900 bg-red-950 shadow-xl shadow-red-900/30">
				<img
					src="/church_low.jpg"
					alt="Ο Ι. Ναός Μεταμορφώσεως του Σωτήρος στη Μεταμόρφωση"
					class="absolute inset-0 h-full w-full object-cover opacity-30 blur-[2px]"
				/>
				<div class="relative flex flex-col items-center gap-y-4 px-6 py-10 max-sm:px-4 max-sm:py-8">
					<h1
						class="heading relative p-2 text-center text-[3.5vw] max-sm:text-4xl leading-[3.5vw] font-bold font-anaktoria text-red-50 overflow-hidden after:left-[calc(50%_-_6ch)] after:w-[12ch] after:bg-amber-400 after:max-sm:rounded-sm after:max-sm:h-[2px] drop-shadow-[-1px_2px_1px_rgba(0,0,0,0.35)]">
						Σπουδαστήρια
					</h1>
					<p
						class="rounded-full border border-amber-400/40 bg-black/30 px-4 py-1.5 text-base max-sm:text-sm font-semibold tracking-wide text-amber-300 backdrop-blur-[2px]">
						Σχολή Βυζαντινής & Παραδοσιακής Μουσικής — Ι.Ν. Μεταμορφώσεως του Σωτήρος
					</p>
					<p class="max-w-[68ch] text-center text-lg max-sm:text-base leading-relaxed text-red-50 drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.4)]">
						Τα μαθήματα διεξάγονται στην έδρα της Σχολής, σε σπουδαστήρια και σε συνεργαζόμενες σχολές σε πολλές περιοχές της Αττικής. Επιλέξτε το
						σημείο που σας ενδιαφέρει για διεύθυνση, τηλέφωνα και χάρτη.
					</p>
				</div>
			</header>

			<!-- Κατηγορίες -->
			<nav id="spoudastiriaTabs" class="sticky top-2 z-40 flex justify-center" aria-label="Κατηγορίες σπουδαστηρίων">
				<div
					class="flex flex-wrap justify-center gap-1.5 rounded-full bg-red-900/95 backdrop-blur-md px-2 py-2 shadow-[0_12px_32px_-8px_rgba(127,29,29,0.65)] max-sm:rounded-2xl">
					{
						groups.map((g, ind) => (
							<button
								type="button"
								data-group={g.id}
								data-show={ind === 0}
								aria-pressed={ind === 0 ? "true" : "false"}
								class="group/btn relative flex items-center gap-2 rounded-full px-[1.1vw] py-[0.5vw] max-sm:px-4 max-sm:py-2 text-[1.05vw] max-sm:text-sm font-medium text-red-50 whitespace-nowrap transition-colors duration-300 ease-in-out hover:bg-red-800 hover:text-white group-data-[show=true]/btn:bg-amber-400 group-data-[show=true]/btn:text-red-950 group-data-[show=true]/btn:font-semibold group-data-[show=true]/btn:shadow-md">
								<i class={g.icon + " text-[0.9em] max-sm:hidden"} aria-hidden="true" />
								{g.label}
							</button>
						))
					}
				</div>
			</nav>

			<!-- Λίστα σπουδαστηρίων -->
			<section id="spoudastiriaGrid" class="w-full grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 content-start max-w-[1400px] self-center">
				{
					locationsWithTeachers.map((l) => (
						<article
							data-name={l.name}
							data-group={l.partner ? "partner" : "school"}
							class:list={[
								"location-card group/card relative flex flex-col overflow-hidden rounded-2xl border-2 border-red-900 bg-white shadow-md shadow-gray-400/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-500/50",
								l.partner ? "hidden" : "",
							]}>
							<div class="relative shrink-0 aspect-[16/9] overflow-hidden bg-[linear-gradient(135deg,#7f1d1d_0%,#450a0a_55%,#2b0606_100%)]">
								{l.image && (
									<img
										src={imgSrc + l.image}
										alt={"Φωτογραφία " + l.name}
										loading="lazy"
										decoding="async"
										class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover/card:scale-105"
									/>
								)}
								<div
									class={
										"absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent" +
										(l.image ? "" : " grid place-items-center")
									}>
									{!l.image && <i class="fa-solid fa-church text-5xl text-red-50/60" />}
								</div>
								<span class="absolute left-3 top-3 rounded-full border border-amber-400/50 bg-red-950/80 px-3 py-1 text-xs font-semibold text-amber-300 backdrop-blur-sm">
									{badgeLabel(l)}
								</span>
							</div>
							<div class="flex flex-1 flex-col gap-y-3 p-5 max-sm:p-4">
								<h3 class="font-anaktoria font-bold text-xl max-sm:text-lg leading-snug text-red-900 [word-break:break-word]">{l.name}</h3>
								<p class="text-base max-sm:text-sm leading-relaxed">
									<i class="fa-solid fa-location-dot pr-2 text-red-900/70" />
									{formatAddress(l)}
								</p>
								<p class="text-base max-sm:text-sm">
									<i class="fa-solid fa-user pr-2.5 text-red-900/70" />
									{l.manager}
								</p>
								{l.teacherCount > 0 && (
									<p class="text-base max-sm:text-sm">
										<i class="fa-solid fa-chalkboard-user pr-2 text-red-900/70" />
										{teachersLabel(l.teacherCount)}
									</p>
								)}
								{phones(l).length > 0 && (
									<div class="flex flex-wrap gap-2">
										{phones(l).map((phone) => (
											<a
												href={`tel:${phone}`}
												class="inline-flex items-center gap-1.5 rounded-full bg-red-900 px-3 py-1 text-sm max-sm:text-xs font-medium text-red-50 transition-colors duration-200 hover:bg-red-800">
												<i class="fa-solid fa-phone text-[0.8em]" />
												{phone}
											</a>
										))}
									</div>
								)}
								{l.email && (
									<a
										href={`mailto:${l.email}`}
										class="inline-flex w-max items-center gap-2 text-base max-sm:text-sm text-red-900 underline decoration-red-900/50 decoration-1 underline-offset-4 transition-colors hover:text-red-700">
										<i class="fa-regular fa-envelope" />
										{l.email}
									</a>
								)}
								<div class="mt-auto flex flex-row flex-wrap gap-2 pt-2">
									<button
										type="button"
										data-open-location={l.id}
										class="inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-3.5 py-1.5 text-sm max-sm:text-xs font-semibold text-red-900 transition-colors duration-200 hover:bg-red-900 hover:text-red-50">
										<i class="fa-solid fa-map-location-dot" />
										Χάρτης & λεπτομέρειες
									</button>
									<a
										target="_blank"
										rel="noopener"
										href={directionsHref(l)}
										class="inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-3.5 py-1.5 text-sm max-sm:text-xs font-semibold text-red-900 transition-colors duration-200 hover:bg-red-900 hover:text-red-50">
										<i class="fa-solid fa-diamond-turn-right" />
										Οδηγίες
									</a>
								</div>
							</div>
						</article>
					))
				}
			</section>

			<!-- Τελικό κάλεσμα -->
			<section
				class="relative shrink-0 flex flex-col items-center gap-y-5 overflow-hidden rounded-2xl border border-amber-400/40 bg-[linear-gradient(135deg,#7f1d1d_0%,#450a0a_55%,#2b0606_100%)] px-8 py-10 shadow-xl shadow-red-900/30 max-sm:px-4">
				<h2 class="text-center text-[2.25vw] max-sm:text-2xl font-bold font-anaktoria text-red-50 drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.3)]">
					Αναζητάτε το πλησιέστερο σπουδαστήριο;
				</h2>
				<p class="max-w-[60ch] text-center text-lg max-sm:text-base leading-relaxed text-red-100/90">
					Η γραμματεία της Σχολής θα σας κατευθύνει στο πλησιέστερο σε εσάς σημείο διεξαγωγής μαθημάτων και θα απαντήσει σε κάθε ερώτηση για το
					πρόγραμμα και τις εγγραφές.
				</p>
				<div class="flex flex-row flex-wrap justify-center gap-4 pt-1">
					<a
						href="/epikoinonia"
						class="inline-flex items-center gap-2.5 rounded-full border-2 border-amber-400/70 bg-red-950/60 px-6 py-2.5 text-lg max-sm:text-base font-bold text-red-50 shadow-md shadow-red-950/40 transition-all duration-300 hover:-translate-y-0.5 hover:border-amber-300 hover:bg-amber-400 hover:text-red-950 hover:shadow-xl">
						<i class="fa-solid fa-phone text-amber-400"></i>
						Επικοινωνία
					</a>
					<a
						href="/eggrafes"
						class="inline-flex items-center gap-2.5 rounded-full border-2 border-amber-400/70 bg-red-950/60 px-6 py-2.5 text-lg max-sm:text-base font-bold text-red-50 shadow-md shadow-red-950/40 transition-all duration-300 hover:-translate-y-0.5 hover:border-amber-300 hover:bg-amber-400 hover:text-red-950 hover:shadow-xl">
						<i class="fa-solid fa-pen-to-square text-amber-400"></i>
						Εγγραφές
					</a>
				</div>
			</section>
		</main>

		<!-- Αναδυόμενο παράθυρο λεπτομερειών -->
		<div id="locationModal" class="hidden fixed inset-0 z-[1100] grid place-items-center p-4 max-sm:p-0" role="presentation">
			<div id="locationModalBackdrop" class="absolute inset-0 bg-black/60 backdrop-blur-[3px]"></div>
			<div
				role="dialog"
				aria-modal="true"
				aria-labelledby="locationModalTitle"
				id="locationModalPanel"
				class="relative w-full max-w-3xl flex flex-col overflow-hidden rounded-2xl border-2 border-red-900 bg-white shadow-2xl shadow-black/50 max-h-[92dvh]">
				<div
					class="relative shrink-0 aspect-[21/9] max-sm:aspect-[16/9] overflow-hidden bg-[linear-gradient(135deg,#7f1d1d_0%,#450a0a_55%,#2b0606_100%)]">
					<img id="locationModalImage" class="absolute inset-0 h-full w-full object-cover" alt="" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
					<div class="absolute bottom-4 left-6 right-16 max-sm:left-4">
						<p id="locationModalBadge" class="text-xs font-semibold uppercase tracking-[0.15em] text-amber-300">Σπουδαστήριο Σχολής</p>
						<h2
							id="locationModalTitle"
							class="mt-1 font-anaktoria font-bold text-2xl max-sm:text-xl leading-snug text-red-50 drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.4)] [word-break:break-word]">
							Όνομα
						</h2>
					</div>
					<button
						type="button"
						id="locationModalClose"
						aria-label="Κλείσιμο λεπτομερειών"
						class="absolute right-3 top-3 z-10 grid size-10 place-items-center rounded-full bg-black/40 text-red-50 backdrop-blur-sm transition-colors duration-200 hover:bg-red-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">
						<i class="fa-solid fa-xmark text-xl"></i>
					</button>
				</div>
				<div class="flex-1 overflow-y-auto">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 p-6 max-sm:p-4 max-sm:gap-y-3">
						<div class="flex flex-col gap-y-1">
							<p class="text-xs font-semibold uppercase tracking-[0.12em] text-red-900/60">Διεύθυνση</p>
							<p class="text-base max-sm:text-sm leading-relaxed" id="locationModalAddress"></p>
						</div>
						<div class="flex flex-col gap-y-1">
							<p class="text-xs font-semibold uppercase tracking-[0.12em] text-red-900/60">Υπεύθυνος</p>
							<p class="text-base max-sm:text-sm" id="locationModalManager"></p>
						</div>
						<div class="sm:col-span-2 flex flex-col gap-y-1">
							<p class="text-xs font-semibold uppercase tracking-[0.12em] text-red-900/60">Καθηγητές</p>
							<p class="text-base max-sm:text-sm" id="locationModalTeachers"></p>
						</div>
						<div class="sm:col-span-2 flex flex-col gap-y-2">
							<p class="text-xs font-semibold uppercase tracking-[0.12em] text-red-900/60">Επικοινωνία</p>
							<div class="flex flex-row flex-wrap gap-x-3 gap-y-2" id="locationModalPhones"></div>
							<p class="text-base max-sm:text-sm" id="locationModalEmail"></p>
						</div>
						<div class="sm:col-span-2 flex flex-row flex-wrap gap-2 pt-1" id="locationModalActions"></div>
					</div>
					<div
						id="locationModalMapWrap"
						class="mx-6 mb-6 max-sm:mx-4 max-sm:mb-4 h-[300px] max-sm:h-[260px] overflow-hidden rounded-xl border-2 border-red-900 shadow-md shadow-gray-400">
						<!-- ο χάρτης δημιουργείται δυναμικά κατά το άνοιγμα -->
					</div>
				</div>
			</div>
		</div>
	</div>

	<script is:inline type="application/json" id="spoudastiria-data" set:html={JSON.stringify(locationsWithTeachers)} />
	<style is:inline>
		#spoudastiriaPage {
			opacity: 0.0001;
			animation: fadeIn 0.6s ease-in-out forwards;
		}
		#spoudastiriaGrid:is(.remove) {
			animation: fadeOut 0.25s ease-in-out forwards;
		}
		#spoudastiriaGrid:is(:not(.remove)) {
			opacity: 0.0001;
			animation: fadeIn 0.6s ease-in-out forwards;
		}
		#locationModal {
			opacity: 0;
			transition: opacity 0.25s ease-in-out;
		}
		#locationModal:is(.open) {
			opacity: 1;
		}
		#locationModal:is(.open) #locationModalPanel {
			transform: translateY(0) scale(1);
			opacity: 1;
		}
		#locationModalPanel {
			transform: translateY(14px) scale(0.97);
			opacity: 0;
			transition:
				transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
				opacity 0.25s ease-in-out;
		}
		@media (prefers-reduced-motion: reduce) {
			#spoudastiriaPage,
			#spoudastiriaGrid,
			#locationModal,
			#locationModalPanel {
				animation: none !important;
				transition: none !important;
			}
		}
	</style>
</Layout>

<script>
	import { AnimTimeline, onElementMount } from "@utilities/dom";

	type LocationRow = {
		id: number;
		name: string;
		address: string;
		areacode: number;
		municipality: string;
		email?: string;
		manager: string;
		telephones: string;
		image?: string;
		map: string;
		link?: string;
		youtube?: string;
		partner: boolean;
		teacherCount?: number;
	};

	const imgSrc = "/spoudastiria/";

	const DATA = JSON.parse(document.querySelector<HTMLScriptElement>("#spoudastiria-data")?.textContent || "[]") as LocationRow[];

	const formatAddress = (l: LocationRow) => `${l.address.trim()}, ${l.areacode > 0 ? `${l.areacode} – ` : ""}${l.municipality.trim()}`;
	const phones = (l: LocationRow) =>
		l.telephones
			.split(",")
			.map((t) => t.trim())
			.filter(Boolean);
	const hasValidMap = (l: LocationRow) => l.map?.startsWith("http") && l.map.length > 50;
	const teachersLabel = (n: number) => (n === 1 ? "Διδάσκει 1 καθηγητής" : `Διδάσκουν ${n} καθηγητές`);
	const directionsHref = (l: LocationRow) =>
		`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
			`${l.address.trim()}, ${l.areacode > 0 ? `${l.areacode} ` : ""}${l.municipality.trim()}`,
		)}`;

	onElementMount("#spoudastiriaMain", () => {
		const main = document.querySelector("#spoudastiriaMain") as HTMLElement;
		const grid = document.querySelector("#spoudastiriaGrid") as HTMLElement;
		const modal = document.querySelector("#locationModal") as HTMLElement;
		const panel = document.querySelector("#locationModalPanel") as HTMLElement;
		const modalClose = document.querySelector("#locationModalClose") as HTMLButtonElement;
		let lastTrigger: HTMLElement | null = null;

		// Εναλλαγή κατηγορίας (Σπουδαστήρια / Συνεργαζόμενες)
		document.querySelectorAll<HTMLButtonElement>("#spoudastiriaTabs button[data-group]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const shown = document.querySelector<HTMLElement>("#spoudastiriaTabs button[data-show]");
				if (shown === btn) return;
				const group = btn.getAttribute("data-group") as string;
				const atl = new AnimTimeline();
				atl.step(() => grid.classList.add("remove"))
					.step({
						time: 260,
						anim: () => {
							document.querySelectorAll<HTMLElement>("article[data-group]").forEach((card) => {
								card.classList.toggle("hidden", card.getAttribute("data-group") !== group);
							});
							grid.classList.remove("remove");
							shown?.removeAttribute("data-show");
							shown?.setAttribute("aria-pressed", "false");
							btn.setAttribute("data-show", "true");
							btn.setAttribute("aria-pressed", "true");
						},
					})
					.start();
			});
		});

		// Άνοιγμα λεπτομερειών
		const openModal = (l: LocationRow, trigger?: HTMLElement) => {
			lastTrigger = trigger || null;
			const image = document.querySelector("#locationModalImage") as HTMLImageElement;
			const badge = document.querySelector("#locationModalBadge") as HTMLElement;
			const title = document.querySelector("#locationModalTitle") as HTMLElement;
			const address = document.querySelector("#locationModalAddress") as HTMLElement;
			const manager = document.querySelector("#locationModalManager") as HTMLElement;
			const teachersEl = document.querySelector("#locationModalTeachers") as HTMLElement;
			const phonesEl = document.querySelector("#locationModalPhones") as HTMLElement;
			const emailEl = document.querySelector("#locationModalEmail") as HTMLElement;
			const actionsEl = document.querySelector("#locationModalActions") as HTMLElement;
			const mapWrap = document.querySelector("#locationModalMapWrap") as HTMLElement;

			if (l.image) {
				image.src = imgSrc + l.image;
				image.alt = `Φωτογραφία ${l.name}`;
				image.classList.remove("hidden");
			} else {
				image.removeAttribute("src");
				image.removeAttribute("alt");
				image.classList.add("hidden");
			}
			badge.textContent = l.priority === 1 ? "Έδρα Σχολής" : l.partner ? "Συνεργαζόμενη Σχολή" : "Σπουδαστήριο Σχολής";
			title.textContent = l.name;
			address.textContent = formatAddress(l);
			manager.textContent = l.manager;
			if (l.teacherCount) {
				teachersEl.textContent = teachersLabel(l.teacherCount);
				teachersEl.classList.remove("hidden");
			} else {
				teachersEl.textContent = "";
				teachersEl.classList.add("hidden");
			}

			phonesEl.innerHTML = "";
			phones(l).forEach((phone) => {
				const a = document.createElement("a");
				a.href = `tel:${phone}`;
				a.className =
					"inline-flex items-center gap-1.5 rounded-full bg-red-900 px-3 py-1 text-sm font-medium text-red-50 transition-colors duration-200 hover:bg-red-800";
				const i = document.createElement("i");
				i.className = "fa-solid fa-phone text-[0.8em]";
				a.appendChild(i);
				a.appendChild(document.createTextNode(phone));
				phonesEl.appendChild(a);
			});
			if (!phones(l).length) phonesEl.classList.add("hidden");
			else phonesEl.classList.remove("hidden");

			emailEl.innerHTML = "";
			if (l.email) {
				const a = document.createElement("a");
				a.href = `mailto:${l.email}`;
				a.className =
					"inline-flex items-center gap-2 text-base max-sm:text-sm text-red-900 underline decoration-red-900/50 decoration-1 underline-offset-4 transition-colors hover:text-red-700";
				const i = document.createElement("i");
				i.className = "fa-regular fa-envelope";
				a.appendChild(i);
				a.appendChild(document.createTextNode(l.email));
				emailEl.appendChild(a);
			}

			actionsEl.innerHTML = "";
			[
				{
					href: l.link,
					icon: "fa-solid fa-link",
					label: "Σύνδεσμος",
				},
				{
					href: l.youtube,
					icon: "fa-brands fa-youtube",
					label: "YouTube",
				},
				{
					href: directionsHref(l),
					icon: "fa-solid fa-diamond-turn-right",
					label: "Οδηγίες στους Χάρτες",
				},
			]
				.filter((a) => !!a.href)
				.forEach((action) => {
					const a = document.createElement("a");
					a.href = action.href as string;
					a.target = "_blank";
					a.rel = "noopener";
					a.className =
						"inline-flex items-center gap-2 rounded-lg border-2 border-red-900 px-3.5 py-1.5 text-sm font-semibold text-red-900 transition-colors duration-200 hover:bg-red-900 hover:text-red-50";
					const i = document.createElement("i");
					i.className = action.icon;
					a.appendChild(i);
					a.appendChild(document.createTextNode(action.label));
					actionsEl.appendChild(a);
				});

			// Χάρτης (δημιουργείται μόνο κατά το άνοιγμα — ένα iframe τη φορά)
			mapWrap.innerHTML = "";
			if (hasValidMap(l)) {
				const iframe = document.createElement("iframe");
				iframe.src = l.map;
				iframe.title = `Χάρτης Google Maps – ${l.name}`;
				iframe.loading = "lazy";
				iframe.referrerPolicy = "same-origin";
				iframe.allowFullscreen = true;
				iframe.className = "h-full w-full";
				iframe.setAttribute("aria-label", `Χάρτης για ${l.name}`);
				mapWrap.appendChild(iframe);
			} else {
				const p = document.createElement("p");
				p.className = "grid h-full w-full place-items-center p-6 text-center text-red-950/70";
				p.textContent = "Ο χάρτης δεν είναι διαθέσιμος — χρησιμοποιήστε τον σύνδεσμο «Οδηγίες».";
				mapWrap.appendChild(p);
			}

			modal.classList.remove("hidden");
			main.setAttribute("inert", "");
			document.body.style.overflow = "hidden";
			void modal.offsetHeight;
			modal.classList.add("open");
			setTimeout(() => modalClose.focus(), 60);
		};

		const closeModal = () => {
			modal.classList.remove("open");
			main.removeAttribute("inert");
			document.body.style.overflow = "";
			setTimeout(() => {
				modal.classList.add("hidden");
				const mapWrap = document.querySelector("#locationModalMapWrap") as HTMLElement;
				mapWrap.innerHTML = "";
			}, 260);
			lastTrigger?.focus();
		};

		document.querySelectorAll<HTMLButtonElement>("button[data-open-location]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const l = DATA.find((x) => x.id === Number(btn.getAttribute("data-open-location")));
				if (l) openModal(l, btn);
			});
		});

		modalClose.addEventListener("click", closeModal);
		document.querySelector("#locationModalBackdrop")?.addEventListener("click", closeModal);
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
		});
		// Απλό focus trap εντός του παραθύρου
		panel.addEventListener("keydown", (e) => {
			if (e.key !== "Tab") return;
			const focusables = panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])');
			if (!focusables.length) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		// Άμεσο άνοιγμα από deep link (π.χ. από τη σελίδα Επικοινωνία): /spoudastiria#<όνομα>
		if (window.location.hash) {
			const name = decodeURI(window.location.hash.replace("#", ""));
			const l = DATA.find((x) => x.name === name);
			if (l) {
				const tab = document.querySelector<HTMLButtonElement>(`#spoudastiriaTabs button[data-group="${l.partner ? "partner" : "school"}"]`);
				tab?.click();
				setTimeout(() => openModal(l), 320);
			}
		}
	});
</script>
