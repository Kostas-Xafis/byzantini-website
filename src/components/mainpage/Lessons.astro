---
const lessons = [
	{
		name: "Βυζαντινή Μουσική",
		icon: "fa-church",
		text: "Σπούδασε στη Σχολή μας την ιερά τέχνη του Ιωάννου του Δαμασκηνού και του Ρωμανού του Μελωδού. Απόκτησε Πτυχίο και Δίπλωμα Βυζαντινής Μουσικής αναγνωρισμένο από το κράτος και γίνε θεματοφύλακας της ελληνορθόδοξης μουσικής μας παραδόσεως.",
	},
	{
		name: "Παραδοσιακή Μουσική",
		icon: "fa-guitar",
		text: `Από το 2022 με σχετικό ΦΕΚ  προστέθηκαν επισήμως στην Σχολή μας Τμήματα παραδοσιακής μουσικής. Πλέον, δίνεται σε όλους η ευκαιρία, ανεξαρτήτως ηλικίας, να εντρυφήσουν στα νάματα της εθνικής μας παραδοσιακής μουσικής, με τα οποία γαλουχήθηκαν γενεές γενεών.`,
	},
	{
		name: "Ευρωπαϊκή Μουσική",
		icon: "fa-music",
		text: `Στη Σχολή μας λειτουργεί τμήμα Ευρωπαϊκής μουσικής. Απευθύνεται τόσο στους μαθητές βυζαντινής μουσικής, όσο και σε υποψήφιους μαθητές σε μουσικά σχολεία και υποψήφιους φοιτητές σε τμήματα Μουσικών Σπουδών ΑΕΙ.`,
	},
];
---

<section
	id="lessons"
	class="h-max w-full grid grid-rows-[max-content_max-content_1fr] grid-cols-3 gap-x-[3vw] gap-y-[2vw] p-[3vw] py-[3vh] pb-[12vh] max-sm:flex max-sm:flex-col max-sm:gap-y-6 max-sm:py-12">
	<h2
		id="lessonsHead"
		class="heading relative p-2 text-center w-[9ch] place-self-center text-[2.5vw] max-sm:text-2xl leading-[2.5vw] font-bold font-anaktoria text-red-900 col-span-full overflow-hidden after:left-[calc(50%_-_4ch)] after:w-[8ch] after:bg-red-900">
		Τμήματα
	</h2>
	<p class="col-span-full -mt-[0.5vw] max-sm:mt-0 place-self-center font-didact text-[1vw] max-sm:text-sm max-w-[72ch] text-center text-gray-600">
		Από την ψαλτική τέχνη και τα παραδοσιακά όργανα έως την ευρωπαϊκή μουσική και την προετοιμασία για μουσικά σχολεία.
	</p>
	{
		lessons.map((l) => (
			<div class="lessonCard group/lesson relative h-full rounded-lg shadow-lg border-2 border-red-900 shadow-gray-400 p-[2vw] overflow-hidden after:blur-[2px] after:scale-105 after:bg-center after:absolute after:inset-0 after:-z-10 after:bg-cover">
				<h3 class="absolute inset-0 text-center text-[2vw] max-sm:text-lg font-bold font-anaktoria text-red-50 transition-transform duration-300 translate-y-[calc(50%_-_1vw)] max-sm:translate-y-[calc(50%_-_0.65rem)] group-[:is(.show)]/lesson:translate-y-3 group-hover/lesson:translate-y-3">
					<i
						class={`fa-solid ${l.icon} pr-2.5 text-[1.35vw] max-sm:text-sm drop-shadow-[0_1px_2px_rgba(0,0,0,0.5)] transition-transform duration-300 group-hover/lesson:scale-125`}
						aria-hidden="true"
					/>
					{l.name}
				</h3>
				<p class="text-[1.15vw] text-justify whitespace-pre-line max-sm:text-sm font-didact text-red-50 place-self-center pt-12 max-sm:px-2 max-sm:pb-4 transition-opacity duration-100 opacity-[0.0001] group-[:is(.show)]/lesson:opacity-100 group-hover/lesson:opacity-100 group-[:is(.show)]/lesson:duration-500 group-hover/lesson:duration-500">
					{l.text}
				</p>
			</div>
		))
	}
	<style is:inline>
		.lessonCard:nth-of-type(1)::after {
			background: linear-gradient(to right, rgb(24, 24, 24, 0.15), rgb(24, 24, 24, 0.15)), url("/byz3.jpg");
			background-size: cover;
			background-position: center;
		}
		.lessonCard:nth-of-type(2)::after {
			background: linear-gradient(to right, rgb(24, 24, 24, 0.15), rgb(24, 24, 24, 0.15)), url("/par.jpg");
			background-size: cover;
			background-position: center;
		}
		.lessonCard:nth-of-type(3)::after {
			background-image: url("/eur.jpg");
		}

		.lessonCard {
			background: linear-gradient(to right, transparent, rgb(28, 28, 28, 0.85) 95%);
			background-size: 300% 300%;
			transition: background-position 0.25s ease-in-out;
		}
		#lessons h1,
		#lessons h2 {
			text-shadow: -1px 1px 2px rgb(14, 14, 14, 0.3);
		}
		.lessonCard:is(.show),
		.lessonCard:hover {
			background-position: 100%;
		}
	</style>
</section>
<script>
	import { onElementMount } from "@utilities/dom";
	onElementMount("#lessons", () => {
		const obsv = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (entry.intersectionRatio >= 0.4) document.querySelector<HTMLElement>("#lessonsHead")?.classList.add("emphasis");
				else document.querySelector<HTMLElement>("#lessonsHead")?.classList.remove("emphasis");
			},
			{
				root: null,
				rootMargin: "0px",
				threshold: [0.4],
			},
		);
		obsv.observe(document.querySelector("#lessons") as HTMLElement);
	});
	!window.matchMedia("(min-width: 640px)").matches &&
		onElementMount("#lessons", () => {
			const lessonCards = document.querySelectorAll(".lessonCard");
			const obsv = new IntersectionObserver(
				(entries) => {
					const entry = entries[0];
					if (entry.intersectionRatio >= 0.95) entry.target.classList.add("show");
					else if (entry.intersectionRatio <= 0.1) entry.target.classList.remove("show");
				},
				{
					root: null,
					rootMargin: "0px",
					threshold: [0.1, 0.95],
				},
			);
			lessonCards.forEach((card) => {
				obsv.observe(card);
			});
		});
</script>
