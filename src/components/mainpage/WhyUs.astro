---
// Βασικά πλεονεκτήματα της Σχολής — τα κείμενα βασίζονται σε υπάρχον περιεχόμενο
// του ιστότοπου (ΦΕΚ, χορωδία, τμήματα, "ανεξαρτήτως ηλικίας").
const features = [
	{
		icon: "fa-chalkboard-user",
		title: "Έμπειροι Διδάσκοντες",
		text: "Ιεροψάλτες και καθηγητές με χρόνια πείρας, που μυούν τους μαθητές στην ιερά ψαλτική τέχνη και στα μουσικά όργανα.",
	},
	{
		icon: "fa-certificate",
		title: "Κρατική Αναγνώριση",
		text: "Πτυχία και Διπλώματα αναγνωρισμένα από το Κράτος — ΦΕΚ 1427/Β΄/20.05.2016 και 3730/Β΄/14.07.2022.",
	},
	{
		icon: "fa-church",
		title: "Ζωντανή Συμμετοχή",
		text: "Χορωδία «Άδοντες & Ψάλλοντες», αγιασμοί έναρξης, κάλαντα, συναυλίες — η μουσική ζωντανεύει κάθε εβδομάδα στη Σχολή.",
	},
	{
		icon: "fa-people-group",
		title: "Για κάθε Ηλικία",
		text: "Τμήματα για παιδιά και ενήλικες: ανεξαρτήτως ηλικίας, δίνεται σε όλους η ευκαιρία να μυηθούν στη βυζαντινή και παραδοσιακή μουσική.",
	},
];
---

<section id="why-us" class="relative w-full grid gap-y-8 bg-red-900/[0.05] px-[3vw] py-[6vh] max-sm:px-4 max-sm:py-10">
	<h2
		id="whyUsHead"
		class="heading relative p-2 w-max place-self-center text-center text-[2.5vw] max-sm:text-2xl leading-[2.5vw] font-bold font-anaktoria text-red-900 overflow-hidden after:left-[calc(50%_-_8.5ch)] after:w-[17ch] after:bg-red-900">
		Γιατί τη Σχολή μας
	</h2>
	<div class="grid grid-cols-2 max-sm:grid-cols-1 gap-[1.5vw] max-sm:gap-5 w-full">
		{
			features.map((f) => (
				<article class="flex flex-col gap-y-3 rounded-xl border border-red-900/15 bg-white p-[1.5vw] max-sm:p-4 shadow-md shadow-red-900/5 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-lg hover:shadow-red-900/20">
					<div class="flex items-center gap-x-3">
						<span class="grid h-11 w-11 max-sm:h-10 max-sm:w-10 shrink-0 place-items-center rounded-full bg-red-900 text-red-50 shadow-md shadow-red-900/30">
							<i class={`fa-solid ${f.icon} text-lg max-sm:text-base`} aria-hidden="true" />
						</span>
						<h3 class="font-anaktoria font-bold text-[1.3vw] max-sm:text-lg text-red-900">{f.title}</h3>
					</div>
					<p class="font-didact text-[1vw] max-sm:text-sm leading-relaxed text-gray-700">{f.text}</p>
				</article>
			))
		}
	</div>
</section>
<script>
	import { onElementMount } from "@utilities/dom";

	onElementMount("#why-us", (section) => {
		const head = document.querySelector("#whyUsHead");
		const obsv = new IntersectionObserver(
			(entries) => {
				if (entries[0].intersectionRatio >= 0.3) head?.classList.add("emphasis");
				else head?.classList.remove("emphasis");
			},
			{ rootMargin: "0px", threshold: [0.2, 0.3, 0.5] },
		);
		obsv.observe(section);
	});
</script>
