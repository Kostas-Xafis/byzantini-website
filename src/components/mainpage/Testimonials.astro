---
// Πραγματικές κριτικές από το προφίλ Google της Σχολής — συλλέχθηκαν με
// `bun run google:reviews` (αρχείο: google-reviews/reviews.json, gitignored).
// ✅ Τα κείμενα είναι όπως γράφτηκαν από τους κριτικούς (μόνο περιττά κενά
//    καθαρίστηκαν) — τυχόν «refinement» θα γίνει με επιβεβαίωση των προσώπων.
// ⚠️ Τα πεδία `role` προέρχονται από το ίδιο το κείμενο κάθε κριτικής και
//    χρειάζονται επιβεβαίωση/συμπλήρωση από τη διεύθυνση της Σχολής.
const testimonials = [
	{
		quote: "Νοιώθω περηφάνεια για την ύπαρξη της Σχολής στην Μητρόπολή μας, ιδιαιτέρως δέ για το παράρτημα αυτής που λειτουργεί στην Ενορία μας. Άριστες εγκαταστάσεις, άψογο διδακτικό προσωπικό, συνέχεια της μεγάλης πολιτιστικής καί μουσικής κληρονομιάς μας. Θερμά συγχαρητήρια.",
		author: "π.Νικόλαος Μωραΐτης",
		role: "Εκκλησιαστικός",
	},
	{
		quote: "Γίνεται εξαιρετική δουλειά από τον Υπεύθυνο της Σχολής Πρωτοπρεσβύτερο Σωτήριο Αλεβιζάκη και τους υπόλοιπους Δασκάλους! Είναι όλοι πλήρως καταρτισμένοι στο αντικείμενό τους και διαθέτουν τα κατάλληλα εφόδια για να μεταδώσουν τις γνώσεις τους σε όλους τους κλάδους της Σχολής (Βυζαντινή και Παραδοσιακή Μουσική, Παραδοσιακά Μουσικά Όργανα).",
		author: "Χριστάκης Περατικός",
		role: "Σπουδαστής Ε΄ έτους Βυζαντινής Μουσικής",
	},
	{
		quote: "Αξιόλογοι καθηγητές και πολύ ευχάριστο κλίμα. Διανύω το τρίτο έτος της φοίτησής μου και σε κάθε μάθημα βυζαντινής μουσικής βλέπω όλο και μεγαλύτερη πρόοδο!",
		author: "Κωνσταντίνος Βλάχος",
		role: "Σπουδαστής Δ΄ έτους Βυζαντινής Μουσικής",
	},
	{
		quote: "Εγώ προσωπικά είμαι πολύ τυχερή που έχω έρθει σε αυτή την σχολή. Είναι η δεύτερη χρονιά! Οι καθηγητές μας είναι πολύ επαγγελματίες, το έργο τους φαίνεται σαν αποτέλεσμα στην δική μας πρόοδο. Με αγάπη, υπομονή και με την δική τους εμπειρία μας κάνουν σίγουρα καλύτερους σε αυτό που θέλουμε να μάθουμε. Μπράβο στην σχολή, πολύ καλή οργάνωση!!! Μόνο καλά σχόλια μπορώ να γράψω!!",
		author: "Ειρήνη Λερά",
		role: "Σπουδάστρια Β΄ έτους",
	},
];
---

<section id="testimonials" class="relative w-full grid gap-y-8 px-[3vw] py-[5vh] max-sm:px-4 max-sm:py-10">
	<header class="flex flex-col items-center gap-y-3">
		<h2
			id="testimonialsHead"
			class="heading relative p-2 text-center text-[2.5vw] max-sm:text-2xl leading-[2.5vw] font-bold font-anaktoria text-red-900 overflow-hidden after:left-[calc(50%-7.5ch)] after:w-[15ch] after:bg-red-900">
			Τι λένε για εμάς
		</h2>
		<p class="font-didact text-[1vw] max-sm:text-sm max-w-[60ch] text-center text-gray-600">Όσα λένε μαθητές, γονείς και πτυχιούχοι για τη Σχολή μας.</p>
	</header>
	<div class="grid grid-cols-3 max-sm:grid-cols-1 gap-[1.5vw] max-sm:gap-5 w-full">
		{
			testimonials.map((t) => (
				<blockquote class="testimonialCard relative overflow-hidden flex flex-col gap-y-3 rounded-xl border-2 border-red-900 bg-white p-[1.5vw] max-sm:p-4 shadow-md shadow-red-900/10 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:shadow-red-900/25">
					<i class="fa-solid fa-quote-right absolute top-4 right-4 text-[2.2vw] max-sm:text-3xl text-red-900/10" aria-hidden="true" />
					<div class="flex gap-x-1 text-amber-400" role="img" aria-label="5 στα 5 αστέρια">
						{Array.from({ length: 5 }).map((_, i) => (
							<i class="fa-solid fa-star text-[0.8vw] max-sm:text-xs" aria-hidden="true" />
						))}
					</div>
					<p class="font-didact text-[1vw] max-sm:text-sm leading-relaxed text-gray-700">{t.quote}</p>
					<footer class="mt-auto flex items-center gap-x-3 border-t border-red-900/15 pt-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-900 text-red-50">
							<i class="fa-solid fa-user text-xs" aria-hidden="true" />
						</span>
						<div class="flex flex-col">
							<p class="font-anaktoria font-bold text-[1.05vw] max-sm:text-base leading-tight text-red-900">{t.author}</p>
							<p class="font-didact text-[0.85vw] max-sm:text-xs text-gray-500">{t.role}</p>
						</div>
					</footer>
					<span class="absolute inset-x-0 bottom-0 h-1 rounded-b-xl bg-linear-to-r from-red-900 via-red-700 to-red-300" aria-hidden="true" />
				</blockquote>
			))
		}
	</div>
</section>
<script>
	import { onElementMount } from "@utilities/dom";

	onElementMount("#testimonials", (section) => {
		const head = document.querySelector("#testimonialsHead");
		const headingObsv = new IntersectionObserver(
			(entries) => {
				if (entries[0].intersectionRatio >= 0.3) head?.classList.add("emphasis");
				else head?.classList.remove("emphasis");
			},
			{ rootMargin: "0px", threshold: [0.2, 0.3, 0.5] },
		);
		headingObsv.observe(section);

		// Κάρτες εμφανίζονται με fade όταν μπαίνουν στο viewport (όπως στις Ανακοινώσεις).
		const cards = section.querySelectorAll<HTMLElement>(".testimonialCard");
		cards.forEach((card) => card.classList.add("pre"));
		const cardObsv = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const card = entry.target as HTMLElement;
					if (entry.intersectionRatio >= 0.2) card.classList.add("show");
					else card.classList.remove("show");
				});
			},
			{ rootMargin: "0px", threshold: [0.2, 0.4, 0.6] },
		);
		cards.forEach((card) => cardObsv.observe(card));
	});
</script>
<style is:inline>
	.testimonialCard.pre {
		opacity: 0.01;
	}
	.testimonialCard.pre.show {
		animation: fadeIn 0.6s ease-in-out forwards;
	}
</style>
