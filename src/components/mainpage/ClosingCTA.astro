---
// Τελική κλήση προς εγγραφή — συγκεντρώνει το κάλεσμα του hero σε ένα band στο τέλος της σελίδας.
// Το σχολικό έτος και οι ημερομηνίες εγγραφών προέρχονται από το lib/pupils/years.ts (όπως και στο hero, Landing.astro).
// Η αρχική σελίδα είναι prerendered: το έτος υπολογίζεται κατά το build και ανανεώνεται στον browser (script παρακάτω).
import { currentSchoolYearShort, REGISTRATION_WINDOW_LABEL } from "@lib/pupils/years";

const schoolYear = currentSchoolYearShort();
---

<section id="eggrafes-cta" class="relative grid w-full place-items-center gap-y-5 bg-red-950 px-[3vw] py-[5vh] max-sm:px-4 max-sm:py-10">
	<h2
		class="max-w-[24ch] text-center text-[clamp(1.5rem,2.25vw,2.75rem)] max-sm:text-xl leading-none max-sm:leading-[5vw] font-bold font-anaktoria text-red-50">
		Ξεκινήστε τη μουσική σας πορεία μαζί μας
	</h2>
	<p class="font-didact text-[clamp(0.9375rem,1vw,1.25rem)] max-sm:text-sm text-red-100/90 text-center max-w-[64ch]">
		Εγγραφές για το σχολικό έτος <span data-school-year-short>{schoolYear}</span> από {REGISTRATION_WINDOW_LABEL} — Βυζαντινή, Παραδοσιακή και Ευρωπαϊκή Μουσική,
		για κάθε ηλικία.
	</p>
	<div class="flex flex-wrap justify-center gap-x-4 gap-y-3">
		<a
			href="/eggrafes/"
			class="rounded-xl bg-red-50 px-[1.5vw] py-[0.6vh] max-sm:px-5 max-sm:py-2 font-anaktoria font-bold text-[clamp(1rem,1.2vw,1.5rem)] max-sm:text-base text-red-900 shadow-md transition-transform hover:scale-[1.03]">
			Εγγραφές
		</a>
		<a
			href="/epikoinonia/"
			class="rounded-xl border-2 border-red-50 px-[1.5vw] py-[0.6vh] max-sm:px-5 max-sm:py-2 font-anaktoria font-bold text-[clamp(1rem,1.2vw,1.5rem)] max-sm:text-base text-red-50 transition-colors hover:bg-red-50 hover:text-red-900">
			Επικοινωνία
		</a>
	</div>
	<style is:inline>
		#eggrafes-cta h2 {
			text-shadow: -1px 2px 2px rgba(12 10 9 / 0.35);
		}
	</style>
</section>
<script>
	import { currentSchoolYearShort } from "@lib/pupils/years";
	document.querySelectorAll("[data-school-year-short]").forEach((el) => (el.textContent = currentSchoolYearShort()));
</script>
