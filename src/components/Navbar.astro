---
const links = [
	{ name: "Αρχική", url: "/" },
	{
		name: "Η Σχολή μας",
		url: "/sxoli",
		expand: [
			{
				name: "Διοικητικό Συμβούλιο",
				url: "/dioikitiko-symvoulio",
			},
			{
				name: "Ανακοινώσεις",
				url: "/anakoinoseis",
			},
			{
				name: "Χορωδία",
				url: "/xorodia",
			},
		],
	},
	{ name: "Εγγραφές", url: "/eggrafes" },
	{ name: "Καθηγητές", url: "/kathigites" },
	{ name: "Σπουδαστήρια", url: "/spoudastiria" },
	{ name: "Επικοινωνία", url: "/epikoinonia" },
];

const highlight = (url: string) => {
	const path = Astro.url.pathname;
	return (path.includes(url) && url !== "/") || path === url;
};
---

<>
	<nav
		class={"glass-dark fixed top-0 left-0 w-full z-[1000] transition-colors" +
			" grid grid-cols-[max-content_1fr] grid-rows-[4.1vw] md:h-[4.2vw]" +
			" max-sm:flex max-sm:flex-col max-sm:h-[4.25rem]"}>
		{/* Desktop header: logo + titles (hidden below sm) */}
		<div class="relative pl-4 grid grid-cols-[max-content_max-content] grid-rows-[1fr] gap-x-4 font-anaktoria self-center z-10 max-sm:hidden">
			<a
				href="/"
				class="row-span-full sm:w-[80px] aspect-square place-self-center [mask-image:url('/logo.png')] [mask-size:contain] [mask-repeat:no-repeat]">
				<div class="w-full h-full bg-red-50"></div>
				<img class="hidden" src="/logo.png" alt="Λογότυπο Σχολής" />
			</a>
			<div class="absolute top-[50%] translate-y-[calc(-50%_+_2px)] left-[calc(1rem_-_1px)] -z-10">
				<div class="sm:w-[80px] aspect-square [mask-image:url('/logo.png')] [mask-size:contain] [mask-repeat:no-repeat]">
					<div class="w-full h-full bg-[rgb(0_0_0_/_0.25)]"></div>
				</div>
			</div>
			<div class="flex flex-col justify-center h-full">
				<p class="navTitle mt-1 font-bold drop-shadow-[-2px_1px_2px_rgba(0_0_0_/_0.75)] text-red-50 text-4xl">
					Σχολή Βυζαντινής & Παραδοσιακής Μουσικής
				</p>
				<p class="navTitle font-bold drop-shadow-[-2px_1px_2px_rgba(0_0_0_/_0.75)] text-red-50 text-2xl max-sm:pl-4">
					Ι.Ν. Μεταμορφώσεως του Σωτήρος<span class="max-sm:hidden">, ομωνύμου δήμου</span>
				</p>
			</div>
		</div>

		{/* Desktop links (hidden below sm) */}
		<div class="w-min grid auto-cols-auto grid-rows-[1fr] grid-flow-col justify-self-end px-4 max-sm:hidden">
			{
				links.map((link) =>
					link.expand ? (
						<div class="group relative grid grid-rows-[minmax(min-content, 60px)] place-content-center px-1 cursor-pointer">
							<div class="px-2 font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-2px_1px_0px_rgba(0,0,0,0.25)] text-[1.5vw]">
								{link.name}
							</div>
							<div
								class={
									"absolute left-2 right-2 bottom-[10%] translate-y-[-1px] h-[2px] rounded-[2px] drop-shadow-[-2px_1px_1px_rgba(0,0,0,0.25)]" +
									(highlight(link.url)
										? " bg-[radial-gradient(50%_50%_at_50%_50%,_rgb(254_226_226_/_0.2),_rgb(254_226_226_/_0.8))]"
										: " scale-x-0 transition-transform duration-300 group-hover:bg-[radial-gradient(50%_50%_at_50%_50%,_rgb(254_226_226_/_0.2),_rgb(254_226_226_/_0.8))] group-hover:scale-x-100")
								}
							/>
							<div class="absolute top-[100%] left-0 bg-red-900 opacity-0 pointer-events-none overflow-hidden rounded-b-md shadow-md shadow-gray-600 transition-opacity duration-300 ease-in-out group-hover:opacity-100 group-hover:pointer-events-auto">
								{link.expand.map((sublink) => (
									<a href={link.url + sublink.url} class="relative grid py-4 transition-colors ease-in-out hover:bg-red-950">
										<p class="px-2 font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.15)] text-center text-xl">
											{sublink.name}
										</p>
									</a>
								))}
							</div>
						</div>
					) : (
						<a
							class="group relative grid grid-rows-[minmax(min-content, 60px)] place-content-center px-1"
							href={link.url}
							data-astro-prefetch="hover">
							<div class="px-2 font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-2px_1px_0px_rgba(0,0,0,0.25)] text-[1.5vw]">
								{link.name}
							</div>
							<div
								class={
									"absolute left-2 right-2 bottom-[10%] translate-y-[-1px] h-[2px] rounded-[2px] drop-shadow-[-2px_1px_1px_rgba(0,0,0,0.25)]" +
									(highlight(link.url)
										? " bg-[radial-gradient(50%_50%_at_50%_50%,_rgb(254_226_226_/_0.2),_rgb(254_226_226_/_0.8))]"
										: " scale-x-0 transition-transform duration-300 group-hover:bg-[radial-gradient(50%_50%_at_50%_50%,_rgb(254_226_226_/_0.2),_rgb(254_226_226_/_0.8))] group-hover:scale-x-100")
								}
							/>
						</a>
					),
				)
			}
		</div>

		{
			/*
			Mobile header (hidden at sm+): two rows pulled left by the hidden
			checkbox (peer) — the burger label toggles it with zero JS.
			  logo | Main title | Burger
			  logo | Sub title  | Burger
		*/
		}
		<div class="hidden max-sm:grid w-full grid-cols-[auto_1fr_auto] grid-rows-[auto_auto] items-center gap-x-2 gap-y-[3px] h-full pl-2 py-1">
			<div class="relative row-span-2 place-self-center">
				<div
					class="absolute inset-0 translate-x-[2px] translate-y-[2px] [mask-image:url('/logo.png')] [mask-size:contain] [mask-repeat:no-repeat]"
					aria-hidden="true">
					<div class="w-full h-full bg-[rgb(0_0_0_/_0.25)]"></div>
				</div>
				<a href="/" class="relative block w-12 aspect-square [mask-image:url('/logo.png')] [mask-size:contain] [mask-repeat:no-repeat]">
					<div class="w-full h-full bg-red-50"></div>
					<img class="hidden" src="/logo.png" alt="Λογότυπο Σχολής" />
				</a>
			</div>
			<p
				class="navTitle col-start-2 row-start-1 self-end text-lg leading-5 font-bold font-anaktoria text-red-50 text-left drop-shadow-[-2px_1px_2px_rgba(0_0_0_/_0.75)] max-2xs:text-xs max-2xs:leading-4">
				Σχολή Βυζαντινής & Παραδοσιακής Μουσικής
			</p>
			<p
				class="navTitle col-start-2 row-start-2 self-start text-base leading-4 font-bold font-anaktoria text-red-50 text-left drop-shadow-[-2px_1px_2px_rgba(0_0_0_/_0.75)] max-2xs:text-[10px]">
				Ι.Ν. Μεταμορφώσεως του Σωτήρος
			</p>
			<div class="col-start-3 row-span-2 relative flex h-full items-center justify-end">
				<span
					class="absolute -inset-y-1 left-0 w-px bg-[radial-gradient(50%_50%_at_50%_50%,_rgb(254_226_226_/_0.85),_rgb(254_226_226_/_0.2)_55%,_transparent_100%)]"
					aria-hidden="true"></span>
				<label
					for="mobile-nav-toggle"
					aria-label="Περιήγηση"
					class="flex h-full cursor-pointer select-none items-center px-4 text-red-50 drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.15)]">
					<i class="fa-solid fa-bars text-2xl" aria-hidden="true"></i>
				</label>
			</div>
		</div>
	</nav>

	{
		/* Mobile menu: full-height dropdown below the nav (kept outside <nav> so the
			`glass` backdrop-filter on the main page can't clip it). */
	}
	<input id="mobile-nav-toggle" type="checkbox" class="peer sr-only" />
	<div
		id="mobile-nav-menu"
		class="glass-dark fixed inset-x-0 bottom-0 top-[4.25rem] z-[999] sm:hidden overflow-y-auto opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out peer-checked:opacity-100 peer-checked:pointer-events-auto">
		<div class="grid">
			{
				links.map((link) =>
					link.expand ? (
						<div class="group/sub border-b-2 border-b-red-950">
							<label for="sxoli-sub-toggle" class="relative grid py-4 cursor-pointer select-none transition-colors ease-in-out hover:bg-red-950">
								<span class="relative mx-auto w-max font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.15)] text-2xl">
									{link.name}
									<i
										class="absolute left-full top-1/2 -translate-y-1/2 ml-2.5 fa-solid fa-chevron-down text-sm text-red-100 transition-transform duration-300 ease-in-out group-has-checked/sub:rotate-180"
										aria-hidden="true"
									/>
								</span>
							</label>
							<input type="checkbox" id="sxoli-sub-toggle" class="sr-only" />
							<div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out group-has-checked/sub:grid-rows-[1fr]">
								<div class="overflow-hidden">
									{link.expand.map((sublink) => (
										<a href={link.url + sublink.url} class="grid bg-red-950 py-4 transition-colors ease-in-out hover:bg-red-900">
											<p class="px-2 font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.15)] text-center text-xl">
												{sublink.name}
											</p>
										</a>
									))}
								</div>
							</div>
						</div>
					) : (
						<a class="grid py-4 transition-colors ease-in-out hover:bg-red-950 border-b-2 border-b-red-950" href={link.url}>
							<p class="px-2 font-bold font-anaktoria text-red-50 whitespace-nowrap drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.15)] text-center text-2xl">
								{link.name}
							</p>
						</a>
					),
				)
			}
		</div>
	</div>
</>
<script>
	import { iOS, onElementMount } from "@utilities/dom";
	if (iOS()) {
		onElementMount(".navTitle", () => {
			const heads = [...document.querySelectorAll(".navTitle")] as HTMLElement[];
			heads.forEach((head) => {
				head.style.setProperty("letter-spacing", "-1px");
			});
		});
	}
</script>
