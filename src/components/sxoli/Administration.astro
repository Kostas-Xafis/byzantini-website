---
const principalText = [
	`Γεννήθηκε στὸ Περδικονέρι Ἀρκαδίας.
Ὑπηρετεῖ ὡς Ἐφημέριος στὸν Ἱερὸ
Μητροπολιτικὸ Ναὸ Ἁγίου Δημητρίου
Κηφισιᾶς.`,
	`Τυγχάνει πτυχιοῦχος τῆς Θεολογικῆς Σχολῆς
τοῦ Πανεπιστημίου Ἀθηνῶν. Ὑπηρέτησε ὡς
καθηγητὴς στὴν Μέση Ἐκπαίδευση στὸ 1ο
Γυμνάσιο Κηφισιᾶς ἐπὶ εἰκοσαετίαν καὶ ἐπὶ
δεκαετίαν στὸ Πειραματικὸ Γυμνάσιο – Λύκειο
Ἀναβρύτων, ἀπ’ ὅπου καὶ συνταξιοδοτήθηκε.
Τὸν Ἰούνιο τοῦ 2010 μὲ ἀπόφαση τοῦ
Σεβασμιωτάτου Μητροπολίτου Κηφισίας,
Ἀμαρουσίου, Ὠρωποῦ καὶ Μαραθῶνος κ.
Κυρίλλου διορίσθηκε Γενικὸς Ἀρχιερατικὸς
Ἐπίτροπος τῆς Ἱερᾶς Μητροπόλεως.`,
	`Ὁ π. Χρῖστος ἀπὸ νεαρὴ ἡλικία ἔδειξε τὴν κλίση του πρὸς τὴν μουσική.
Πρῶτος διδάσκαλός του στὴν Βυζαντινὴ Μουσική, ὁ Δημήτριος
Παναγιωτόπουλος - Κοῦρος, στὴ Ριζάρειο Σχολή, τῆς ὁποίας τυγχάνει
ἀπόφοιτος. Ἀργότερα διηύρυνε καὶ ὁλοκλήρωσε τὴν μουσική του παιδεία,
στὸ Ὠδεῖο Ἀθηνῶν, στὸ Ἑλληνικὸ Ὠδεῖο, στό Ὠδεῖο Ἀχαρνῶν καί στό Ὠδεῖο
Ἀργυρουπόλεως. Εἶναι πτυχιοῦχος καὶ διπλωματοῦχος μουσικοδιδάσκαλος
τῆς Βυζαντινῆς Μουσικῆς. Στὸν Μητροπολιτικὸ Ἱερὸ Ναὸ Ἁγίου Δημητρίου
Κηφισιᾶς τὸ 1984 ἱδρυσε Σχολὴ Βυζαντινῆς Μουσικῆς καὶ συνέστησε τὴν
πολυμελῆ Χορωδία «Βυζαντινὴ Κυψέλη». Χρημάτισε συνεργάτης στὸν
Ραδιοφωνικὸ Σταθμὸ τῆς Ἐκκλησίας τῆς Ἑλλάδος, ὅπου ἐπὶ σειρὰν ἐτῶν
διετέλεσε συντονιστὴς τῶν ἐκπομπῶν Βυζαντινῆς καὶ Παραδοσιακῆς
Μουσικῆς καθὼς ἐπίσης καὶ τακτικὸς συνεργάτης τῆς Ἑλληνικῆς
Ραδιοφωνίας καὶ Τηλεοράσεως.`,
	`Διετέλεσε καθηγητής Βυζαντινῆς Μουσικῆς στο Δημοτικό Ὠδεῖο Ἀμαρουσίου
καί διευθυντής τῆς Σχολῆς Βυζαντινῆς Μουσικῆς τῆς Ἱερᾶς Μητροπόλεως
Μεσογαίας καί Λαυρεωτικῆς. Εἶναι Διευθυντής τῆς Σχολῆς Βυζαντινῆς
Μουσικῆς τῆς Ἱερᾶς Μητροπόλεως Θηβῶν καί Λεβαδείας καί ἀπό τόν
Ὀκτώβριο 2015 διορίστηκε ἀπό τό Ὑπουργεῖο Πολιτισμοῦ καί Ἀθλητισμοῦ
Διευθυντής τῆς Σχολῆς Βυζαντινῆς Μουσικῆς τοῦ Ἱεροῦ Καθεδρικοῦ Ναοῦ
Μεταμορφώσεως τοῦ Σωτῆρος τοῦ ὁμωνύμου Δήμου.`,
	`Ἀσχολεῖται συστηματικὰ μὲ τὴν μουσικὴ λαογραφία καὶ τὴν καταγραφὴ
Δημοτικῶν Τραγουδιῶν. Ἡ Ἑταιρεία Πελοποννησιακῶν Σπουδῶν, τῆς
ὁποίας εἶναι μέλος καὶ ἐπιστημονικὸς συνεργάτης, ἐξέδωσε μελέτες του μὲ
καταγραφές Δημοτικῶν τραγουδιῶν σὲ βυζαντινὴ καὶ εὐρωπαϊκὴ μουσική.
Γνωρίζει καὶ διδάσκει τό παραδοσιακό μουσικό ὄργανο ψαλτήριον
(κανονάκι). Ἔχει πραγματοποιήσει πολλὲς ἠχογραφήσεις μὲ Βυζαντινοὺς
ὕμνους, καθὼς καὶ παραδοσιακά τραγούδια. Ἀξιόλογη ἠχογράφηση
θεωρεῖται ἐκείνη, ἡ ὁποία πραγματοποιήθηκε μετὰ ἀπὸ ἔρευνά του γιὰ τὸν
Θούριο τοῦ Ρήγα Βελεστινλῆ καὶ τὴν ὁποία ἐξέδωσε σὲ ψηφιακὸ δίσκο, ἡ
«Ἐπιστημονικὴ Ἑταιρεία Μελέτης Φερρῶν - Βελεστίνου Ρήγα». Μάλιστα
παρουσιάστηκε στόν Βόλο, μὲ τὴν εὐκαιρία τῆς συμπληρώσεως διακοσίων
ἐτῶν, ἀπὸ τὸν μαρτυρικὸ θάνατο τοῦ πρωτομάρτυρα τῆς λευτεριᾶς. Ἐπίσης,
ἔχει ἑρμηνεύσει τὸν πρωταγωνιστικὸ ρόλο στὸ θρησκευτικὸ ὁρατόριο –
ραψωδία «Κοσμᾶς ὁ Αἰτωλός» σὲ μουσικὴ Σωκράτη Βενάρδου καί ποίηση
Κώστα Χωρεάνθη, τὸ ὁποῖο παρουσιάστηκε σὲ πολλὲς πόλεις τῆς Ἑλλάδος.
Ἄλλες ἀξιόλογες ἠχογραφήσεις του, σὲ μονωδιακὴ ἐκτέλεση καθὼς καὶ μὲ τὴ
χορωδία «Βυζαντινὴ Κυψέλη», ποὺ ὁ ἴδιος διευθύνει, συνοδείᾳ
παραδοσιακῶν λαϊκῶν ὀργάνων, θεωροῦνται οἱ: «Ἡρωϊκοὶ Ἀντίλαλοι τοῦ
Μοριᾶ», «Παραδοσιακὰ Τραγούδια τοῦ Γάμου καὶ τῆς Χαρᾶς», «Μνῆμες τοῦ
Μοριᾶ», «Λεβέντικοι Ρυθμοί» καὶ «Κιβωτὸς Ἀσμάτων». Τὸ ἔτος 2006
συνέθεσε τὸ βυζαντινὸ ὀρατόριο, μουσικὸ ἔργο γιὰ βυζαντινὴ χορωδία καὶ
ὀρχήστρα παραδοσιακῶν ὀργάνων, «Ὁ αἰώνιος ὕμνος τῆς ἀγάπης», σὲ
κείμενα τοῦ πανεπιστημιακοῦ καθηγητοῦ Ἠλία Β. Οἰκονόμου, τὸ ὁποῖο
παρουσιάστηκε γιὰ πρώτη φορὰ στὸ πολιτιστικὸ κέντρο τοῦ Δήμου
Κηφισιᾶς.`,
	`Ὁ π. Χρῖστος Κυριακόπουλος, ἀνήκει στὴν κατηγορία τῶν κληρικῶν ἐκείνων,
οἱ ὁποῖοι πέρα ἀπὸ τὰ εἰδικὰ ἱερατικά τους καθήκοντα, προσφέρουν καὶ ἔργο
πολύτιμο γιὰ τὴν διάσωση καὶ διάδοση τῆς Ἐθνικῆς μας Μουσικῆς»`,
];
const imgSrc = "/kathigites/picture/";
---

<>
	<div class="relative w-full max-w-[1500px] mx-auto flex flex-col items-stretch">
		<header
			class="relative flex flex-col items-center gap-y-2 pt-2 pb-7 max-sm:pb-5 select-none">
			<div class="flex items-center gap-4 max-sm:gap-2" aria-hidden="true">
				<span class="h-px w-24 max-sm:w-10 bg-gradient-to-r from-transparent to-red-900/50"
				></span>
				<i class="fa-solid fa-diamond text-[0.55rem] text-red-900/60"></i>
				<span class="h-px w-24 max-sm:w-10 bg-gradient-to-l from-transparent to-red-900/50"
				></span>
			</div>
			<h1
				class="text-[3.2vw] max-sm:text-[1.85rem] max-3xs:text-2xl leading-tight text-center font-anaktoria font-bold text-red-900 drop-shadow-[0_2px_2px_rgba(127,29,29,0.16)]">
				Διοικητικό Συμβούλιο
			</h1>
			<p
				class="text-lg max-sm:text-base text-center font-didact tracking-wide text-red-900/70">
				Σχολῆς Βυζαντινῆς καὶ Παραδοσιακῆς Μουσικῆς
			</p>
			<div class="flex items-center gap-2 mt-1 text-red-900/40" aria-hidden="true">
				<span class="h-px w-14 max-sm:w-8 bg-gradient-to-r from-transparent to-red-900/40"
				></span>
				<i class="fa-solid fa-diamond text-[0.45rem]"></i>
				<span class="h-px w-14 max-sm:w-8 bg-gradient-to-l from-transparent to-red-900/40"
				></span>
			</div>
		</header>
		<section
			id="selectContainer"
			role="tablist"
			aria-label="Περιεχόμενα σελίδας"
			data-selected="org"
			class="group/select relative z-10 self-center w-full font-bold font-anaktoria flex flex-row justify-evenly max-sm:flex-wrap max-sm:justify-center border-x-2 border-t-2 border-red-900 rounded-t-2xl overflow-hidden bg-[linear-gradient(180deg,#fef2f2_0%,#fde8e8_100%)] shadow-xl shadow-red-900/20">
			<span
				class="pointer-events-none absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-transparent via-amber-500/70 to-transparent"
				aria-hidden="true"></span>
			<button
				id="principalBtn"
				type="button"
				role="tab"
				aria-selected="false"
				aria-controls="principalContainer"
				class="group/btn relative flex-1 max-sm:basis-full w-full p-4 flex flex-row items-center justify-center gap-3 text-3xl tracking-wide leading-snug text-red-900 transition-colors duration-300 ease-out 2xl:text-4xl max-sm:text-lg hover:bg-red-100 hover:text-red-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400 group-data-[selected='principal']/select:bg-gradient-to-b group-data-[selected='principal']/select:from-red-900 group-data-[selected='principal']/select:to-red-950 group-data-[selected='principal']/select:text-white">
				<span
					class="grid place-items-center w-11 h-11 max-sm:w-9 max-sm:h-9 shrink-0 rounded-full border border-red-900/15 bg-red-900/10 text-red-900 text-xl max-sm:text-base transition-all duration-300 group-hover/btn:scale-105 group-data-[selected='principal']/select:border-amber-200/40 group-data-[selected='principal']/select:bg-amber-400 group-data-[selected='principal']/select:text-red-950 group-data-[selected='principal']/select:shadow-[0_0_14px_rgba(251,191,36,0.55)]">
					<i class="fa-solid fa-user-tie"></i>
				</span>
				<span class="transition-transform duration-300 group-hover/btn:-translate-y-1"
					>Ο Διευθυντής</span
				>
				<span
					class="absolute bottom-0 left-[22%] right-[22%] h-[3px] rounded-t-full bg-gradient-to-r from-amber-400/0 via-amber-400 to-amber-400/0 opacity-0 transition-opacity duration-300 group-data-[selected='principal']/select:opacity-100"
					aria-hidden="true"></span>
			</button>
			<button
				id="orgBtn"
				type="button"
				role="tab"
				aria-selected="true"
				aria-controls="orgContainer"
				class="group/btn relative flex-1 max-sm:basis-full w-full p-4 flex flex-row items-center justify-center gap-3 text-3xl tracking-wide leading-snug text-red-900 transition-colors duration-300 ease-out 2xl:text-4xl max-sm:text-lg hover:bg-red-100 hover:text-red-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400 group-data-[selected='org']/select:bg-gradient-to-b group-data-[selected='org']/select:from-red-900 group-data-[selected='org']/select:to-red-950 group-data-[selected='org']/select:text-white">
				<span
					class="grid place-items-center w-11 h-11 max-sm:w-9 max-sm:h-9 shrink-0 rounded-full border border-red-900/15 bg-red-900/10 text-red-900 text-xl max-sm:text-base transition-all duration-300 group-hover/btn:scale-105 group-data-[selected='org']/select:border-amber-200/40 group-data-[selected='org']/select:bg-amber-400 group-data-[selected='org']/select:text-red-950 group-data-[selected='org']/select:shadow-[0_0_14px_rgba(251,191,36,0.55)]">
					<i class="fa-solid fa-users"></i>
				</span>
				<span class="transition-transform duration-300 group-hover/btn:-translate-y-1"
					>Διοικητικό Συμβούλιο</span
				>
				<span
					class="absolute bottom-0 left-[22%] right-[22%] h-[3px] rounded-t-full bg-gradient-to-r from-amber-400/0 via-amber-400 to-amber-400/0 opacity-0 transition-opacity duration-300 group-data-[selected='org']/select:opacity-100"
					aria-hidden="true"></span>
			</button>
		</section>
		<section
			id="principalContainer"
			role="tabpanel"
			aria-labelledby="principalBtn"
			class="contentContainer hidden group relative h-max overflow-hidden rounded-b-2xl border-x-2 border-b-2 border-red-900 bg-[linear-gradient(135deg,#7f1d1d_0%,#450a0a_55%,#2b0606_100%)] shadow-2xl shadow-red-900/30 text-white">
			<div
				class="relative z-10 flex flex-row gap-x-6 max-sm:gap-x-0 max-sm:gap-y-5 max-sm:flex-col">
				<p
					class="sm:hidden pt-4 text-2xl max-3xs:text-xl tracking-wide text-center font-anaktoria flex items-center justify-center gap-3 text-white drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.3)]">
					<i class="fa-solid fa-diamond text-[0.35em] text-amber-400"></i>
					Πρωτοπρ. Χρίστος Κυριακόπουλος
					<i class="fa-solid fa-diamond text-[0.35em] text-amber-400"></i>
				</p>
				<figure
					class="group/fig flex shrink-0 flex-col items-center gap-y-3 px-6 py-8 max-sm:px-0 max-sm:pt-0 max-sm:pb-2 self-center sm:group-[:is(.unfold)]:sticky sm:top-[calc(4.2vw+1rem)] sm:group-[:is(.unfold)]:self-start">
					<div
						class="rounded-2xl p-[3px] bg-gradient-to-b from-amber-300/90 via-amber-500/50 to-amber-700/20 shadow-[0_12px_45px_-10px_rgba(0,0,0,0.75)] transition-shadow duration-500 group-hover/fig:shadow-[0_12px_55px_-8px_rgba(251,191,36,0.25)]">
						<img
							src={imgSrc + "Πρωτοπρ. Χρίστος Κυριακόπουλος.jpeg"}
							alt="Φωτογραφία Διευθυντή"
							width="350px"
							class="w-[350px] max-w-full max-sm:w-[250px] object-cover rounded-[13px] transition-transform duration-500 group-hover/fig:scale-[1.03]"
						/>
						<span
							class="pointer-events-none absolute inset-[3px] rounded-[13px] ring-1 ring-inset ring-amber-200/30"
							aria-hidden="true"></span>
					</div>
				</figure>
				<div
					class="relative flex min-w-0 flex-1 flex-col gap-y-4 px-12 py-8 pb-10 max-sm:px-4">
					<p
						class="max-sm:hidden flex items-center justify-center gap-4 text-[2.5vw] tracking-wide text-center font-anaktoria text-white drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.3)]">
						<i class="fa-solid fa-diamond text-[0.35em] text-amber-400"></i>
						Πρωτοπρ. Χρίστος Κυριακόπουλος
						<i class="fa-solid fa-diamond text-[0.35em] text-amber-400"></i>
					</p>
					<p
						class="text-2xl leading-relaxed max-sm:text-xl text-white first-letter:float-left first-letter:mr-2 first-letter:font-anaktoria first-letter:text-[2.7em] first-letter:leading-[0.8] first-letter:text-amber-300">
						{principalText[0]}
					</p>
					<p
						class="text-2xl leading-relaxed max-sm:text-xl text-white max-sm:group-[:is(:not(.unfold))]:pb-20">
						{principalText[1]}
					</p>
					<button
						id="readMore"
						type="button"
						class="group/open absolute left-[50%] bottom-4 z-10 flex -translate-x-1/2 flex-row items-center gap-2 rounded-full border-2 border-amber-400/70 bg-red-950/85 px-6 py-2 text-2xl max-sm:text-xl font-didact font-bold text-white backdrop-blur-sm shadow-lg shadow-red-950/50 transition-all duration-300 hover:-translate-y-0.5 hover:border-amber-300 hover:bg-amber-400 hover:text-red-950 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300">
						<span class="group-[:is(.show)]/open:hidden max-3xs:text-lg"
							>Διαβάστε περισσότερα</span
						>
						<i
							class="group-[:is(.show)]/open:hidden readMore-bob fa-solid fa-chevron-down text-lg max-3xs:text-base"
						></i>
						<i
							class="hidden group-[:is(.show)]/open:flex fa-solid fa-chevron-up text-xl max-3xs:text-lg"
						></i>
					</button>
					<div id="moreText" class="text-xl">
						<div class="flex flex-col gap-y-4 pb-12">
							<p
								class="text-2xl leading-relaxed max-sm:text-xl text-white text-justify">
								{principalText[2]}
							</p>
							<p
								class="text-2xl leading-relaxed max-sm:text-xl text-white text-justify">
								{principalText[3]}
							</p>
							<p
								class="text-2xl leading-relaxed max-sm:text-xl text-white text-justify">
								{principalText[4]}
							</p>
							<p
								class="text-2xl leading-relaxed max-sm:text-xl text-white text-justify">
								{principalText[5]}
							</p>
							<div
								class="flex w-[min(36ch,80%)] items-center gap-3 self-center pt-2 text-sm text-amber-400/70"
								aria-hidden="true">
								<span
									class="h-px flex-1 bg-gradient-to-r from-transparent to-amber-400/70"
								></span>
								<i class="fa-solid fa-diamond text-[0.7em]"></i>
								<span
									class="h-px flex-1 bg-gradient-to-l from-transparent to-amber-400/70"
								></span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section
			id="orgContainer"
			role="tabpanel"
			aria-labelledby="orgBtn"
			class="contentContainer group relative h-max overflow-hidden rounded-b-2xl border-x-2 border-b-2 border-red-900 bg-[linear-gradient(135deg,#7f1d1d_0%,#450a0a_55%,#2b0606_100%)] shadow-2xl shadow-red-900/30 text-white">
			<div
				class="relative z-10 w-full mx-auto max-w-[1400px] flex flex-col items-center gap-6 px-8 py-10 max-sm:px-4 max-sm:py-7">
				<div class="flex items-center gap-3 text-amber-400" aria-hidden="true">
					<span
						class="h-px w-16 max-sm:w-8 bg-gradient-to-r from-transparent to-amber-400/70"
					></span>
					<i class="fa-solid fa-diamond text-[0.55rem]"></i>
					<span
						class="h-px w-16 max-sm:w-8 bg-gradient-to-l from-transparent to-amber-400/70"
					></span>
				</div>
				<div class="flex flex-col items-center gap-y-1.5">
					<h2
						class="text-[2.4vw] max-sm:text-3xl max-3xs:text-xl tracking-wide text-center font-anaktoria text-white drop-shadow-[-1px_1px_1px_rgba(0,0,0,0.3)]">
						Διοικοῦσα &thinsp;Ἐπιτροπὴ
					</h2>
					<p class="text-lg max-sm:text-base text-amber-100/85 font-didact tracking-wide">
						τῆς Σχολῆς Βυζαντινῆς καὶ Παραδοσιακῆς Μουσικῆς
					</p>
				</div>
				<div class="grid w-full max-w-[1150px] grid-cols-1 md:grid-cols-3 gap-4 mt-1">
					<div
						class="group/member relative flex flex-col items-center gap-4 rounded-2xl border border-amber-400/25 bg-[linear-gradient(180deg,rgba(127,29,29,0.5),rgba(69,10,10,0.3))] p-6 pt-7 shadow-lg shadow-red-950/40 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-300/60 hover:shadow-2xl hover:shadow-amber-900/30">
						<span
							class="absolute top-3 right-4 text-sm font-anaktoria text-amber-300/60"
							aria-hidden="true">Α΄</span
						>
						<span
							class="grid place-items-center w-16 h-16 rounded-full bg-gradient-to-b from-amber-300 to-amber-500 text-red-950 text-2xl shadow-lg shadow-amber-900/40 ring-4 ring-amber-400/15 transition-transform duration-300 group-hover/member:scale-110">
							<i class="fa-solid fa-user-tie"></i>
						</span>
						<div class="flex flex-col items-center gap-1 text-center">
							<span
								class="text-xs font-bold uppercase tracking-[0.28em] text-amber-300"
								>Πρόεδρος</span
							>
							<h3 class="text-2xl max-sm:text-xl font-anaktoria text-white">
								Αἰδεσ/τος Πρωτοπρεσβύτερος Σωτήριος Ἀλεβιζάκης
							</h3>
						</div>
					</div>
					<div
						class="group/member relative flex flex-col items-center gap-4 rounded-2xl border border-amber-400/25 bg-[linear-gradient(180deg,rgba(127,29,29,0.5),rgba(69,10,10,0.3))] p-6 pt-7 shadow-lg shadow-red-950/40 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-300/60 hover:shadow-2xl hover:shadow-amber-900/30">
						<span
							class="absolute top-3 right-4 text-sm font-anaktoria text-amber-300/60"
							aria-hidden="true">Β΄</span
