	<style is:inline>
		.remove {
			opacity: 1;
			animation: fadeOut 0.3s ease-in-out forwards;
		}
		.open {
			opacity: 0.01;
			animation: fadeIn 0.6s ease-in-out forwards;
		}

		.contentContainer::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
			background:
				radial-gradient(140% 80% at 50% 0%, rgb(251 191 36 / 0.08), transparent 60%),
				radial-gradient(rgb(255 209 102 / 0.04) 1px, transparent 1.4px);
			background-size:
				100% 100%,
				26px 26px;
		}

		.readMore-bob {
			animation: readMoreBob 1.8s ease-in-out infinite;
		}
		#readMore:is(.open) {
			transform: translate(var(--tw-translate-x, -50%), 12%);
			opacity: 0.92;
		}
		#readMore:is(.open):hover > i {
			color: rgb(127, 29, 29);
		}
		@keyframes readMoreBob {
			0%,
			100% {
				transform: translateY(0);
			}
			50% {
				transform: translateY(3px);
			}
		}

		#moreText {
			display: grid;
			grid-template-rows: 0fr;
			opacity: 0;
			transition:
				grid-template-rows 0.55s cubic-bezier(0.4, 0, 0.2, 1),
				opacity 0.4s ease;
		}
		#moreText > div {
			overflow: hidden;
			min-height: 0;
		}
		#moreText > div > * {
			opacity: 0;
			transform: translateY(12px);
			transition:
				opacity 0.45s ease,
				transform 0.45s ease;
		}
		#moreText.expanded {
			grid-template-rows: 1fr;
			opacity: 1;
		}
		#moreText.expanded > div > * {
			opacity: 1;
			transform: translateY(0);
		}
		#moreText.expanded > div > *:nth-child(1) {
			transition-delay: 100ms;
		}
		#moreText.expanded > div > *:nth-child(2) {
			transition-delay: 160ms;
		}
		#moreText.expanded > div > *:nth-child(3) {
			transition-delay: 220ms;
		}
		#moreText.expanded > div > *:nth-child(4) {
			transition-delay: 280ms;
		}
		#moreText.expanded > div > *:nth-child(5) {
			transition-delay: 360ms;
		}

		#sxoli {
			color: white;
		}
	</style>
