---
/** The card the sign-in pages share (logo, title, content): login, invite signup, forgotten password. */
export interface Props {
	title: string;
}
const { title } = Astro.props;
---

<div
	class="p-12 max-sm:px-6 h-max place-self-center bg-white dark:bg-dark grid auto-rows-min shadow-lg shadow-gray-700 rounded-md gap-y-8 border border-transparent dark:border-gray-700">
	<div class="grid justify-center content-center">
		<a href="/" class="relative">
			<img class="h-[100px] brightness-150" src="/logo.svg" alt="Λογότυπο Σχολής" />
			<img class="h-[100px] absolute brightness-150 blur-[1px] opacity-40 top-[1px] left-[-2px]" src="/logo.svg" alt="" aria-hidden="true" />
		</a>
	</div>
	<h2 class="text-3xl font-didact text-center text-red-950 dark:text-red-50">{title}</h2>
	<slot />
</div>
