---
// Compact teacher link (photo or monogram, name, role) for the "who teaches here"
// grids on the course, study-centre and teacher pages.
import { monogram, teacherPicture, type DirectoryTeacher } from "./directory";

export interface Props {
	teacher: DirectoryTeacher;
	subtitle?: string;
}
const { teacher, subtitle = teacher.role } = Astro.props;
---

<a
	href={teacher.href}
	class="group/tc flex items-center gap-3.5 rounded-xl bg-white p-2.5 pr-4 ring-1 ring-red-900/10 shadow-sm shadow-red-950/5 transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-red-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900">
	<span class="relative size-16 max-sm:size-14 shrink-0 overflow-hidden rounded-lg bg-red-950">
		{
			teacher.picture ? (
				<img
					src={teacherPicture(teacher.picture, 160)}
					alt=""
					width="64"
					height="64"
					loading="lazy"
					decoding="async"
					class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover/tc:scale-105"
				/>
			) : (
				<span class="absolute inset-0 grid place-items-center bg-linear-to-br from-red-800 via-red-900 to-red-950 font-anaktoria text-xl font-bold text-ivory/80">
					{monogram(teacher.fullname)}
				</span>
			)
		}
	</span>
	<span class="flex min-w-0 flex-col">
		<span class="font-anaktoria text-lg max-sm:text-base font-bold leading-snug text-red-950 [word-break:break-word] group-hover/tc:text-red-900">
			{teacher.fullname}
		</span>
		<span class="text-sm max-sm:text-xs leading-snug text-neutral-600">{subtitle}</span>
	</span>
</a>
