---
import "../../styles/global.css";
import { isProduction } from "@lib/utils.server.ts";
import { SEO } from "astro-seo";

export interface Props {
	title: string;
	description?: string;
	imageURL?: string;
	canonical?: string;
	noindex?: boolean;
}

const { title, description, imageURL, canonical, noindex } = Astro.props;

const SITE_NAME = "Σχολή Βυζαντινής & Παραδοσιακής Μουσικής";
const SITE_URL = (Astro.site ?? new URL(Astro.request.url)).origin;
const hasBrandIcons = !Astro.url.pathname.includes("login");

// `<title>` uses titleTemplate (suffix added only on non-home pages); OG/Twitter
// reuse the same composed title for consistency.
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const pageDescription = description || "Σχολή Βυζαντινής & Παραδοσιακής Μουσικής Ι.Ν. Μεταμορφώσεως Του Σωτήρος, Δήμου Μεταμορφώσεως";
// Canonical is the clean URL: no query strings (?regid=…) and no fragments.
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;

// Default social share image (1200x630) unless the page provides its own.
const defaultShareImage = {
	url: new URL("/og-image.jpg", SITE_URL).href,
	alt: SITE_NAME,
	height: 630,
	width: 1200,
	type: "image/jpeg",
	secureUrl: new URL("/og-image.jpg", SITE_URL).href,
};
const shareImage = imageURL ? { url: imageURL } : defaultShareImage;
---

<>
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#7f1d1d" />
	<SEO
		charset="utf-8"
		title={title}
		titleTemplate={title === SITE_NAME ? undefined : `%s | ${SITE_NAME}`}
		description={pageDescription}
		canonical={canonicalUrl}
		noindex={noindex}
		openGraph={{
			basic: {
				title: fullTitle,
				url: canonicalUrl,
				image: shareImage.url,
				type: "website",
			},
			image: shareImage,
			optional: {
				description: pageDescription,
				locale: "el_GR",
				siteName: SITE_NAME,
			},
		}}
		twitter={{
			card: "summary_large_image",
			title: fullTitle,
			description: pageDescription,
			image: shareImage.url,
			imageAlt: shareImage.alt,
		}}
		extend={{
			link: [
				{ rel: "icon", href: "/logo_small.png" },
				{ rel: "sitemap", href: "/sitemap-index.xml" },
				{ rel: "robots", href: "/robots.txt" },
			],
			meta: [
				{
					name: "facebook:image",
					content: shareImage.url,
				},
				{
					name: "messenger:image",
					content: shareImage.url,
				},
				{
					name: "viber:image",
					content: shareImage.url,
				},
			],
		}}
	/>
	<link rel="preload" href="/fonts/ANAKTORIA.OTF" as="font" crossorigin="" />
	<style is:inline>
		@font-face {
			font-family: "Anaktoria";
			src: url("/fonts/ANAKTORIA.OTF");
		}
	</style>
	{/*
	 * Font Awesome is loaded into the `components` cascade layer (below
	 * `utilities`): FA sets `display: var(--fa-display, inline-block)` on
	 * `.fa-solid` with the same specificity as Tailwind's `.hidden`, and in
	 * Tailwind 4 unlayered CSS would always win over the layered utilities —
	 * making every FA icon ignore `hidden`/`group-*:flex`.
	 * (v3 parity: FA's <link> preceded the Astro CSS, so utilities won by
	 * source order; the layer order statement must precede the @imports.)
	 */}
	<style is:inline>
		@layer properties, theme, base, components, utilities;
		@import url("/fa/css/fontawesome.min.css") layer(components);
		@import url("/fa/css/solid.min.css") layer(components);
		@import url("/fa/css/regular.min.css") layer(components);
	</style>
	{hasBrandIcons && (
		<style is:inline>
			@import url("/fa/css/brands.min.css") layer(components);
		</style>
	)}
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Didact+Gothic&display=swap" rel="stylesheet" />
	{
		isProduction() && (
			<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ea19263015fb463885a76372d2368d05"}' />
		)
	}
</>
