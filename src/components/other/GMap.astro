---
export interface Props {
	mapEmbedSrc: string;
	title?: string;
}

const { mapEmbedSrc, title } = Astro.props;
---

<iframe
	class="w-full sm:h-full shadow-md shadow-gray-400 rounded-md border-2 border-solid border-red-900 max-sm:h-[300px]"
	referrerpolicy="same-origin"
	src={mapEmbedSrc}
	title={title || "Χάρτης Google Maps"}
	allowfullscreen
	loading="lazy">
</iframe>
