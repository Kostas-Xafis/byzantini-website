{
	"name": "pdfworker",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "bunx wrangler dev --config wrangler.jsonc",
		"deploy": "bunx wrangler deploy --config wrangler.jsonc",
		"types": "bunx wrangler types --config wrangler.jsonc",
		"typecheck": "bunx --bun tsc --noEmit",
		"tail": "bunx wrangler tail --config wrangler.jsonc"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"pdf-lib": "^1.17.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.127.1"
	}
}
