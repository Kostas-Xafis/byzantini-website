{
	"name": "emailworker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx wrangler dev --config wrangler.jsonc",
		"deploy": "bunx wrangler deploy --config wrangler.jsonc",
		"types": "bunx wrangler types --config wrangler.jsonc",
		"tail": "bunx wrangler tail --config wrangler.jsonc",
		"typecheck": "node_modules/typescript7/bin/tsc --noEmit",
		"typecheck:cli": "node_modules/typescript7/bin/tsc -p tsconfig.cli.json",
		"campaign": "bun src/cli.ts",
		"remove-suppressed": "bun scripts/removeSuppressed.ts",
		"templates:build": "bun scripts/buildTemplates.ts",
		"sms:check": "bun scripts/checkSms.ts",
		"test": "bun test tests/",
		"test:watch": "bun test --watch tests/"
	},
	"dependencies": {
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.1.0",
		"mailersend": "^2.6.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "^1.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"typescript": "^6.0.3",
		"typescript7": "npm:typescript@7.0.2",
		"wrangler": "^4.127.1"
	}
}
